// std.mem.heap - 基于 libc malloc/free/realloc 的堆式 IAllocator
// 模块路径：use std.mem.heap;

extern fn malloc(size: usize) &void;
extern fn free(ptr: &void) void;
extern fn realloc(ptr: &void, new_size: usize) &void;

use std.mem.allocator.IAllocator;

export struct HeapAllocator : IAllocator {
    fn alloc(self: &Self, size: usize) !&byte {
        _ = self;
        if size == 0 {
            return error.AllocInvalidSize;
        }
        const ptr: &void = malloc(size);
        if ptr == null {
            return error.AllocOutOfMemory;
        }
        return ptr as &byte;
    }

    fn dealloc(self: &Self, ptr: &byte) void {
        _ = self;
        if ptr == null {
            return;
        }
        free(ptr as &void);
    }

    fn realloc(self: &Self, ptr: &byte, new_size: usize) !&byte {
        if ptr == null {
            return self.alloc(new_size);
        }
        if new_size == 0 {
            self.dealloc(ptr);
            return error.AllocInvalidSize;
        }
        const new_ptr: &void = realloc(ptr as &void, new_size);
        if new_ptr == null {
            return error.AllocOutOfMemory;
        }
        return new_ptr as &byte;
    }
}

export var g_heap_allocator: HeapAllocator = HeapAllocator{};

export fn get_heap_allocator() &HeapAllocator {
    return &g_heap_allocator;
}
