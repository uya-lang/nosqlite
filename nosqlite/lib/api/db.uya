fn db_txn_stage_update_stmt(txn: &Txn, stmt: &SqlStmt) !void {
    const collection_name: &[const byte] = try db_identifier_bytes(&stmt.update_stmt.collection_name);
    const query_stmt: SqlStmt = db_make_select_stmt_from_stmt(
        stmt,
        &stmt.update_stmt.collection_name,
        stmt.update_stmt.has_where,
        stmt.update_stmt.where_expr,
        stmt.update_stmt.value_expr,
        1u16,
    );
    const collection_slot: u16 = try db_find_collection_slot_by_name_in_view(txn.db, txn.view_slot, collection_name);
    const state: &CommitViewState = try db_commit_view_state(txn.db, txn.view_slot);
    const collection: &DbCollection = try db_collection_at_in_state(state, collection_slot);
    var plan: QueryPlan = QueryPlan{};
    if collection.secondary_index_count == 0u16 {
        try bind_select_with_collection_metadata_into(&query_stmt, collection.collection_id, collection.primary_root_page, &plan.bound);
    } else {
        try bind_select_at_stem_into(db_stem_ptr(txn.db), &query_stmt, &plan.bound);
    }
    try plan_select_into(&plan.bound, &plan);
    const program: PathProgram = try path_program_compile(sql_path_slice(&stmt.update_stmt.target_path));
    var fast_matched: bool = false;
    var changed: u32 = 0u32;
    try db_txn_try_apply_doc_id_range_update(txn, &plan, collection_slot, &program, plan.bound.projection_exprs[0], &fast_matched, &changed);
    if !fast_matched {
        changed = try db_txn_stage_update_stmt_apply_root(txn, &plan, collection_slot, &program, plan.bound.projection_exprs[0]);
    }
    if changed > 0u32 {
        txn.has_writes = true;
    }
}

fn db_txn_stage_delete_stmt(txn: &Txn, stmt: &SqlStmt) !void {
    const collection_name: &[const byte] = try db_identifier_bytes(&stmt.delete_stmt.collection_name);
    const query_stmt: SqlStmt = db_make_select_stmt_from_stmt(
        stmt,
        &stmt.delete_stmt.collection_name,
        stmt.delete_stmt.has_where,
        stmt.delete_stmt.where_expr,
        -1,
        0u16,
    );
    const collection_slot: u16 = try db_find_collection_slot_by_name_in_view(txn.db, txn.view_slot, collection_name);
    const state: &CommitViewState = try db_commit_view_state(txn.db, txn.view_slot);
    const collection: &DbCollection = try db_collection_at_in_state(state, collection_slot);
    var plan: QueryPlan = QueryPlan{};
    if collection.secondary_index_count == 0u16 {
        try bind_select_with_collection_metadata_into(&query_stmt, collection.collection_id, collection.primary_root_page, &plan.bound);
    } else {
        try bind_select_at_stem_into(db_stem_ptr(txn.db), &query_stmt, &plan.bound);
    }
    try plan_select_into(&plan.bound, &plan);
    var fast_matched: bool = false;
    var changed: u32 = 0u32;
    try db_txn_try_apply_doc_id_range_delete(txn, &plan, collection_slot, &fast_matched, &changed);
    if !fast_matched {
        changed = try db_txn_stage_delete_stmt_apply_root(txn, &plan, collection_slot);
    }
    if changed > 0u32 {
        txn.has_writes = true;
    }
}

fn db_txn_stage_create_index_stmt(txn: &Txn, stmt: &SqlStmt) !void {
    if txn == null || txn.db == null {
        return error.DbHandleInvalid;
    }
    try db_txn_stage_create_index(
        txn,
        try db_identifier_bytes(&stmt.create_index_stmt.collection_name),
        try db_identifier_bytes(&stmt.create_index_stmt.index_name),
        sql_path_slice(&stmt.create_index_stmt.target_path),
    );
}

fn db_txn_stage_create_index(txn: &Txn, collection_name: &[const byte], index_name: &[const byte], path_bytes: &[const byte]) !void {
    if txn == null || txn.db == null || collection_name.ptr == null || index_name.ptr == null || path_bytes.ptr == null {
        return error.DbHandleInvalid;
    }
    const state: &CommitViewState = try db_commit_view_state(txn.db, txn.view_slot);
    const collection_slot: u16 = try db_find_collection_slot_by_name_in_view(txn.db, txn.view_slot, collection_name);
    const collection: &DbCollection = try db_collection_at_in_state(state, collection_slot);
    if collection.secondary_index_count as usize >= DB_MAX_SECONDARY_INDEXES_PER_COLLECTION {
        return error.DbCollectionFull;
    }
    const program: PathProgram = try path_program_compile(path_bytes);
    var max_index_id: u32 = 0u32;
    var i: u16 = 0u16;
    while i < collection.secondary_index_count {
        const meta: &DbCollectionIndexMeta = &collection.secondary_indexes[i as usize];
        if db_index_name_equal(meta, index_name) || db_index_path_equal(meta, path_bytes) {
            return error.DbIndexExists;
        }
        if meta.index_id > max_index_id {
            max_index_id = meta.index_id;
        }
        i = i + 1u16;
    }
    const slot: usize = collection.secondary_index_count as usize;
    if slot >= DB_MAX_SECONDARY_INDEXES_PER_COLLECTION {
        return error.DbCollectionFull;
    }
    collection.secondary_indexes[slot].present = true;
    collection.secondary_indexes[slot].index_id = max_index_id + 1u32;
    collection.secondary_indexes[slot].root_page = 0u32;
    collection.secondary_indexes[slot].path_segment_count = program.step_count;
    try db_copy_name(index_name, collection.secondary_indexes[slot].name[0: 64], &collection.secondary_indexes[slot].name_len);
    try db_copy_path(path_bytes, collection.secondary_indexes[slot].path[0: 128], &collection.secondary_indexes[slot].path_len);
    collection.secondary_index_count = collection.secondary_index_count + 1u16;
    txn.has_writes = true;
}

fn db_txn_stage_insert(txn: &Txn, collection_name: &[const byte], json_text: &[const byte]) !u64 {
    if txn == null || txn.db == null {
        return error.DbHandleInvalid;
    }
    if !txn.active {
        return error.DbTxnInactive;
    }
    const state: &CommitViewState = try db_commit_view_state(txn.db, txn.view_slot);
    const slot: u16 = try db_find_collection_slot_by_name_in_view(txn.db, txn.view_slot, collection_name);
    const collection_idx: usize = (slot as! usize) catch {
        return error.DbCollectionNotFound;
    };
    if collection_idx >= DB_MAX_COLLECTIONS {
        return error.DbCollectionNotFound;
    }
    try db_ensure_collection_rows_loaded_in_view(txn.db, txn.view_slot, slot);
    if state.collections[collection_idx].next_doc_id == 0u64 ||
        state.collections[collection_idx].next_doc_id == 18446744073709551615u64 {
        return error.DbRowFull;
    }
    const doc_id: u64 = state.collections[collection_idx].next_doc_id;
    const builder: &DocBlobBuilder = &txn.db.doc_builder;
    builder.active = true;
    builder.doc_len = 0u16;
    try doc_blob_builder_build_json(builder, json_text);
    var row_slot: u32 = NOSQLITE_COLLECTION_MAX_ROWS_PER_COLLECTION;
    if state.collections[collection_idx].may_have_tombstones {
        var scan_slot: usize = 0usize;
        while scan_slot < state.collections[collection_idx].row_count as usize {
            if state.collections[collection_idx].rows[scan_slot].present &&
                (
                    state.collections[collection_idx].rows[scan_slot].tombstone ||
                    db_collection_delete_overlay_tombstone(&state.collections[collection_idx], scan_slot as u32)
                ) &&
                state.collections[collection_idx].rows[scan_slot].doc_id > state.collections[collection_idx].deleted_through_doc_id {
                row_slot = scan_slot as u32;
                break;
            }
            scan_slot = scan_slot + 1usize;
        }
        if row_slot >= DB_MAX_ROWS_PER_COLLECTION {
            state.collections[collection_idx].may_have_tombstones = false;
        }
    }
    if row_slot >= DB_MAX_ROWS_PER_COLLECTION {
        row_slot = state.collections[collection_idx].row_count;
    }
    if row_slot >= DB_MAX_ROWS_PER_COLLECTION {
        return error.DbRowFull;
    }
    try db_collection_ensure_row_capacity(&state.collections[collection_idx], row_slot + 1u32);
    if state.collections[collection_idx].delete_overlay_suffix_valid &&
        state.collections[collection_idx].delete_overlay_bits != null &&
        row_slot == state.collections[collection_idx].delete_overlay_suffix_start {
        state.collections[collection_idx].delete_overlay_suffix_start = row_slot + 1u32;
    } else if state.collections[collection_idx].delete_overlay_suffix_valid &&
        state.collections[collection_idx].delete_overlay_bits != null &&
        row_slot > state.collections[collection_idx].delete_overlay_suffix_start &&
        row_slot < state.collections[collection_idx].row_count {
        state.collections[collection_idx].delete_overlay_suffix_valid = false;
    }
    try db_collection_set_delete_overlay_tombstone(&state.collections[collection_idx], row_slot, false);
    const row: &DbStoredRow = &state.collections[collection_idx].rows[row_slot as usize];
    db_stored_row_reset(row);
    row.present = true;
    row.tombstone = false;
    row.doc_id = doc_id;
    try db_collection_row_set_blob_copy(&state.collections[collection_idx], row, builder.doc_blob[0: builder.doc_len as usize]);
    if state.collections[collection_idx].primary_root_page == 0u32 {
        state.collections[collection_idx].primary_root_page = db_collection_data_page_id(&state.collections[collection_idx]);
    }
    state.collections[collection_idx].next_doc_id = state.collections[collection_idx].next_doc_id + 1u64;
    if row_slot == state.collections[collection_idx].row_count {
        state.collections[collection_idx].row_count = state.collections[collection_idx].row_count + 1u32;
        if !db_collection_has_delete_overlay_tombstones(&state.collections[collection_idx]) {
            state.collections[collection_idx].delete_overlay_suffix_valid = true;
            state.collections[collection_idx].delete_overlay_suffix_start = state.collections[collection_idx].row_count;
        }
    } else {
        state.collections[collection_idx].may_have_tombstones = true;
        state.collections[collection_idx].prefix_delete_only = false;
        if state.collections[collection_idx].delete_overlay_suffix_valid &&
            state.collections[collection_idx].delete_overlay_suffix_start < state.collections[collection_idx].row_count &&
            row_slot == state.collections[collection_idx].delete_overlay_suffix_start {
            state.collections[collection_idx].delete_overlay_suffix_start = row_slot + 1u32;
        }
    }
    if db_collection_update_max_doc_len(&state.collections[collection_idx], row.doc_len) {
        try db_collection_refresh_packed_layout(&state.collections[collection_idx], db_effective_page_size(txn.db));
    }
    row.record_ptr = record_pointer_make(
        db_collection_page_id_for_index(&state.collections[collection_idx], row_slot),
        db_collection_local_slot_for_index(&state.collections[collection_idx], row_slot),
    );
    try db_collection_mark_row_dirty(&state.collections[collection_idx], row_slot);
    txn.has_writes = true;
    return doc_id;
}

fn db_txn_stage_insert_stmt(txn: &Txn, stmt: &SqlInsertStmt) !u64 {
    return try db_txn_stage_insert(txn, try db_identifier_bytes(&stmt.collection_name), try db_literal_text_bytes(&stmt.json_text));
}

fn db_catalog_scratch_from_view(state: &CommitViewState, out: &[CatalogScratchCollection], count_out: &u16) !void {
    if state == null || out.ptr == null || count_out == null {
        return error.DbCollectionFull;
    }
    if state.collection_count as usize > out.len {
        return error.DbCollectionFull;
    }
    var i: usize = 0usize;
    while i < out.len {
        out.ptr[i] = CatalogScratchCollection{};
        i = i + 1usize;
    }

    i = 0usize;
    while i < state.collection_count as usize {
        const collection: &DbCollection = &state.collections[i];
        if !collection.present {
            return error.DbCollectionFull;
        }
        out.ptr[i].present = true;
        out.ptr[i].meta = CollectionMeta{
            collection_id: collection.collection_id,
            name_len: collection.name_len,
            flags: collection.layout_flags,
            next_doc_id: try db_collection_meta_pack_next_doc_id(collection.next_doc_id, collection.deleted_through_doc_id),
            primary_root_page: collection.primary_root_page,
            secondary_index_count: collection.secondary_index_count,
            rsv: collection.rows_per_page,
            name_off: 0u32,
            indexes_off: 0u32,
        };
        out.ptr[i].name_len = collection.name_len;
        if collection.name_len > 0u16 {
            _ = mem_copy(&out.ptr[i].name[0], &collection.name[0], collection.name_len as usize);
        }
        out.ptr[i].index_count = collection.secondary_index_count;

        var index_idx: usize = 0usize;
        while index_idx < collection.secondary_index_count as usize {
            const index_meta: &DbCollectionIndexMeta = &collection.secondary_indexes[index_idx];
            if !index_meta.present {
                return error.DbCollectionFull;
            }
            out.ptr[i].indexes[index_idx].present = true;
            out.ptr[i].indexes[index_idx].meta = IndexMeta{
                index_id: index_meta.index_id,
                root_page: index_meta.root_page,
                flags: 0u16,
                path_segment_count: index_meta.path_segment_count,
                name_off: 0u32,
                path_off: 0u32,
            };
            out.ptr[i].indexes[index_idx].name_len = index_meta.name_len;
            out.ptr[i].indexes[index_idx].path_len = index_meta.path_len;
            if index_meta.name_len > 0u16 {
                _ = mem_copy(&out.ptr[i].indexes[index_idx].name[0], &index_meta.name[0], index_meta.name_len as usize);
            }
            if index_meta.path_len > 0u16 {
                _ = mem_copy(&out.ptr[i].indexes[index_idx].path[0], &index_meta.path[0], index_meta.path_len as usize);
            }
            index_idx = index_idx + 1usize;
        }
        i = i + 1usize;
    }
    count_out[0] = state.collection_count;
}


fn db_collection_index_catalog_equal(left: &DbCollectionIndexMeta, right: &DbCollectionIndexMeta) bool {
    if left == null || right == null {
        return false;
    }
    if left.present != right.present ||
        left.index_id != right.index_id ||
        left.root_page != right.root_page ||
        left.path_segment_count != right.path_segment_count ||
        left.name_len != right.name_len ||
        left.path_len != right.path_len {
        return false;
    }
    var i: usize = 0usize;
    while i < left.name_len as usize {
        if left.name[i] != right.name[i] {
            return false;
        }
        i = i + 1usize;
    }
    i = 0usize;
    while i < left.path_len as usize {
        if left.path[i] != right.path[i] {
            return false;
        }
        i = i + 1usize;
    }
    return true;
}

fn db_collection_catalog_equal(left: &DbCollection, right: &DbCollection) bool {
    if left == null || right == null {
        return false;
    }
    if left.present != right.present ||
        left.collection_id != right.collection_id ||
        left.name_len != right.name_len ||
        left.layout_flags != right.layout_flags ||
        left.rows_per_page != right.rows_per_page ||
        left.next_doc_id != right.next_doc_id ||
        left.deleted_through_doc_id != right.deleted_through_doc_id ||
        left.primary_root_page != right.primary_root_page ||
        left.secondary_index_count != right.secondary_index_count {
        return false;
    }
    var i: usize = 0usize;
    while i < left.name_len as usize {
        if left.name[i] != right.name[i] {
            return false;
        }
        i = i + 1usize;
    }
    i = 0usize;
    while i < left.secondary_index_count as usize {
        if !db_collection_index_catalog_equal(&left.secondary_indexes[i], &right.secondary_indexes[i]) {
            return false;
        }
        i = i + 1usize;
    }
    return true;
}

fn db_txn_catalog_changed(db: &DbHandle, staged: &CommitViewState) !bool {
    if db == null || staged == null {
        return error.DbHandleInvalid;
    }
    const current: &CommitViewState = try db_current_view_state(db);
    if current.collection_count != staged.collection_count {
        return true;
    }
    var i: u16 = 0u16;
    while i < staged.collection_count {
        if !db_collection_catalog_equal(&current.collections[i as usize], &staged.collections[i as usize]) {
            return true;
        }
        i = i + 1u16;
    }
    return false;
}

fn db_txn_estimate_wal_batch_bytes(state: &CommitViewState, page_size: u32, catalog_changed: bool) !usize {
    if state == null {
        return error.DbHandleInvalid;
    }
    const page_record_size: usize = try wal_page_write_record_size(page_size);
    var total: usize = wal_begin_record_size() + wal_commit_record_size();
    if catalog_changed {
        total = total + page_record_size;
    }
    var collection_idx: u16 = 0u16;
    while collection_idx < state.collection_count {
        const collection: &DbCollection = &state.collections[collection_idx as usize];
        if collection.present {
            const collection_page_count: u32 = db_collection_page_count_for_rows(collection, collection.row_count);
            var page_offset: u32 = 0u32;
            while page_offset < collection_page_count {
                if db_collection_page_dirty(collection, page_offset) {
                    total = total + page_record_size;
                }
                page_offset = page_offset + 1u32;
            }
        }
        collection_idx = collection_idx + 1u16;
    }
    return total;
}

fn db_txn_commit_persist(txn: &Txn) !WalCommit {
    if txn == null || txn.db == null {
        return error.DbHandleInvalid;
    }
    const state: &CommitViewState = try db_commit_view_state(txn.db, txn.view_slot);
    if !txn.db.pager_session.active {
        txn.db.pager_session = try pager_open_session_at_stem(db_stem_ptr(txn.db));
    }
    const info: PagerOpenInfo = txn.db.pager_session.info;
    const next_lsn: u64 = info.meta.commit_lsn + 1u64;
    var max_page_count: u32 = info.meta.page_count;
    var collection_idx: u16 = 0u16;
    while collection_idx < state.collection_count {
        try db_ensure_collection_rows_loaded_in_view(txn.db, txn.view_slot, collection_idx);
        const collection: &DbCollection = &state.collections[collection_idx as usize];
        if collection.present {
            try db_collection_refresh_packed_layout(collection, info.meta.page_size);
        }
        collection_idx = collection_idx + 1u16;
    }
    const catalog_changed: bool = try db_txn_catalog_changed(txn.db, state);
    const batch: &WalBatch = txn.db.wal_batch;
    wal_batch_reset(batch, next_lsn, next_lsn);
    try wal_batch_reserve_bytes(batch, try db_txn_estimate_wal_batch_bytes(state, info.meta.page_size, catalog_changed));
    try wal_batch_append_begin(batch);
    collection_idx = 0u16;
    while collection_idx < state.collection_count {
        const collection: &DbCollection = &state.collections[collection_idx as usize];
        if collection.present {
            const base_page_id: u32 = db_collection_data_page_id(collection);
            const collection_page_count: u32 = db_collection_page_count_for_rows(collection, collection.row_count);
            if base_page_id >= 2u32 && collection_page_count > 0u32 {
                if base_page_id + collection_page_count > max_page_count {
                    max_page_count = base_page_id + collection_page_count;
                }
                var page_offset: u32 = 0u32;
                while page_offset < collection_page_count {
                    if !db_collection_page_dirty(collection, page_offset) {
                        page_offset = page_offset + 1u32;
                        continue;
                    }
                    const page_id: u32 = base_page_id + page_offset;
                    var raw_page: [byte: 8192] = [];
                    const page_buf: &[byte] = raw_page[0: info.meta.page_size as usize];
                    var patched_from_disk: bool = false;
                    if db_collection_page_in_tombstone_patch_pages(collection, page_offset) {
                        try db_collection_try_patch_tombstone_page_from_disk(txn.db, collection, page_offset, page_buf, &patched_from_disk);
                    }
                    if !patched_from_disk {
                        try db_ensure_collection_page_blobs_loaded(txn.db, collection, page_offset);
                        const first_row: u32 = db_collection_first_row_for_page_offset(collection, page_offset);
                        try db_collection_encode_page_range(collection, info.meta.page_size, txn.db.now_ms, page_id, first_row, page_buf);
                    }
                    const header: &PageHeader = page_header_from_buf(page_buf);
                    if header == null {
                        return error.DbCollectionPageMissing;
                    }
                    header.page_lsn = next_lsn;
                    header.checksum = 0u32;
                    _ = try page_checksum_finalize(page_buf);
                    try wal_batch_append_page(batch, page_id, next_lsn, page_buf);
                    page_offset = page_offset + 1u32;
                }
            }
        }
        collection_idx = collection_idx + 1u16;
    }
    if catalog_changed {
        var catalog_raw: [byte: 8192] = [];
        const catalog_page: &[byte] = catalog_raw[0: info.meta.page_size as usize];
        try catalog_page_init(catalog_page);
        var catalog_entries: [CatalogScratchCollection: DB_MAX_COLLECTIONS] = [];
        var catalog_count: u16 = 0u16;
        try db_catalog_scratch_from_view(state, catalog_entries[0: DB_MAX_COLLECTIONS], &catalog_count);
        try catalog_page_rewrite_from_entries(catalog_page, catalog_entries[0: DB_MAX_COLLECTIONS], catalog_count);
        const catalog_header: &PageHeader = page_header_from_buf(catalog_page);
        if catalog_header == null {
            return error.DbCollectionPageMissing;
        }
        catalog_header.page_lsn = next_lsn;
        _ = try page_checksum_finalize(catalog_page);
        try wal_batch_append_page(batch, info.meta.catalog_root, next_lsn, catalog_page);
    }
    const commit: WalCommit = WalCommit{
        txn_id: next_lsn,
        commit_lsn: next_lsn,
        catalog_root: info.meta.catalog_root,
        page_count: max_page_count,
        freelist_head: info.meta.freelist_head,
    };
    try wal_batch_append_commit(batch, &commit);
    txn.db.pager_session.info = try pager_wal_commit_batch_with_open_files_at_stem(
        db_stem_ptr(txn.db),
        &info,
        &txn.db.pager_session.db,
        &txn.db.pager_session.wal,
        batch,
        null,
    );
    return commit;
}

fn db_plan_collect_limit_lazy_seq_scan(
    db: &DbHandle,
    view_slot: u16,
    plan: &QueryPlan,
    collection_slot: u16,
    filter_expr: i16,
    limit_value: u32,
    out_rows: &[u32],
    count_out: &u16,
) !bool {
    if db == null || plan == null || out_rows.ptr == null || count_out == null {
        return error.DbHandleInvalid;
    }
    const state: &CommitViewState = try db_commit_view_state(db, view_slot);
    const collection: &DbCollection = try db_collection_at_in_state(state, collection_slot);
    if collection.rows_loaded {
        return false;
    }
    var limit_u16: u16 = (limit_value as! u16) catch {
        return error.DbRowFull;
    };
    if out_rows.len < limit_u16 as usize {
        limit_u16 = (out_rows.len as! u16) catch {
            return error.DbRowFull;
        };
    }
    if limit_u16 == 0u16 || collection.next_doc_id <= 1u64 {
        count_out[0] = 0u16;
        return true;
    }
    const expected_rows_u64: u64 = collection.next_doc_id - 1u64;
    if expected_rows_u64 > DB_MAX_ROWS_PER_COLLECTION as u64 {
        return error.DbRowFull;
    }
    const expected_rows: u32 = (expected_rows_u64 as! u32) catch {
        return error.DbRowFull;
    };
    const page_count: u32 = db_collection_page_count_for_rows(collection, expected_rows);
    var matched: u16 = 0u16;
    var page_offset: u32 = 0u32;
    while page_offset < page_count && matched < limit_u16 {
        const first_row: u32 = db_collection_first_row_for_page_offset(collection, page_offset);
        if first_row >= collection.row_count {
            const page_id: u32 = db_collection_data_page_id(collection) + page_offset;
            if page_id < 2u32 || page_id >= db.pager_session.info.meta.page_count {
                return error.DbCollectionPageMissing;
            }
            var page_raw: [byte: 8192] = [];
            const page_buf: &[byte] = page_raw[0: db.pager_session.info.meta.page_size as usize];
            try pager_read_page_with_file(&db.pager_session.db, &db.pager_session.info, page_id, page_buf);
            // Keep LIMIT scans page-local so warm reads stop after the first few pages instead of loading the whole collection.
            try db_collection_load_page_range(collection, page_id, page_offset, page_buf, filter_expr >= 0i16);
        }
        var row_idx: u32 = first_row;
        var row_end: u32 = first_row + (db_collection_rows_per_page(collection) as u32);
        if row_end > collection.row_count {
            row_end = collection.row_count;
        }
        while row_idx < row_end && matched < limit_u16 {
            const row: &DbStoredRow = &collection.rows[row_idx as usize];
            if db_row_visible_at_slot(collection, row, row_idx) {
                var include_row: bool = true;
                if filter_expr >= 0i16 {
                    const rowref: RowRef = try db_collection_row_ref(db, view_slot, collection_slot, row_idx);
                    include_row = try db_eval_predicate(db, &plan.bound, &rowref, filter_expr);
                }
                if include_row {
                    out_rows.ptr[matched as usize] = row_idx;
                    matched = matched + 1u16;
                }
            }
            row_idx = row_idx + 1u32;
        }
        page_offset = page_offset + 1u32;
    }
    count_out[0] = matched;
    return true;
}

fn db_plan_collect(db: &DbHandle, view_slot: u16, plan: &QueryPlan, collection_slot: u16, node_index: i16, out_rows: &[u32], count_out: &u16) !void {
    const node: &PlanNode = try plan_node(plan, node_index);
    const state: &CommitViewState = try db_commit_view_state(db, view_slot);
    const collection_idx: usize = (collection_slot as! usize) catch {
        return error.DbCollectionNotFound;
    };
    if collection_idx >= DB_MAX_COLLECTIONS {
        return error.DbCollectionNotFound;
    }
    const collection: &DbCollection = &state.collections[collection_idx];
    if node.kind == PlanNodeKind.LIMIT {
        const child_node: &PlanNode = try plan_node(plan, node.child);
        if child_node.kind == PlanNodeKind.SEQ_SCAN {
            const handled: bool = try db_plan_collect_limit_lazy_seq_scan(
                db,
                view_slot,
                plan,
                collection_slot,
                -1,
                node.limit_value,
                out_rows,
                count_out,
            );
            if handled {
                return;
            }
        }
        if child_node.kind == PlanNodeKind.FILTER {
            const grandchild_node: &PlanNode = try plan_node(plan, child_node.child);
            if grandchild_node.kind == PlanNodeKind.SEQ_SCAN {
                const handled: bool = try db_plan_collect_limit_lazy_seq_scan(
                    db,
                    view_slot,
                    plan,
                    collection_slot,
                    child_node.filter_expr,
                    node.limit_value,
                    out_rows,
                    count_out,
                );
                if handled {
                    return;
                }
            }
        }
    }
    try db_ensure_collection_rows_loaded_in_view(db, view_slot, collection_slot);
    if node.kind == PlanNodeKind.SEQ_SCAN {
        var out_count: u16 = 0u16;
        var i: u32 = 0u32;
        while i < collection.row_count {
            const row: &DbStoredRow = &collection.rows[i as usize];
            if db_row_visible_at_slot(collection, row, i) {
                if out_count as usize >= out_rows.len {
                    return error.DbRowFull;
                }
                out_rows.ptr[out_count as usize] = i;
                out_count = out_count + 1u16;
            }
            i = i + 1u32;
        }
        count_out[0] = out_count;
        return;
    }
    if node.kind == PlanNodeKind.PRIMARY_LOOKUP {
        try db_ensure_primary_index(db, collection_slot);
        const ptr: RecordPointer = primary_btree_lookup(&db.primary_indexes[collection_idx], node.lookup_doc_id) catch {
            count_out[0] = 0u16;
            return;
        };
        const base_page_id: u32 = db_collection_data_page_id(collection);
        var direct_idx: u32 = NOSQLITE_COLLECTION_MAX_ROWS_PER_COLLECTION;
        if ptr.page_id >= base_page_id {
            const page_offset: u32 = ptr.page_id - base_page_id;
            direct_idx = db_collection_first_row_for_page_offset(collection, page_offset) + (ptr.slot_id as u32);
        }
        if direct_idx < collection.row_count && direct_idx < collection.row_capacity {
            const row: &DbStoredRow = &collection.rows[direct_idx as usize];
            if db_row_visible_at_slot(collection, row, direct_idx) &&
                row.doc_id == node.lookup_doc_id &&
                row.record_ptr.page_id == ptr.page_id &&
                row.record_ptr.slot_id == ptr.slot_id {
                out_rows.ptr[0usize] = direct_idx;
                count_out[0] = 1u16;
                return;
            }
        }
        var i: u32 = 0u32;
        while i < collection.row_count {
            const row: &DbStoredRow = &collection.rows[i as usize];
            if db_row_visible_at_slot(collection, row, i) && row.record_ptr.page_id == ptr.page_id && row.record_ptr.slot_id == ptr.slot_id {
                out_rows.ptr[0usize] = i;
                count_out[0] = 1u16;
                return;
            }
            i = i + 1u32;
        }
        count_out[0] = 0u16;
        return;
    }
    if node.kind == PlanNodeKind.INDEX_SCAN {
        try db_ensure_secondary_index(db, collection_slot, node.index_slot);
        const index_state: &DbSecondaryIndexState = try db_secondary_index_state(db, collection_slot, node.index_slot);
        if !index_state.present {
            count_out[0] = 0u16;
            return;
        }
        var out_count: u16 = 0u16;
        var i: u32 = 0u32;
        while i < index_state.row_count {
            const row_slot: u32 = index_state.row_slots[i as usize];
            const rowref: RowRef = try db_collection_row_ref(db, view_slot, collection_slot, row_slot);
            if try db_eval_predicate(db, &plan.bound, &rowref, node.filter_expr) {
                if out_count as usize >= out_rows.len {
                    return error.DbRowFull;
                }
                out_rows.ptr[out_count as usize] = row_slot;
                out_count = out_count + 1u16;
            }
            i = i + 1u32;
        }
        count_out[0] = out_count;
        return;
    }
    if node.kind == PlanNodeKind.LIMIT {
        const limit_u16: u16 = (node.limit_value as! u16) catch {
            return error.DbRowFull;
        };
        const child_node: &PlanNode = try plan_node(plan, node.child);
        if child_node.kind == PlanNodeKind.SEQ_SCAN {
            var limited_count: u16 = 0u16;
            var row_idx: u32 = 0u32;
            while row_idx < collection.row_count {
                if limited_count >= limit_u16 || limited_count as usize >= out_rows.len {
                    break;
                }
                const row: &DbStoredRow = &collection.rows[row_idx as usize];
                if db_row_visible_at_slot(collection, row, row_idx) {
                    out_rows.ptr[limited_count as usize] = row_idx;
                    limited_count = limited_count + 1u16;
                }
                row_idx = row_idx + 1u32;
            }
            count_out[0] = limited_count;
            return;
        }
        if child_node.kind == PlanNodeKind.FILTER {
            const grandchild_node: &PlanNode = try plan_node(plan, child_node.child);
            if grandchild_node.kind == PlanNodeKind.SEQ_SCAN {
                var limited_count: u16 = 0u16;
                var row_idx: u32 = 0u32;
                while row_idx < collection.row_count {
                    if limited_count >= limit_u16 || limited_count as usize >= out_rows.len {
                        break;
                    }
                    const row: &DbStoredRow = &collection.rows[row_idx as usize];
                    if db_row_visible_at_slot(collection, row, row_idx) {
                        const rowref: RowRef = try db_collection_row_ref(db, view_slot, collection_slot, row_idx);
                        if try db_eval_predicate(db, &plan.bound, &rowref, child_node.filter_expr) {
                            out_rows.ptr[limited_count as usize] = row_idx;
                            limited_count = limited_count + 1u16;
                        }
                    }
                    row_idx = row_idx + 1u32;
                }
                count_out[0] = limited_count;
                return;
            }
        }
        var child_rows: [u32: DB_MAX_CURSOR_ROWS] = [];
        var child_count: u16 = 0u16;
        try db_plan_collect(db, view_slot, plan, collection_slot, node.child, child_rows[0: DB_MAX_CURSOR_ROWS], &child_count);
        var limited: u16 = child_count;
        if limited > limit_u16 {
            limited = limit_u16;
        }
        var i: u16 = 0u16;
        while i < limited {
            out_rows.ptr[i as usize] = child_rows[i as usize];
            i = i + 1u16;
        }
        count_out[0] = limited;
        return;
    }
    var child_rows: [u32: DB_MAX_CURSOR_ROWS] = [];
    var child_count: u16 = 0u16;
    try db_plan_collect(db, view_slot, plan, collection_slot, node.child, child_rows[0: DB_MAX_CURSOR_ROWS], &child_count);
    if node.kind == PlanNodeKind.SORT {
        var i: u16 = 0u16;
        while i < child_count {
            out_rows.ptr[i as usize] = child_rows[i as usize];
            i = i + 1u16;
        }
        i = 1u16;
        while i < child_count {
            const current: u16 = out_rows.ptr[i as usize];
            var j: usize = i as usize;
            while j > 0usize {
                const prev: u16 = out_rows.ptr[j - 1usize];
                const cmp: i32 = try db_compare_rows_for_sort(db, &plan.bound, view_slot, collection_slot, prev, current, node.order_expr, node.order_desc);
                if cmp <= 0 {
                    break;
                }
                out_rows.ptr[j] = prev;
                j = j - 1usize;
            }
            out_rows.ptr[j] = current;
            i = i + 1u16;
        }
        count_out[0] = child_count;
        return;
    }
    if node.kind == PlanNodeKind.FILTER {
        const child_node: &PlanNode = try plan_node(plan, node.child);
        if child_node.kind == PlanNodeKind.SEQ_SCAN {
            var out_count: u16 = 0u16;
            var row_idx: u32 = 0u32;
            while row_idx < collection.row_count {
                const row: &DbStoredRow = &collection.rows[row_idx as usize];
                if db_row_visible_at_slot(collection, row, row_idx) {
                    const rowref: RowRef = try db_collection_row_ref(db, view_slot, collection_slot, row_idx);
                    if try db_eval_predicate(db, &plan.bound, &rowref, node.filter_expr) {
                        if out_count as usize >= out_rows.len {
                            count_out[0] = out_count;
                            return;
                        }
                        out_rows.ptr[out_count as usize] = row_idx;
                        out_count = out_count + 1u16;
                    }
                }
                row_idx = row_idx + 1u32;
            }
            count_out[0] = out_count;
            return;
        }
        var out_count: u16 = 0u16;
        var i: u16 = 0u16;
        while i < child_count {
            const rowref: RowRef = try db_collection_row_ref(db, view_slot, collection_slot, child_rows[i as usize]);
            if try db_eval_predicate(db, &plan.bound, &rowref, node.filter_expr) {
                if out_count as usize >= out_rows.len {
                    count_out[0] = out_count;
                    return;
                }
                out_rows.ptr[out_count as usize] = child_rows[i as usize];
                out_count = out_count + 1u16;
            }
            i = i + 1u16;
        }
        count_out[0] = out_count;
        return;
    }
    return error.DbInvalidProjection;
}

fn db_prepare_handle_runtime_at_stem(db: &DbHandle, stem: &const byte) !void {
    if db == null || stem == null {
        return error.DbHandleInvalid;
    }
    db_close_pager_session(db);
    try db_ensure_result_pool(db);
    try db_ensure_wal_batch(db);
    db_result_pool_reset(db.result_pool);
    wal_batch_reset(db.wal_batch, 0u64, 0u64);
    db.stem_len = 0u16;
    db.snapshot_policy = db_default_snapshot_policy();
    db.snapshot_status = SnapshotPressureStatus{
        retired_bytes: 0u64,
        retired_views: 0u32,
    };
    db.snapshot_status_override_enabled = false;
    db.snapshot_status_override = SnapshotPressureStatus{
        retired_bytes: 0u64,
        retired_views: 0u32,
    };
    db.now_ms = 0u64;
    db.current_view_slot = 0u16;
    db.next_view_generation = 2u64;
    db.next_page_table_gen = 2u64;
    db_invalidate_query_cache(db);
    db.cursor_release_counter = null;
    db.pin_release_counter = null;
    const len: usize = strlen(stem);
    if len + 1usize > DB_PATH_BUF_SIZE {
        return error.DbHandleInvalid;
    }
    db.stem_len = (len as! u16) catch {
        return error.DbHandleInvalid;
    };
    _ = mem_copy(&db.stem[0], stem, len);
    db.stem[len] = 0 as byte;
}

export fn db_test_init_at_stem(db: &DbHandle, stem: &const byte) !void {
    try db_prepare_handle_runtime_at_stem(db, stem);
    var index_slot: usize = 0usize;
    while index_slot < DB_MAX_COLLECTIONS {
        try primary_btree_reset(&db.primary_indexes[index_slot], NOSQLITE_PAGE_SIZE_DEFAULT);
        index_slot = index_slot + 1usize;
    }
    index_slot = 0usize;
    while index_slot < DB_MAX_COLLECTIONS * DB_MAX_SECONDARY_INDEXES_PER_COLLECTION {
        db_secondary_index_state_reset(&db.secondary_indexes[index_slot]);
        index_slot = index_slot + 1usize;
    }
    var i: usize = 0usize;
    while i < DB_MAX_COMMIT_VIEWS {
        db_clear_commit_view_state(&db.commit_views[i]);
        i = i + 1usize;
    }
    const initial: &CommitViewState = &db.commit_views[0usize];
    initial.present = true;
    initial.retired = false;
    initial.reader_pins = 0u32;
    initial.view = CommitView{
        generation: 1u64,
        commit_lsn: 0u64,
        catalog_root: 2u32,
        page_count: 3u32,
        freelist_head: 0u32,
        page_table_gen: 1u64,
    };
    initial.collection_count = 0u16;
    db_finalize_view_state(initial);
    db_refresh_snapshot_status(db);
}

export fn db_test_create_at_stem(db: &DbHandle, stem: &const byte) !void {
    try catalog_cleanup_stem(stem);
    try catalog_create_db_at_stem(stem, NOSQLITE_PAGE_SIZE_DEFAULT);
    try db_test_open_at_stem(db, stem);
}

export fn db_test_open_at_stem(db: &DbHandle, stem: &const byte) !void {
    try db_prepare_handle_runtime_at_stem(db, stem);
    try db_reload_from_disk(db);
}

export fn db_check_at_stem(stem: &const byte) !DbCheckReport {
    const wal_report: WalCheckReport = try pager_check_wal_at_stem(stem);
    const info: PagerOpenInfo = try pager_open_at_stem(stem);
    if !db_check_meta_state_valid(&info.meta) {
        return error.DbPageCorrupt;
    }

    const snapshot: CatalogSnapshot = try catalog_load_at_stem(stem);
    const view: CatalogView = try catalog_view_from_page(snapshot.page[0: snapshot.page_size as usize]);
    var report: DbCheckReport = DbCheckReport{
        page_count: info.meta.page_count,
        checked_pages: 3u32,
        collection_count: view.root.collection_count,
        row_count: 0u32,
        wal_bytes: wal_report.wal_bytes,
        wal_records: wal_report.record_count,
        committed_wal_txns: wal_report.committed_txns,
    };

    var collection_idx: u32 = 0u32;
    while collection_idx < view.root.collection_count {
        const entry: CatalogCollectionView = try catalog_collection_at(&view, collection_idx);
        try db_check_collection_at_stem(stem, info.meta.page_size, &entry, &report.row_count);
        var decoded_next_doc_id: u64 = 0u64;
        var decoded_deleted_through_doc_id: u64 = 0u64;
        db_collection_meta_unpack_next_doc_id(entry.meta.next_doc_id, &decoded_next_doc_id, &decoded_deleted_through_doc_id);
        if decoded_next_doc_id > 1u64 {
            const expected_rows: u32 = (decoded_next_doc_id - 1u64) as u32;
            var collection: DbCollection = DbCollection{};
            collection.layout_flags = entry.meta.flags;
            collection.rows_per_page = entry.meta.rsv;
            report.checked_pages = report.checked_pages + db_collection_page_count_for_rows(&collection, expected_rows);
        }
        collection_idx = collection_idx + 1u32;
    }
    return report;
}

export fn db_check(db: &DbHandle) !DbCheckReport {
    if db == null {
        return error.DbHandleInvalid;
    }
    return try db_check_at_stem(db_stem_ptr(db));
}

export fn db_checkpoint(db: &DbHandle) !DbCheckReport {
    if db == null {
        return error.DbHandleInvalid;
    }
    db_close_pager_session(db);
    var guard: WriterLockGuard = writer_lock_guard_acquire(db.next_view_generation, db.next_view_generation);
    defer { writer_lock_guard_release(&guard); }
    _ = try pager_checkpoint_at_stem(db_stem_ptr(db));
    try db_reload_from_disk(db);
    return try db_check(db);
}

export fn db_upgrade_format(db: &DbHandle, plan: &PagerUpgradePlan) !PagerUpgradeReport {
    if db == null {
        return error.DbHandleInvalid;
    }
    db_close_pager_session(db);
    var guard: WriterLockGuard = writer_lock_guard_acquire(db.next_view_generation, db.next_view_generation);
    defer { writer_lock_guard_release(&guard); }
    const report: PagerUpgradeReport = try pager_upgrade_at_stem(db_stem_ptr(db), plan);
    try db_reload_from_disk(db);
    return report;
}

export fn db_vacuum(db: &DbHandle) !DbCheckReport {
    if db == null {
        return error.DbHandleInvalid;
    }
    return error.DbVacuumUnsupported;
}

export fn db_build_index(db: &DbHandle, collection_name: &[const byte], index_name: &[const byte], path_bytes: &[const byte]) !DbCheckReport {
    if db == null {
        return error.DbHandleInvalid;
    }
    var txn: Txn = try txn_begin(db);
    errdefer {
        _ = txn_rollback(&txn) catch {};
    }
    try db_txn_stage_create_index(&txn, collection_name, index_name, path_bytes);
    try txn_commit(&txn);
    return try db_check(db);
}

export fn db_test_track_drops(db: &DbHandle, cursor_counter: &i32, pin_counter: &i32) void {
    if db == null {
        return;
    }
    db.cursor_release_counter = cursor_counter;
    db.pin_release_counter = pin_counter;
}

export fn db_test_set_now_ms(db: &DbHandle, now_ms: u64) void {
    if db != null {
        db.now_ms = now_ms;
    }
}

export fn db_test_set_snapshot_policy(db: &DbHandle, policy: SnapshotPressurePolicy) void {
    if db != null {
        db.snapshot_policy = policy;
    }
}

export fn db_test_set_snapshot_status(db: &DbHandle, status: SnapshotPressureStatus) void {
    if db != null {
        db.snapshot_status_override_enabled = true;
        db.snapshot_status_override = status;
    }
}

export fn db_test_clear_snapshot_status_override(db: &DbHandle) void {
    if db != null {
        db.snapshot_status_override_enabled = false;
        db_refresh_snapshot_status(db);
    }
}

export fn db_test_snapshot_status(db: &DbHandle) SnapshotPressureStatus {
    return db_effective_snapshot_status(db);
}

export fn db_test_current_commit_view(db: &DbHandle) CommitView {
    const state: &CommitViewState = db_current_view_state(db) catch {
        return db_zero_commit_view();
    };
    return state.view;
}

export fn db_test_release_loaded_blobs(db: &DbHandle) !void {
    if db == null {
        return error.DbHandleInvalid;
    }
    const state: &CommitViewState = try db_current_view_state(db);
    db_release_view_loaded_blobs(state);
    db_finalize_view_state(state);
    db_refresh_snapshot_status(db);
}

export fn db_test_refresh_pager_session(db: &DbHandle) !void {
    if db == null {
        return error.DbHandleInvalid;
    }
    db_close_pager_session(db);
    db.pager_session = try pager_open_session_at_stem(db_stem_ptr(db));
}

export fn db_test_reset_primary_index(db: &DbHandle, collection_name: &[const byte]) !void {
    if db == null {
        return error.DbHandleInvalid;
    }
    const slot: u16 = try db_find_collection_slot_by_name(db, collection_name);
    const slot_idx: usize = (slot as! usize) catch {
        return error.DbCollectionNotFound;
    };
    if slot_idx >= DB_MAX_COLLECTIONS {
        return error.DbCollectionNotFound;
    }
    try primary_btree_reset(&db.primary_indexes[slot_idx], db_effective_page_size(db));
    const state: &CommitViewState = try db_current_view_state(db);
    const collection: &DbCollection = try db_collection_at_in_state(state, slot);
    collection.primary_index_ready = true;
}

export fn db_test_create_collection(db: &DbHandle, name: &[const byte]) !void {
    if db == null {
        return error.DbCollectionFull;
    }
    db_close_pager_session(db);
    const current: &CommitViewState = try db_current_view_state(db);
    if current.collection_count as usize >= DB_MAX_COLLECTIONS {
        return error.DbCollectionFull;
    }
    const created: CollectionMeta = try catalog_create_collection_at_stem(db_stem_ptr(db), name);
    const info: PagerOpenInfo = try pager_open_at_stem(db_stem_ptr(db));
    const view_slot: u16 = try db_stage_view_from_current(db);
    const state: &CommitViewState = try db_commit_view_state(db, view_slot);
    errdefer {
        db_clear_commit_view_state(state);
        db_refresh_snapshot_status(db);
    }
    const slot: usize = state.collection_count as usize;
    if slot >= DB_MAX_COLLECTIONS {
        return error.DbCollectionFull;
    }
    db_collection_reset(&state.collections[slot]);
    state.collections[slot].present = true;
    state.collections[slot].collection_id = created.collection_id;
    state.collections[slot].layout_flags = created.flags;
    state.collections[slot].rows_per_page = created.rsv;
    db_collection_meta_unpack_next_doc_id(created.next_doc_id, &state.collections[slot].next_doc_id, &state.collections[slot].deleted_through_doc_id);
    state.collections[slot].primary_root_page = created.primary_root_page;
    state.collections[slot].prefix_delete_only = true;
    try db_copy_name(name, state.collections[slot].name[0: 64], &state.collections[slot].name_len);
    try primary_btree_reset(&db.primary_indexes[slot], db_effective_page_size(db));
    state.collections[slot].primary_index_ready = false;
    state.collections[slot].rows_loaded = true;
    try db_collection_ensure_row_capacity(&state.collections[slot], 1u16);
    state.collection_count = state.collection_count + 1u16;
    state.view.commit_lsn = info.meta.commit_lsn;
    state.view.page_count = info.meta.page_count;
    state.view.catalog_root = info.meta.catalog_root;
    state.view.freelist_head = info.meta.freelist_head;
    try db_publish_view_slot(db, view_slot);
    db_cleanup_retired_views(db);
}

export fn db_test_insert_json(db: &DbHandle, collection_name: &[const byte], json: &[const byte]) !u64 {
    if db == null || json.ptr == null {
        return error.DbHandleInvalid;
    }
    var txn: Txn = try txn_begin(db);
    errdefer {
        _ = txn_rollback(&txn) catch {};
    }
    const doc_id: u64 = try db_txn_stage_insert(&txn, collection_name, json);
    try txn_commit(&txn);
    return doc_id;
}

export fn db_test_txn_insert_json(txn: &Txn, collection_name: &[const byte], json: &[const byte]) !u64 {
    if txn == null || json.ptr == null {
        return error.DbHandleInvalid;
    }
    return try db_txn_stage_insert(txn, collection_name, json);
}

export fn txn_begin(db: &DbHandle) !Txn {
    if db == null {
        return error.DbHandleInvalid;
    }
    const view_slot: u16 = try db_stage_view_from_current(db);
    return Txn{
        db: db,
        writer_guard: writer_lock_guard_acquire(db.next_view_generation, db.next_view_generation),
        view_slot: view_slot,
        has_writes: false,
        active: true,
        committed: false,
    };
}

export fn txn_exec(txn: &Txn, sql: &[const byte]) !void {
    if txn == null || txn.db == null {
        return error.DbHandleInvalid;
    }
    if !txn.active {
        return error.DbTxnInactive;
    }
    const stmt: SqlStmt = try sql_parse(sql);
    if stmt.kind == SqlStmtKind.INSERT {
        _ = try db_txn_stage_insert_stmt(txn, &stmt.insert_stmt);
        return;
    }
    if stmt.kind == SqlStmtKind.UPDATE {
        try db_txn_stage_update_stmt(txn, &stmt);
        return;
    }
    if stmt.kind == SqlStmtKind.DELETE {
        try db_txn_stage_delete_stmt(txn, &stmt);
        return;
    }
    if stmt.kind == SqlStmtKind.CREATE_INDEX {
        try db_txn_stage_create_index_stmt(txn, &stmt);
        return;
    }
    return error.DbUnsupportedStmt;
}

export fn txn_commit(txn: &Txn) !void {
    if txn == null || txn.db == null {
        return error.DbHandleInvalid;
    }
    if !txn.active {
        return error.DbTxnInactive;
    }
    if !txn.has_writes {
        writer_lock_guard_release(&txn.writer_guard);
        txn.committed = true;
        txn.active = false;
        return;
    }
    const previous_state: &CommitViewState = try db_current_view_state(txn.db);
    const committed: WalCommit = try db_txn_commit_persist(txn);
    errdefer {
        _ = db_reload_from_disk(txn.db) catch {};
        writer_lock_guard_release(&txn.writer_guard);
        txn.active = false;
    }
    const staged: &CommitViewState = try db_commit_view_state(txn.db, txn.view_slot);
    staged.view.commit_lsn = committed.commit_lsn;
    staged.view.page_count = committed.page_count;
    staged.view.catalog_root = committed.catalog_root;
    staged.view.freelist_head = committed.freelist_head;
    const collection_count: u16 = staged.collection_count;
    var collection_idx: u16 = 0u16;
    while collection_idx < collection_count {
        db_collection_clear_dirty_pages(&staged.collections[collection_idx as usize]);
        collection_idx = collection_idx + 1u16;
    }
    db_transfer_view_blob_ownership(previous_state, staged);
    try db_publish_view_slot(txn.db, txn.view_slot);
    try db_refresh_indexes_after_commit(txn.db, previous_state, collection_count);
    db_cleanup_retired_views(txn.db);
    writer_lock_guard_release(&txn.writer_guard);
    txn.committed = true;
    txn.active = false;
}

export fn txn_rollback(txn: &Txn) !void {
    if txn == null || txn.db == null {
        return error.DbHandleInvalid;
    }
    if !txn.active {
        return error.DbTxnInactive;
    }
    const staged: &CommitViewState = try db_commit_view_state(txn.db, txn.view_slot);
    db_clear_commit_view_state(staged);
    db_refresh_snapshot_status(txn.db);
    writer_lock_guard_release(&txn.writer_guard);
    txn.active = false;
}


struct DbFastInsertJsonParse {
    matched: bool,
    collection_name: &[const byte],
    json_text: &[const byte],
}

fn db_sql_is_space(b: byte) bool {
    return b == 32 || b == 9 || b == 10 || b == 13;
}

fn db_sql_ascii_upper(b: byte) byte {
    if b >= 97 && b <= 122 {
        return b - 32;
    }
    return b;
}

fn db_sql_is_ident_start(b: byte) bool {
    return (b >= 65 && b <= 90) || (b >= 97 && b <= 122) || b == 95;
}

fn db_sql_is_ident_continue(b: byte) bool {
    return db_sql_is_ident_start(b) || (b >= 48 && b <= 57);
}

fn db_sql_skip_ws(sql: &[const byte], pos: usize) usize {
    var i: usize = pos;
    while i < sql.len && db_sql_is_space(sql.ptr[i]) {
        i = i + 1usize;
    }
    return i;
}

fn db_sql_keyword_at(sql: &[const byte], pos: usize, keyword: &[const byte]) bool {
    if sql.ptr == null || keyword.ptr == null || pos + keyword.len > sql.len {
        return false;
    }
    var i: usize = 0usize;
    while i < keyword.len {
        if db_sql_ascii_upper(sql.ptr[pos + i]) != keyword.ptr[i] {
            return false;
        }
        i = i + 1usize;
    }
    const end_pos: usize = pos + keyword.len;
    if end_pos < sql.len && db_sql_is_ident_continue(sql.ptr[end_pos]) {
        return false;
    }
    return true;
}

fn db_sql_consume_keyword(sql: &[const byte], pos_inout: &usize, keyword: &[const byte]) bool {
    if pos_inout == null {
        return false;
    }
    const pos: usize = db_sql_skip_ws(sql, pos_inout[0]);
    if !db_sql_keyword_at(sql, pos, keyword) {
        return false;
    }
    pos_inout[0] = pos + keyword.len;
    return true;
}

fn db_parse_insert_json_fast(sql: &[const byte]) DbFastInsertJsonParse {
    if sql.ptr == null {
        return DbFastInsertJsonParse{ matched: false, collection_name: "", json_text: "" };
    }
    var pos: usize = 0usize;
    if !db_sql_consume_keyword(sql, &pos, &"INSERT"[0: 6]) {
        return DbFastInsertJsonParse{ matched: false, collection_name: "", json_text: "" };
    }
    if !db_sql_consume_keyword(sql, &pos, &"INTO"[0: 4]) {
        return DbFastInsertJsonParse{ matched: false, collection_name: "", json_text: "" };
    }
    pos = db_sql_skip_ws(sql, pos);
    if pos >= sql.len || !db_sql_is_ident_start(sql.ptr[pos]) {
        return DbFastInsertJsonParse{ matched: false, collection_name: "", json_text: "" };
    }
    const name_start: usize = pos;
    pos = pos + 1usize;
    while pos < sql.len && db_sql_is_ident_continue(sql.ptr[pos]) {
        pos = pos + 1usize;
    }
    const collection_name: &[const byte] = sql[name_start: pos - name_start];
    if !db_sql_consume_keyword(sql, &pos, &"JSON"[0: 4]) {
        return DbFastInsertJsonParse{ matched: false, collection_name: "", json_text: "" };
    }
    pos = db_sql_skip_ws(sql, pos);
    if pos >= sql.len || sql.ptr[pos] != 39 {
        return DbFastInsertJsonParse{ matched: false, collection_name: "", json_text: "" };
    }
    pos = pos + 1usize;
    const json_start: usize = pos;
    while pos < sql.len {
        if sql.ptr[pos] == 39 {
            if pos + 1usize < sql.len && sql.ptr[pos + 1usize] == 39 {
                return DbFastInsertJsonParse{ matched: false, collection_name: "", json_text: "" };
            }
            const json_text: &[const byte] = sql[json_start: pos - json_start];
            pos = pos + 1usize;
            pos = db_sql_skip_ws(sql, pos);
            if pos < sql.len && sql.ptr[pos] == 59 {
                pos = pos + 1usize;
                pos = db_sql_skip_ws(sql, pos);
            }
            if pos != sql.len {
                return DbFastInsertJsonParse{ matched: false, collection_name: "", json_text: "" };
            }
            return DbFastInsertJsonParse{ matched: true, collection_name: collection_name, json_text: json_text };
        }
        pos = pos + 1usize;
    }
    return DbFastInsertJsonParse{ matched: false, collection_name: "", json_text: "" };
}

fn db_exec_insert_json_fast(db: &DbHandle, parsed: &DbFastInsertJsonParse) !void {
    if db == null || parsed == null || !parsed.matched {
        return error.DbHandleInvalid;
    }
    var txn: Txn = try txn_begin(db);
    errdefer {
        _ = txn_rollback(&txn) catch {};
    }
    _ = try db_txn_stage_insert(&txn, parsed.collection_name, parsed.json_text);
    try txn_commit(&txn);
}

export fn db_exec(db: &DbHandle, sql: &[const byte]) !void {
    if db == null {
        return error.DbHandleInvalid;
    }
    const fast_insert: DbFastInsertJsonParse = db_parse_insert_json_fast(sql);
    if fast_insert.matched {
        try db_exec_insert_json_fast(db, &fast_insert);
        return;
    }
    const stmt: SqlStmt = try sql_parse(sql);
    if stmt.kind == SqlStmtKind.CREATE_COLLECTION {
        try db_test_create_collection(db, try db_identifier_bytes(&stmt.create_collection.collection_name));
        return;
    }
    if stmt.kind == SqlStmtKind.INSERT ||
        stmt.kind == SqlStmtKind.UPDATE ||
        stmt.kind == SqlStmtKind.DELETE ||
        stmt.kind == SqlStmtKind.CREATE_INDEX {
        var txn: Txn = try txn_begin(db);
        errdefer {
            _ = txn_rollback(&txn) catch {};
        }
        if stmt.kind == SqlStmtKind.INSERT {
            _ = try db_txn_stage_insert_stmt(&txn, &stmt.insert_stmt);
        } else if stmt.kind == SqlStmtKind.UPDATE {
            try db_txn_stage_update_stmt(&txn, &stmt);
        } else if stmt.kind == SqlStmtKind.DELETE {
            try db_txn_stage_delete_stmt(&txn, &stmt);
        } else {
            try db_txn_stage_create_index_stmt(&txn, &stmt);
        }
        try txn_commit(&txn);
        return;
    }
    return error.DbUnsupportedStmt;
}

fn db_compile_select_plan_in_view(db: &DbHandle, stmt: &SqlStmt, view_slot: u16, plan_out: &QueryPlan, collection_slot_out: &u16) !void {
    if db == null || stmt == null || stmt.kind != SqlStmtKind.SELECT || plan_out == null || collection_slot_out == null {
        return error.DbUnsupportedStmt;
    }
    const view_state: &CommitViewState = try db_commit_view_state(db, view_slot);
    const collection_slot: u16 = try db_find_collection_slot_by_name_in_view(db, view_slot, try db_identifier_bytes(&stmt.select_stmt.collection_name));
    const collection: &DbCollection = try db_collection_at_in_state(view_state, collection_slot);
    if collection.secondary_index_count == 0u16 {
        try bind_select_with_collection_metadata_into(stmt, collection.collection_id, collection.primary_root_page, &plan_out.bound);
    } else {
        try bind_select_at_stem_into(db_stem_ptr(db), stmt, &plan_out.bound);
    }
    try plan_select_into(&plan_out.bound, plan_out);
    collection_slot_out[0] = collection_slot;
}

fn db_select_plan_collect_in_view(db: &DbHandle, stmt: &SqlStmt, view_slot: u16, plan_out: &QueryPlan, collection_slot_out: &u16, out_rows: &[u32], count_out: &u16) !void {
    if out_rows.ptr == null || count_out == null {
        return error.DbUnsupportedStmt;
    }
    try db_compile_select_plan_in_view(db, stmt, view_slot, plan_out, collection_slot_out);
    try db_plan_collect(db, view_slot, plan_out, collection_slot_out[0], plan_out.root_node, out_rows, count_out);
}

fn db_select_plan_collect_cached_in_view(db: &DbHandle, plan: &QueryPlan, view_slot: u16, collection_slot_out: &u16, out_rows: &[u32], count_out: &u16) !void {
    if db == null || plan == null || collection_slot_out == null || out_rows.ptr == null || count_out == null {
        return error.DbUnsupportedStmt;
    }
    const collection_slot: u16 = try db_find_collection_slot_by_id_in_view(db, view_slot, plan.bound.collection_id);
    collection_slot_out[0] = collection_slot;
    try db_plan_collect(db, view_slot, plan, collection_slot, plan.root_node, out_rows, count_out);
}

fn db_query_cursor_from_cached_plan(db: &DbHandle, cached_plan: &QueryPlan) !QueryCursor {
    if db == null {
        return error.DbHandleInvalid;
    }
    db_cleanup_retired_views(db);
    const effective_status: SnapshotPressureStatus = db_effective_snapshot_status(db);
    if !snapshot_pressure_cursor_can_open(&db.snapshot_policy, &effective_status) {
        return error.SnapshotPressure;
    }
    const view_slot: u16 = try db_pin_current_view_slot(db);
    errdefer {
        db_unpin_view_slot(db, view_slot);
    }
    const view_state: &CommitViewState = try db_commit_view_state(db, view_slot);
    var match_rows: [u32: DB_MAX_CURSOR_ROWS] = [];
    var match_count: u16 = 0u16;
    var collection_slot: u16 = 0u16;
    try db_select_plan_collect_cached_in_view(db, cached_plan, view_slot, &collection_slot, match_rows[0: DB_MAX_CURSOR_ROWS], &match_count);
    try db_materialize_matched_rows_for_cursor(db, view_slot, collection_slot, match_rows[0: DB_MAX_CURSOR_ROWS], match_count);
    return QueryCursor{
        db: db,
        pin: CommitViewPin{
            db: db,
            view_slot: view_slot,
            view: view_state.view,
            lease: cursor_lease_start(&db.snapshot_policy, db.now_ms),
            held: true,
            release_counter: db.pin_release_counter,
        },
        collection_slot: collection_slot,
        match_count: match_count,
        match_rows: match_rows,
        next_index: 0u16,
        has_current: false,
        current_row: RowRef{
            doc_id: 0u64,
            record_ptr: record_pointer_make(0u32, 0u16),
            doc_blob: &""[0: 0],
        },
        release_counter: db.cursor_release_counter,
    };
}

fn db_query_cursor_from_select_stmt(db: &DbHandle, stmt: &SqlStmt, sql: &[const byte]) !QueryCursor {
    if db == null {
        return error.DbHandleInvalid;
    }
    if stmt == null || stmt.kind != SqlStmtKind.SELECT {
        return error.DbUnsupportedStmt;
    }
    db_cleanup_retired_views(db);
    const effective_status: SnapshotPressureStatus = db_effective_snapshot_status(db);
    if !snapshot_pressure_cursor_can_open(&db.snapshot_policy, &effective_status) {
        return error.SnapshotPressure;
    }
    const view_slot: u16 = try db_pin_current_view_slot(db);
    errdefer {
        db_unpin_view_slot(db, view_slot);
    }
    const view_state: &CommitViewState = try db_commit_view_state(db, view_slot);
    var plan: QueryPlan = QueryPlan{};
    var match_rows: [u32: DB_MAX_CURSOR_ROWS] = [];
    var match_count: u16 = 0u16;
    var collection_slot: u16 = 0u16;
    try db_compile_select_plan_in_view(db, stmt, view_slot, &plan, &collection_slot);
    db_query_cache_store(db, sql, false, &plan);
    try db_plan_collect(db, view_slot, &plan, collection_slot, plan.root_node, match_rows[0: DB_MAX_CURSOR_ROWS], &match_count);
    try db_materialize_matched_rows_for_cursor(db, view_slot, collection_slot, match_rows[0: DB_MAX_CURSOR_ROWS], match_count);
    return QueryCursor{
        db: db,
        pin: CommitViewPin{
            db: db,
            view_slot: view_slot,
            view: view_state.view,
            lease: cursor_lease_start(&db.snapshot_policy, db.now_ms),
            held: true,
            release_counter: db.pin_release_counter,
        },
        collection_slot: collection_slot,
        match_count: match_count,
        match_rows: match_rows,
        next_index: 0u16,
        has_current: false,
        current_row: RowRef{
            doc_id: 0u64,
            record_ptr: record_pointer_make(0u32, 0u16),
            doc_blob: &""[0: 0],
        },
        release_counter: db.cursor_release_counter,
    };
}

export fn db_query_cursor(db: &DbHandle, sql: &[const byte]) !QueryCursor {
    const cached: &DbQueryCacheEntry = db_query_cache_lookup(db, sql);
    if cached != null {
        if cached.explain {
            return error.DbUnsupportedStmt;
        }
        return try db_query_cursor_from_cached_plan(db, &cached.plan);
    }
    const stmt: SqlStmt = try sql_parse(sql);
    return try db_query_cursor_from_select_stmt(db, &stmt, sql);
}

export fn cursor_next(cursor: &QueryCursor) !bool {
    if cursor == null || cursor.db == null {
        return error.DbHandleInvalid;
    }
    try cursor_lease_validate(&cursor.pin.lease, cursor.db.now_ms);
    if cursor.next_index >= cursor.match_count {
        cursor.has_current = false;
        return false;
    }
    const next_idx: usize = (cursor.next_index as! usize) catch {
        return error.DbInvalidProjection;
    };
    if next_idx >= DB_MAX_CURSOR_ROWS {
        return error.DbInvalidProjection;
    }
    const row_slot: u32 = cursor.match_rows[next_idx];
    cursor.current_row = try db_collection_row_ref(cursor.db, cursor.pin.view_slot, cursor.collection_slot, row_slot);
    cursor.next_index = cursor.next_index + 1u16;
    cursor.has_current = true;
    return true;
}

export fn cursor_row(cursor: &QueryCursor) !RowRef {
    if cursor == null || !cursor.has_current {
        return error.DbInvalidProjection;
    }
    return cursor.current_row;
}

fn db_explain_query_plan_with_allocator(plan: &QueryPlan, allocator: IAllocator) !QueryResult {
    if plan == null {
        return error.DbUnsupportedStmt;
    }
    var explain_buf: [byte: 1024] = [];
    const explain_len: usize = try plan_explain(plan, explain_buf[0: 1024]);
    return try db_build_single_text_result_with_allocator(explain_buf[0: explain_len], allocator);
}

fn db_query_cached_plan_with_allocator(db: &DbHandle, plan: &QueryPlan, allocator: IAllocator) !QueryResult {
    if db == null || plan == null {
        return error.DbHandleInvalid;
    }
    db_cleanup_retired_views(db);
    const effective_status: SnapshotPressureStatus = db_effective_snapshot_status(db);
    if !snapshot_pressure_cursor_can_open(&db.snapshot_policy, &effective_status) {
        return error.SnapshotPressure;
    }
    const view_slot: u16 = try db_pin_current_view_slot(db);
    defer {
        db_unpin_view_slot(db, view_slot);
    }
    var match_rows: [u32: DB_MAX_CURSOR_ROWS] = [];
    var match_count: u16 = 0u16;
    var collection_slot: u16 = 0u16;
    try db_select_plan_collect_cached_in_view(db, plan, view_slot, &collection_slot, match_rows[0: DB_MAX_CURSOR_ROWS], &match_count);
    var row_capacity: usize = match_count as usize;
    if row_capacity > QUERY_RESULT_MAX_ROWS {
        return error.DbResultTooLarge;
    }
    if row_capacity == 0usize {
        row_capacity = 1usize;
    }
    const storage_size: usize = row_capacity * (@size_of(OwnedRow) as usize);
    const rows_alloc: !&byte = allocator.alloc(storage_size);
    if rows_alloc.error_id != 0u32 {
        return error.DbResultTooLarge;
    }
    const rows_mem: &byte = rows_alloc.value;
    errdefer {
        allocator.dealloc(rows_mem);
    }
    const rows_ptr: &OwnedRow = rows_mem as &OwnedRow;
    const column_count: u16 = plan.bound.projection_count;
    var row_count: u32 = 0u32;
    var match_index: u16 = 0u16;
    while match_index < match_count {
        if row_count as usize >= QUERY_RESULT_MAX_ROWS {
            return error.DbResultTooLarge;
        }
        const rowref: RowRef = try db_collection_row_ref(db, view_slot, collection_slot, match_rows[match_index as usize]);
        const row_idx: usize = (row_count as! usize) catch {
            return error.DbResultTooLarge;
        };
        if row_idx >= QUERY_RESULT_MAX_ROWS {
            return error.DbResultTooLarge;
        }
        const row_addr: usize = @usize_from_ptr(rows_ptr as &void) + row_idx * (@size_of(OwnedRow) as usize);
        const out_row: &OwnedRow = @ptr_from_usize(row_addr) as &OwnedRow;
        try db_project_row(&plan.bound, &rowref, out_row);
        row_count = row_count + 1u32;
        match_index = match_index + 1u16;
    }
    return QueryResult{
        allocator: allocator,
        column_count: column_count,
        row_count: row_count,
        rows: rows_ptr,
    };
}

export fn db_query_with_allocator(db: &DbHandle, sql: &[const byte], allocator: IAllocator) !QueryResult {
    const cached: &DbQueryCacheEntry = db_query_cache_lookup(db, sql);
    if cached != null {
        if cached.explain {
            return try db_explain_query_plan_with_allocator(&cached.plan, allocator);
        }
        return try db_query_cached_plan_with_allocator(db, &cached.plan, allocator);
    }

    var stmt: SqlStmt = try sql_parse(sql);
    if stmt.kind == SqlStmtKind.EXPLAIN {
        stmt.kind = SqlStmtKind.SELECT;
        var plan: QueryPlan = QueryPlan{};
        try bind_select_at_stem_into(db_stem_ptr(db), &stmt, &plan.bound);
        try plan_select_into(&plan.bound, &plan);
        db_query_cache_store(db, sql, true, &plan);
        return try db_explain_query_plan_with_allocator(&plan, allocator);
    }
    if db == null {
        return error.DbHandleInvalid;
    }
    db_cleanup_retired_views(db);
    const effective_status: SnapshotPressureStatus = db_effective_snapshot_status(db);
    if !snapshot_pressure_cursor_can_open(&db.snapshot_policy, &effective_status) {
        return error.SnapshotPressure;
    }
    if stmt.kind != SqlStmtKind.SELECT {
        return error.DbUnsupportedStmt;
    }
    const view_slot: u16 = try db_pin_current_view_slot(db);
    defer {
        db_unpin_view_slot(db, view_slot);
    }
    var plan: QueryPlan = QueryPlan{};
    var collection_slot: u16 = 0u16;
    try db_compile_select_plan_in_view(db, &stmt, view_slot, &plan, &collection_slot);
    db_query_cache_store(db, sql, false, &plan);
    var match_rows: [u32: DB_MAX_CURSOR_ROWS] = [];
    var match_count: u16 = 0u16;
    try db_plan_collect(db, view_slot, &plan, collection_slot, plan.root_node, match_rows[0: DB_MAX_CURSOR_ROWS], &match_count);
    var row_capacity: usize = match_count as usize;
    if row_capacity > QUERY_RESULT_MAX_ROWS {
        return error.DbResultTooLarge;
    }
    if row_capacity == 0usize {
        row_capacity = 1usize;
    }
    const storage_size: usize = row_capacity * (@size_of(OwnedRow) as usize);
    const rows_alloc: !&byte = allocator.alloc(storage_size);
    if rows_alloc.error_id != 0u32 {
        return error.DbResultTooLarge;
    }
    const rows_mem: &byte = rows_alloc.value;
    errdefer {
        allocator.dealloc(rows_mem);
    }
    const rows_ptr: &OwnedRow = rows_mem as &OwnedRow;
    const column_count: u16 = plan.bound.projection_count;
    var row_count: u32 = 0u32;
    var match_index: u16 = 0u16;
    while match_index < match_count {
        if row_count as usize >= QUERY_RESULT_MAX_ROWS {
            return error.DbResultTooLarge;
        }
        const rowref: RowRef = try db_collection_row_ref(db, view_slot, collection_slot, match_rows[match_index as usize]);
        const row_idx: usize = (row_count as! usize) catch {
            return error.DbResultTooLarge;
        };
        if row_idx >= QUERY_RESULT_MAX_ROWS {
            return error.DbResultTooLarge;
        }
        const row_addr: usize = @usize_from_ptr(rows_ptr as &void) + row_idx * (@size_of(OwnedRow) as usize);
        const out_row: &OwnedRow = @ptr_from_usize(row_addr) as &OwnedRow;
        try db_project_row(&plan.bound, &rowref, out_row);
        row_count = row_count + 1u32;
        match_index = match_index + 1u16;
    }
    return QueryResult{
        allocator: allocator,
        column_count: column_count,
        row_count: row_count,
        rows: rows_ptr,
    };
}

export fn db_query(db: &DbHandle, sql: &[const byte]) !QueryResult {
    if db == null {
        return error.DbHandleInvalid;
    }
    var allocator_impl: DbResultPoolAllocator = DbResultPoolAllocator{
        pool: db.result_pool,
    };
    const allocator: IAllocator = allocator_impl;
    return try db_query_with_allocator(db, sql, allocator);
}
