        var i: u32 = 0u32;
        while i < index_state.row_count {
            const row_slot: u32 = index_state.row_slots[i as usize];
            if try db_row_matches_filter_expr(txn.db, plan, txn.view_slot, collection_slot, row_slot, root.filter_expr) {
                if try db_txn_apply_delete_row(txn, collection_slot, row_slot) {
                    changed = changed + 1u32;
                }
            }
            i = i + 1u32;
        }
        return changed;
    }
    if root.kind == PlanNodeKind.FILTER {
        const child: &PlanNode = try plan_node(plan, root.child);
        if child.kind == PlanNodeKind.SEQ_SCAN {
            try db_ensure_collection_rows_loaded_in_view(txn.db, txn.view_slot, collection_slot);
            const state: &CommitViewState = try db_commit_view_state(txn.db, txn.view_slot);
            const collection: &DbCollection = try db_collection_at_in_state(state, collection_slot);
            var changed: u32 = 0u32;
            var row_slot: u32 = 0u32;
            while row_slot < collection.row_count {
                const row: &DbStoredRow = &collection.rows[row_slot as usize];
                if db_row_visible_at_slot(collection, row, row_slot) {
                    if try db_row_matches_filter_expr(txn.db, plan, txn.view_slot, collection_slot, row_slot, root.filter_expr) {
                        if try db_txn_apply_delete_row_in_collection(collection, row_slot) {
                            changed = changed + 1u32;
                        }
                    }
                }
                row_slot = row_slot + 1u32;
            }
            return changed;
        }
        if child.kind == PlanNodeKind.PRIMARY_LOOKUP {
            var found: bool = false;
            var row_slot: u32 = 0u32;
            try db_plan_primary_lookup_row_slot(txn.db, txn.view_slot, collection_slot, child.lookup_doc_id, &found, &row_slot);
            if !found {
                return 0u32;
            }
            if !(try db_row_matches_filter_expr(txn.db, plan, txn.view_slot, collection_slot, row_slot, root.filter_expr)) {
                return 0u32;
            }
            if try db_txn_apply_delete_row(txn, collection_slot, row_slot) {
                return 1u32;
            }
            return 0u32;
        }
        if child.kind == PlanNodeKind.INDEX_SCAN {
            try db_ensure_secondary_index(txn.db, collection_slot, child.index_slot);
            const index_state: &DbSecondaryIndexState = try db_secondary_index_state(txn.db, collection_slot, child.index_slot);
            if !index_state.present {
                return 0u32;
            }
            var changed: u32 = 0u32;
            var i: u32 = 0u32;
            while i < index_state.row_count {
                const row_slot: u32 = index_state.row_slots[i as usize];
                if try db_row_matches_filter_expr(txn.db, plan, txn.view_slot, collection_slot, row_slot, root.filter_expr) {
