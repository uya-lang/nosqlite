struct DbResultPool {
    small_slots: [DbResultPoolSmallSlot: DB_RESULT_POOL_SMALL_SLOTS],
    medium_slots: [DbResultPoolMediumSlot: DB_RESULT_POOL_MEDIUM_SLOTS],
    large_slots: [DbResultPoolLargeSlot: DB_RESULT_POOL_LARGE_SLOTS],
}

struct DbResultPoolAllocator : IAllocator {
    pool: &DbResultPool,

    fn alloc(self: &Self, size: usize) !&byte {
        if size == 0usize {
            return error.AllocInvalidSize;
        }
        const pool_ptr: &byte = db_result_pool_alloc(self.pool, size);
        if pool_ptr != null {
            return pool_ptr;
        }
        return error.AllocOutOfMemory;
    }

    fn dealloc(self: &Self, ptr: &byte) void {
        if ptr == null {
            return;
        }
        if db_result_pool_dealloc(self.pool, ptr) {
            return;
        }
    }

    fn realloc(self: &Self, ptr: &byte, new_size: usize) !&byte {
        if ptr == null {
            return self.alloc(new_size);
        }
        if new_size == 0usize {
            self.dealloc(ptr);
            return error.AllocInvalidSize;
        }
        const old_cap: usize = db_result_pool_capacity(self.pool, ptr);
        if new_size <= old_cap {
            return ptr;
        }
        if old_cap == 0usize {
            return error.AllocInvalidPointer;
        }
        const new_ptr: &byte = try self.alloc(new_size);
        _ = mem_copy(new_ptr, ptr as &const byte, old_cap);
        self.dealloc(ptr);
        return new_ptr;
    }
}

