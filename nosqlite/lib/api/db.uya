    DOC_NODE,
}

struct ExecValue {
    kind: ExecValueKind,
    bool_value: bool,
    i64_value: i64,
    u64_value: u64,
    text_len: u16,
    text: [byte: 2048],
    doc_node: &[byte],
}

fn db_store_u16_le(out: &[byte], off: usize, value: u16) void {
    out.ptr[off] = ((value & 255u16) as! byte).value;
    out.ptr[off + 1usize] = (((value >> 8) & 255u16) as! byte).value;
}

fn db_store_u32_le(out: &[byte], off: usize, value: u32) void {
    out.ptr[off] = ((value & 255u32) as! byte).value;
    out.ptr[off + 1usize] = (((value >> 8) & 255u32) as! byte).value;
    out.ptr[off + 2usize] = (((value >> 16) & 255u32) as! byte).value;
    out.ptr[off + 3usize] = (((value >> 24) & 255u32) as! byte).value;
}

fn db_store_u64_le(out: &[byte], off: usize, value: u64) void {
    out.ptr[off] = ((value & 255u64) as! byte).value;
    out.ptr[off + 1usize] = (((value >> 8) & 255u64) as! byte).value;
    out.ptr[off + 2usize] = (((value >> 16) & 255u64) as! byte).value;
    out.ptr[off + 3usize] = (((value >> 24) & 255u64) as! byte).value;
    out.ptr[off + 4usize] = (((value >> 32) & 255u64) as! byte).value;
    out.ptr[off + 5usize] = (((value >> 40) & 255u64) as! byte).value;
    out.ptr[off + 6usize] = (((value >> 48) & 255u64) as! byte).value;
    out.ptr[off + 7usize] = (((value >> 56) & 255u64) as! byte).value;
}

fn db_load_u16_le(data: &[byte], off: usize) u16 {
    return (data.ptr[off] as u16) |
        ((data.ptr[off + 1usize] as u16) << 8);
}

fn db_load_u32_le(data: &[byte], off: usize) u32 {
    return (data.ptr[off] as u32) |
        ((data.ptr[off + 1usize] as u32) << 8) |
        ((data.ptr[off + 2usize] as u32) << 16) |
        ((data.ptr[off + 3usize] as u32) << 24);
}

fn db_load_u64_le(data: &[byte], off: usize) u64 {
    return (data.ptr[off] as u64) |
        ((data.ptr[off + 1usize] as u64) << 8) |
        ((data.ptr[off + 2usize] as u64) << 16) |
        ((data.ptr[off + 3usize] as u64) << 24) |
        ((data.ptr[off + 4usize] as u64) << 32) |
        ((data.ptr[off + 5usize] as u64) << 40) |
        ((data.ptr[off + 6usize] as u64) << 48) |
        ((data.ptr[off + 7usize] as u64) << 56);
}

fn db_copy_name(name: &[const byte], out: &[byte], len_out: &u16) !void {
    if name.ptr == null || out.ptr == null || len_out == null || name.len > 64usize {
        return error.DbCollectionNotFound;
    }
    len_out[0] = (name.len as! u16) catch {
        return error.DbCollectionNotFound;
    };
    if name.len > 0 {
        _ = mem_copy(out.ptr, name.ptr, name.len);
    }
}

fn db_collection_meta_unpack_next_doc_id(packed: u64, next_doc_id_out: &u64, deleted_through_doc_id_out: &u64) void {
    if next_doc_id_out != null {
        next_doc_id_out[0] = packed & DB_COLLECTION_META_DOC_ID_MASK;
    }
    if deleted_through_doc_id_out != null {
        deleted_through_doc_id_out[0] = packed >> 32i32;
    }
}

fn db_collection_meta_pack_next_doc_id(next_doc_id: u64, deleted_through_doc_id: u64) !u64 {
    if next_doc_id == 0u64 ||
        next_doc_id > DB_COLLECTION_META_DOC_ID_MASK ||
        deleted_through_doc_id > DB_COLLECTION_META_DOC_ID_MASK {
        return error.DbRowFull;
    }
    return next_doc_id | (deleted_through_doc_id << 32i32);
}

fn db_copy_path(path: &[const byte], out: &[byte], len_out: &u16) !void {
    if path.ptr == null || out.ptr == null || len_out == null || path.len > 128usize {
        return error.DbInvalidExpr;
    }
    len_out[0] = (path.len as! u16) catch {
        return error.DbInvalidExpr;
    };
    if path.len > 0 {
        _ = mem_copy(out.ptr, path.ptr, path.len);
    }
}

fn db_effective_page_size(db: &DbHandle) u32 {
    if db != null && db.pager_session.active {
        return db.pager_session.info.meta.page_size;
    }
    return NOSQLITE_PAGE_SIZE_DEFAULT;
}

fn db_collection_uses_packed_layout(collection: &DbCollection) bool {
    return collection != null && (collection.layout_flags & COLLECTION_FLAG_PACKED_LAYOUT) != 0u16;
}

fn db_collection_rows_per_page(collection: &DbCollection) u16 {
    if db_collection_uses_packed_layout(collection) && collection.rows_per_page != 0u16 {
        return collection.rows_per_page;
    }
    return DB_ROWS_PER_DATA_PAGE_LEGACY;
}

fn db_collection_update_max_doc_len(collection: &DbCollection, doc_len: u16) bool {
    if collection == null || doc_len <= collection.max_doc_len_seen {
        return false;
    }
    collection.max_doc_len_seen = doc_len;
    return true;
}

fn db_collection_compute_packed_rows_per_page(page_size: u32, max_doc_len: u16) u16 {
    if page_size as usize <= page_header_size() {
        return 1u16;
    }
    const usable_bytes: usize = (page_size as usize) - page_header_size();
    const bytes_per_row: usize = slot_size() + RECORD_CELL_HEADER_SIZE + (max_doc_len as usize);
    if bytes_per_row == 0usize {
        return 1u16;
    }
    var rows_per_page: usize = usable_bytes / bytes_per_row;
    if rows_per_page == 0usize {
        rows_per_page = 1usize;
    }
    if rows_per_page > 65535usize {
        rows_per_page = 65535usize;
    }
    return (rows_per_page as! u16) catch {
        return 1u16;
    };
}

fn db_collection_index_reset(index_meta: &DbCollectionIndexMeta) void {
    if index_meta == null {
        return;
    }
    index_meta.present = false;
    index_meta.index_id = 0u32;
    index_meta.root_page = 0u32;
    index_meta.path_segment_count = 0u16;
    index_meta.name_len = 0u16;
    index_meta.path_len = 0u16;
}

fn db_secondary_index_state_reset(index_state: &DbSecondaryIndexState) void {
    if index_state == null {
        return;
    }
    if index_state.row_slots != null {
        const allocator: &HeapAllocator = get_heap_allocator();
        allocator.dealloc(index_state.row_slots as &byte);
        index_state.row_slots = null;
    }
    index_state.present = false;
    index_state.index_id = 0u32;
    index_state.name_len = 0u16;
    index_state.path_len = 0u16;
    index_state.path_program = PathProgram{};
    index_state.row_count = 0u32;
    index_state.row_capacity = 0u32;
}

fn db_secondary_index_flat_slot(collection_slot: u16, index_slot: u16) !usize {
    const collection_idx: usize = (collection_slot as! usize) catch {
        return error.DbCollectionNotFound;
    };
    const index_idx: usize = (index_slot as! usize) catch {
        return error.DbCollectionNotFound;
    };
    if collection_idx >= DB_MAX_COLLECTIONS || index_idx >= DB_MAX_SECONDARY_INDEXES_PER_COLLECTION {
        return error.DbCollectionNotFound;
    }
    return collection_idx * DB_MAX_SECONDARY_INDEXES_PER_COLLECTION + index_idx;
}

fn db_secondary_index_state(db: &DbHandle, collection_slot: u16, index_slot: u16) !&DbSecondaryIndexState {
    if db == null {
        return error.DbHandleInvalid;
    }
    const flat: usize = try db_secondary_index_flat_slot(collection_slot, index_slot);
    if flat >= DB_MAX_COLLECTIONS * DB_MAX_SECONDARY_INDEXES_PER_COLLECTION {
        return error.DbCollectionNotFound;
    }
    return &db.secondary_indexes[flat];
}

fn db_collection_at_in_state(state: &CommitViewState, collection_slot: u16) !&DbCollection {
    if state == null {
        return error.DbCollectionNotFound;
    }
    const idx: usize = (collection_slot as! usize) catch {
        return error.DbCollectionNotFound;
    };
    if idx >= DB_MAX_COLLECTIONS {
        return error.DbCollectionNotFound;
    }
    return &state.collections[idx];
}

fn db_blob_arena_chunk_reset(chunk: &DbBlobArenaChunk) void {
    if chunk == null {
        return;
    }
    chunk.data = null;
    chunk.used = 0u32;
    chunk.capacity = 0u32;
}

fn db_collection_release_blob_chunks(collection: &DbCollection) void {
    if collection == null {
        return;
    }
    const allocator: &HeapAllocator = get_heap_allocator();
    var chunk_idx: usize = 0usize;
    while chunk_idx < collection.blob_chunk_count as usize {
        if collection.blob_chunks[chunk_idx].data != null {
            allocator.dealloc(collection.blob_chunks[chunk_idx].data);
        }
        db_blob_arena_chunk_reset(&collection.blob_chunks[chunk_idx]);
        chunk_idx = chunk_idx + 1usize;
    }
    collection.blob_chunk_count = 0u16;
}

fn db_collection_next_blob_chunk_capacity(collection: &DbCollection, needed: usize) !u32 {
    if collection == null || needed == 0usize || needed > DB_DOC_BLOB_MAX {
        return error.DbRowTooLarge;
    }
    const needed_u32: u32 = (needed as! u32) catch {
        return error.DbRowTooLarge;
    };
    var capacity: u32 = DB_BLOB_ARENA_CHUNK_MIN_BYTES;
    if collection.blob_chunk_count > 0u16 {
        const last_idx: usize = (collection.blob_chunk_count - 1u16) as usize;
        if last_idx >= DB_BLOB_ARENA_MAX_CHUNKS {
            return error.DbRowTooLarge;
        }
        if collection.blob_chunks[last_idx].capacity > capacity {
            capacity = collection.blob_chunks[last_idx].capacity;
        }
        if capacity < DB_BLOB_ARENA_CHUNK_GROW_MAX {
            if capacity > (DB_BLOB_ARENA_CHUNK_GROW_MAX / 2u32) {
                capacity = DB_BLOB_ARENA_CHUNK_GROW_MAX;
            } else {
                capacity = capacity * 2u32;
            }
        }
    }
    while capacity < needed_u32 {
        if capacity >= DB_BLOB_ARENA_CHUNK_GROW_MAX {
            capacity = needed_u32;
            break;
        }
        if capacity > (DB_BLOB_ARENA_CHUNK_GROW_MAX / 2u32) {
            capacity = DB_BLOB_ARENA_CHUNK_GROW_MAX;
        } else {
            capacity = capacity * 2u32;
        }
    }
    if capacity < needed_u32 {
        capacity = needed_u32;
    }
    return capacity;
}

fn db_collection_blob_alloc(collection: &DbCollection, size: usize) !&byte {
    if collection == null {
        return error.DbCollectionNotFound;
    }
    if size == 0usize {
        return null;
    }
    if size > DB_DOC_BLOB_MAX {
        return error.DbRowTooLarge;
    }
    const size_u32: u32 = (size as! u32) catch {
        return error.DbRowTooLarge;
    };
    if collection.blob_chunk_count > 0u16 {
        const last_idx: usize = (collection.blob_chunk_count - 1u16) as usize;
        if last_idx >= DB_BLOB_ARENA_MAX_CHUNKS {
            return error.DbRowTooLarge;
        }
        const last: &DbBlobArenaChunk = &collection.blob_chunks[last_idx];
        if last.data != null && last.capacity >= last.used && (last.capacity - last.used) >= size_u32 {
            const out: &byte = &last.data[last.used as usize];
            last.used = last.used + size_u32;
            return out;
        }
    }
    if collection.blob_chunk_count as usize >= DB_BLOB_ARENA_MAX_CHUNKS {
        return error.DbRowTooLarge;
    }
    const chunk_capacity: u32 = try db_collection_next_blob_chunk_capacity(collection, size);
    const allocator: &HeapAllocator = get_heap_allocator();
    const mem: &byte = try allocator.alloc(chunk_capacity as usize);
    const chunk_idx: usize = collection.blob_chunk_count as usize;
    if chunk_idx >= DB_BLOB_ARENA_MAX_CHUNKS {
        allocator.dealloc(mem);
        return error.DbRowTooLarge;
    }
    const chunk: &DbBlobArenaChunk = &collection.blob_chunks[chunk_idx];
    chunk.data = mem;
    chunk.used = size_u32;
    chunk.capacity = chunk_capacity;
    collection.blob_chunk_count = collection.blob_chunk_count + 1u16;
    return mem;
}

fn db_stored_row_reset(row: &DbStoredRow) void {
    if row == null {
        return;
    }
    row.present = false;
    row.tombstone = false;
    row.blob_loaded = false;
    row.doc_blob_owned = false;
    row.doc_id = 0u64;
    row.record_ptr = record_pointer_make(0u32, 0u16);
    row.doc_len = 0u16;
    row.doc_blob = null;
}

fn db_collection_row_set_blob_copy(collection: &DbCollection, row: &DbStoredRow, doc_blob: &[byte]) !void {
    if collection == null || row == null {
        return error.DbRowTooLarge;
    }
    if doc_blob.ptr == null && doc_blob.len > 0usize {
        return error.DbRowTooLarge;
    }
    if doc_blob.len > DB_DOC_BLOB_MAX {
        return error.DbRowTooLarge;
    }
    row.doc_len = (doc_blob.len as! u16) catch {
        return error.DbRowTooLarge;
    };
    if doc_blob.len == 0usize {
        row.doc_blob = null;
        row.blob_loaded = true;
        row.doc_blob_owned = false;
        return;
    }
    row.doc_blob = try db_collection_blob_alloc(collection, doc_blob.len);
    _ = mem_copy(row.doc_blob, doc_blob.ptr, doc_blob.len);
    row.blob_loaded = true;
    row.doc_blob_owned = false;
}

fn db_rows_alloc_size(capacity: u32) usize {
    return (capacity as usize) * (@size_of(DbStoredRow) as usize);
}

fn db_collection_ensure_rows_refcount(collection: &DbCollection) !void {
    if collection == null || collection.rows == null || collection.rows_refcount != null {
        return;
    }
    const allocator: &HeapAllocator = get_heap_allocator();
    const ref_mem: &byte = try allocator.alloc(4usize);
    collection.rows_refcount = ref_mem as &u32;
    collection.rows_refcount[0] = 1u32;
}

fn db_collection_rows_shared(collection: &DbCollection) bool {
    return collection != null &&
        collection.rows != null &&
        collection.rows_refcount != null &&
        collection.rows_refcount[0] > 1u32;
}

fn db_collection_release_row_storage_ref(collection: &DbCollection) void {
    if collection == null {
        return;
    }
    const allocator: &HeapAllocator = get_heap_allocator();
    if collection.rows_refcount != null {
        if collection.rows_refcount[0] > 1u32 {
            collection.rows_refcount[0] = collection.rows_refcount[0] - 1u32;
        } else {
            if collection.rows != null {
                allocator.dealloc(collection.rows as &byte);
            }
            allocator.dealloc(collection.rows_refcount as &byte);
        }
    } else if collection.rows != null {
        allocator.dealloc(collection.rows as &byte);
    }
    collection.rows = null;
    collection.rows_refcount = null;
    collection.row_capacity = 0u32;
}

fn db_secondary_index_slots_alloc_size(capacity: u32) usize {
    return (capacity as usize) * 4usize;
}

fn db_secondary_index_next_capacity(needed: u32) !u32 {
    if needed as usize > DB_MAX_ROWS_PER_COLLECTION {
        return error.DbRowFull;
    }
    var capacity: u32 = 64u32;
    while capacity < needed {
        if capacity >= NOSQLITE_COLLECTION_MAX_ROWS_PER_COLLECTION {
            capacity = NOSQLITE_COLLECTION_MAX_ROWS_PER_COLLECTION;
            break;
        }
        capacity = capacity * 2u32;
    }
    if capacity < needed {
        return error.DbRowFull;
    }
    return capacity;
}

fn db_secondary_index_ensure_row_capacity(index_state: &DbSecondaryIndexState, needed: u32) !void {
    if index_state == null || needed == 0u32 {
        return;
    }
    if needed as usize > DB_MAX_ROWS_PER_COLLECTION {
        return error.DbRowFull;
    }
    if index_state.row_slots != null && index_state.row_capacity >= needed {
        return;
    }
    const new_capacity: u32 = try db_secondary_index_next_capacity(needed);
    const new_bytes: usize = db_secondary_index_slots_alloc_size(new_capacity);
    const old_capacity: u32 = index_state.row_capacity;
    const old_bytes: usize = db_secondary_index_slots_alloc_size(old_capacity);
    const allocator: &HeapAllocator = get_heap_allocator();
    var mem: &byte = null;
    if index_state.row_slots == null || old_capacity == 0u32 {
        mem = try allocator.alloc(new_bytes);
        _ = mem_set(mem, 0, new_bytes);
    } else {
        mem = try allocator.realloc(index_state.row_slots as &byte, new_bytes);
        if new_bytes > old_bytes {
            if mem == null {
                return error.DbRowFull;
            }
            _ = mem_set(&mem[old_bytes], 0, new_bytes - old_bytes);
        }
    }
    index_state.row_slots = mem as &u32;
    index_state.row_capacity = new_capacity;
}

fn db_collection_next_capacity(needed: u32) !u32 {
    if needed as usize > DB_MAX_ROWS_PER_COLLECTION {
        return error.DbRowFull;
    }
    var capacity: u32 = 64u32;
    while capacity < needed {
        if capacity >= NOSQLITE_COLLECTION_MAX_ROWS_PER_COLLECTION {
            capacity = NOSQLITE_COLLECTION_MAX_ROWS_PER_COLLECTION;
            break;
        }
        capacity = capacity * 2u32;
    }
    if capacity < needed {
        return error.DbRowFull;
    }
    return capacity;
}

fn db_collection_dirty_word_capacity(collection: &DbCollection, rows: u32) u32 {
    const page_count: u32 = db_collection_page_count_for_rows(collection, rows);
    if page_count == 0u32 {
        return 0u32;
    }
    return ((page_count - 1u32) / 64u32) + 1u32;
}

fn db_collection_clear_tombstone_patch_pages(collection: &DbCollection) void {
    if collection == null {
        return;
    }
    collection.tombstone_patch_pages_valid = false;
    collection.tombstone_patch_page_start = 0u32;
    collection.tombstone_patch_page_end_exclusive = 0u32;
}

fn db_collection_extend_tombstone_patch_pages(collection: &DbCollection, start_page: u32, end_page_exclusive: u32) void {
    if collection == null || start_page >= end_page_exclusive {
        return;
    }
    if !collection.tombstone_patch_pages_valid {
        collection.tombstone_patch_pages_valid = true;
        collection.tombstone_patch_page_start = start_page;
        collection.tombstone_patch_page_end_exclusive = end_page_exclusive;
        return;
    }
    if start_page < collection.tombstone_patch_page_start {
        collection.tombstone_patch_page_start = start_page;
    }
    if end_page_exclusive > collection.tombstone_patch_page_end_exclusive {
        collection.tombstone_patch_page_end_exclusive = end_page_exclusive;
    }
}

fn db_collection_page_in_tombstone_patch_pages(collection: &DbCollection, page_offset: u32) bool {
    return collection != null &&
        collection.tombstone_patch_pages_valid &&
        page_offset >= collection.tombstone_patch_page_start &&
        page_offset < collection.tombstone_patch_page_end_exclusive;
}

fn db_collection_ensure_dirty_page_capacity(collection: &DbCollection, rows: u32) !void {
    if collection == null {
        return error.DbCollectionNotFound;
    }
    const needed_words: u32 = db_collection_dirty_word_capacity(collection, rows);
    if needed_words == 0u32 {
        return;
    }
    if collection.dirty_page_bits != null && collection.dirty_page_word_capacity >= needed_words {
        return;
    }
    const new_bytes: usize = (needed_words as usize) * 8usize;
    const old_bytes: usize = (collection.dirty_page_word_capacity as usize) * 8usize;
    const allocator: &HeapAllocator = get_heap_allocator();
    var mem: &byte = null;
    if collection.dirty_page_bits == null || collection.dirty_page_word_capacity == 0u32 {
        mem = try allocator.alloc(new_bytes);
        _ = mem_set(mem, 0, new_bytes);
    } else {
        mem = try allocator.realloc(collection.dirty_page_bits as &byte, new_bytes);
        if new_bytes > old_bytes {
            if mem == null {
                return error.DbRowFull;
            }
            _ = mem_set(&mem[old_bytes], 0, new_bytes - old_bytes);
        }
    }
    collection.dirty_page_bits = mem as &u64;
    collection.dirty_page_word_capacity = needed_words;
}

fn db_collection_ensure_row_capacity_impl(collection: &DbCollection, needed: u32, zero_init: bool) !void {
    if collection == null {
        return error.DbCollectionNotFound;
    }
    if needed == 0u32 {
        return;
    }
    if needed as usize > DB_MAX_ROWS_PER_COLLECTION {
        return error.DbRowFull;
    }
    const shared_rows: bool = db_collection_rows_shared(collection);
    if collection.rows != null && collection.row_capacity >= needed && !shared_rows {
        try db_collection_ensure_rows_refcount(collection);
        return;
    }
    const new_capacity: u32 = try db_collection_next_capacity(needed);
    const new_bytes: usize = db_rows_alloc_size(new_capacity);
    const old_capacity: u32 = collection.row_capacity;
    const old_bytes: usize = db_rows_alloc_size(old_capacity);
    const allocator: &HeapAllocator = get_heap_allocator();
    var mem: &byte = null;
    if collection.rows == null || collection.row_capacity == 0u32 {
        mem = try allocator.alloc(new_bytes);
        if zero_init {
            _ = mem_set(mem, 0, new_bytes);
        }
        const ref_mem: &byte = try allocator.alloc(4usize);
        collection.rows_refcount = ref_mem as &u32;
        collection.rows_refcount[0] = 1u32;
    } else if !shared_rows {
        mem = try allocator.realloc(collection.rows as &byte, new_bytes);
        if zero_init && new_bytes > old_bytes {
            if mem == null {
                return error.DbRowFull;
            }
            _ = mem_set(&mem[old_bytes], 0, new_bytes - old_bytes);
        }
        try db_collection_ensure_rows_refcount(collection);
        collection.rows_refcount[0] = 1u32;
    } else {
        mem = try allocator.alloc(new_bytes);
        if mem == null {
            return error.DbRowFull;
        }
        _ = mem_copy(mem, collection.rows as &const byte, old_bytes);
        if zero_init && new_bytes > old_bytes {
            _ = mem_set(&mem[old_bytes], 0, new_bytes - old_bytes);
        }
        const ref_mem: &byte = try allocator.alloc(4usize);
        const previous_refcount: &u32 = collection.rows_refcount;
        previous_refcount[0] = previous_refcount[0] - 1u32;
        collection.rows_refcount = ref_mem as &u32;
        collection.rows_refcount[0] = 1u32;
    }
    collection.rows = mem as &DbStoredRow;
    collection.row_capacity = new_capacity;
    try db_collection_ensure_dirty_page_capacity(collection, new_capacity);
}

fn db_collection_ensure_row_capacity(collection: &DbCollection, needed: u32) !void {
    try db_collection_ensure_row_capacity_impl(collection, needed, true);
}

fn db_collection_ensure_row_capacity_uninit(collection: &DbCollection, needed: u32) !void {
    try db_collection_ensure_row_capacity_impl(collection, needed, false);
}

fn db_collection_release_rows(collection: &DbCollection) void {
    if collection == null {
        return;
    }
    db_collection_release_blob_chunks(collection);
    const allocator: &HeapAllocator = get_heap_allocator();
    db_collection_release_row_storage_ref(collection);
    if collection.delete_overlay_bits != null {
        allocator.dealloc(collection.delete_overlay_bits as &byte);
        collection.delete_overlay_bits = null;
    }
    collection.delete_overlay_word_capacity = 0u32;
    if collection.dirty_page_bits != null {
        allocator.dealloc(collection.dirty_page_bits as &byte);
        collection.dirty_page_bits = null;
    }
    collection.dirty_page_word_capacity = 0u32;
}

fn db_collection_delete_overlay_word_capacity(rows: u32) u32 {
    if rows == 0u32 {
        return 0u32;
    }
    return ((rows - 1u32) / 64u32) + 1u32;
}

fn db_collection_clear_delete_overlay(collection: &DbCollection) void {
    if collection == null || collection.delete_overlay_bits == null {
        if collection != null {
            collection.delete_overlay_suffix_valid = true;
            collection.delete_overlay_suffix_start = collection.row_count;
        }
        return;
    }
    _ = mem_set(
        collection.delete_overlay_bits as &byte,
        0 as byte,
        (collection.delete_overlay_word_capacity as usize) * 8usize,
    );
    collection.delete_overlay_suffix_valid = true;
    collection.delete_overlay_suffix_start = collection.row_count;
}

fn db_collection_has_delete_overlay_tombstones(collection: &DbCollection) bool {
    if collection != null &&
        collection.delete_overlay_bits != null &&
        collection.delete_overlay_suffix_valid &&
        collection.delete_overlay_suffix_start < collection.row_count {
        return true;
    }
    if collection == null || collection.delete_overlay_bits == null {
        return false;
    }
    var word_idx: usize = 0usize;
    while word_idx < collection.delete_overlay_word_capacity as usize {
        if collection.delete_overlay_bits[word_idx] != 0u64 {
            return true;
        }
        word_idx = word_idx + 1usize;
    }
    return false;
}

fn db_collection_delete_overlay_tombstone(collection: &DbCollection, row_idx: u32) bool {
    if collection != null &&
        collection.delete_overlay_bits != null &&
        collection.delete_overlay_suffix_valid &&
        row_idx >= collection.delete_overlay_suffix_start &&
        row_idx < collection.row_count {
        return true;
    }
    if collection == null || collection.delete_overlay_bits == null {
        return false;
    }
    const word_idx_u32: u32 = row_idx / 64u32;
    if word_idx_u32 >= collection.delete_overlay_word_capacity {
        return false;
    }
    const word_idx: usize = word_idx_u32 as usize;
    const bit_idx: i32 = (row_idx % 64u32) as i32;
    return (collection.delete_overlay_bits[word_idx] & (1u64 << bit_idx)) != 0u64;
}

fn db_collection_ensure_delete_overlay_capacity(collection: &DbCollection, rows: u32) !void {
    if collection == null {
        return error.DbCollectionNotFound;
    }
    const needed_words: u32 = db_collection_delete_overlay_word_capacity(rows);
    if needed_words == 0u32 {
        return;
    }
    if collection.delete_overlay_bits != null && collection.delete_overlay_word_capacity >= needed_words {
        return;
    }
    const new_bytes: usize = (needed_words as usize) * 8usize;
    const old_bytes: usize = (collection.delete_overlay_word_capacity as usize) * 8usize;
    const allocator: &HeapAllocator = get_heap_allocator();
    var mem: &byte = null;
    if collection.delete_overlay_bits == null || collection.delete_overlay_word_capacity == 0u32 {
        mem = try allocator.alloc(new_bytes);
        _ = mem_set(mem, 0 as byte, new_bytes);
    } else {
        mem = try allocator.realloc(collection.delete_overlay_bits as &byte, new_bytes);
        if new_bytes > old_bytes {
            if mem == null {
                return error.DbRowFull;
            }
            _ = mem_set(&mem[old_bytes], 0 as byte, new_bytes - old_bytes);
        }
    }
    collection.delete_overlay_bits = mem as &u64;
    collection.delete_overlay_word_capacity = needed_words;
}

fn db_collection_set_delete_overlay_tombstone(collection: &DbCollection, row_idx: u32, tombstone: bool) !void {
    if collection == null {
        return error.DbCollectionNotFound;
    }
    if tombstone {
        try db_collection_ensure_delete_overlay_capacity(collection, row_idx + 1u32);
    } else if collection.delete_overlay_bits == null {
        return;
    }
    const word_idx_u32: u32 = row_idx / 64u32;
    if word_idx_u32 >= collection.delete_overlay_word_capacity {
        return;
    }
    const word_idx: usize = word_idx_u32 as usize;
    const bit_idx: i32 = (row_idx % 64u32) as i32;
    const mask: u64 = 1u64 << bit_idx;
    if tombstone {
        collection.delete_overlay_bits[word_idx] = collection.delete_overlay_bits[word_idx] | mask;
    } else {
        collection.delete_overlay_bits[word_idx] = collection.delete_overlay_bits[word_idx] & (~mask);
    }
}

fn db_collection_fill_delete_overlay_range(collection: &DbCollection, start_row_idx: u32, end_row_idx_exclusive: u32) !void {
    if collection == null || start_row_idx >= end_row_idx_exclusive {
        return;
    }
    try db_collection_ensure_delete_overlay_capacity(collection, end_row_idx_exclusive);
    var current: u32 = start_row_idx;
    while current < end_row_idx_exclusive {
        const word_idx: usize = (current / 64u32) as usize;
        const bit_idx: u32 = current % 64u32;
        const remaining_in_word: u32 = 64u32 - bit_idx;
        var fill_count: u32 = end_row_idx_exclusive - current;
        if fill_count > remaining_in_word {
            fill_count = remaining_in_word;
        }
        var mask: u64 = 18446744073709551615u64;
        if fill_count < 64u32 {
            mask = (1u64 << (fill_count as i32)) - 1u64;
        }
        collection.delete_overlay_bits[word_idx] = collection.delete_overlay_bits[word_idx] | (mask << (bit_idx as i32));
        current = current + fill_count;
    }
}

fn db_collection_prepare_row_writes(collection: &DbCollection) !void {
    if collection == null || !db_collection_rows_shared(collection) {
        return;
    }
    var needed: u32 = collection.row_capacity;
    if needed == 0u32 {
        needed = collection.row_count;
    }
    if needed == 0u32 {
        needed = 1u32;
    }
    try db_collection_ensure_row_capacity_impl(collection, needed, false);
}

fn db_collection_clear_dirty_pages(collection: &DbCollection) void {
    if collection == null || collection.dirty_page_bits == null {
        db_collection_clear_tombstone_patch_pages(collection);
        return;
    }
    _ = mem_set(
        collection.dirty_page_bits as &byte,
        0 as byte,
        (collection.dirty_page_word_capacity as usize) * 8usize,
    );
    db_collection_clear_tombstone_patch_pages(collection);
}

fn db_collection_mark_row_dirty(collection: &DbCollection, row_idx: u32) !void {
    if collection == null {
        return error.DbCollectionNotFound;
    }
    db_collection_clear_tombstone_patch_pages(collection);
    try db_collection_ensure_dirty_page_capacity(collection, row_idx + 1u32);
    const page_idx: u32 = row_idx / (db_collection_rows_per_page(collection) as u32);
    if page_idx / 64u32 >= collection.dirty_page_word_capacity {
        return error.DbRowFull;
    }
    const word_idx: usize = (page_idx / 64u32) as usize;
    const bit_idx: i32 = (page_idx % 64u32) as i32;
    collection.dirty_page_bits[word_idx] = collection.dirty_page_bits[word_idx] | (1u64 << bit_idx);
}

fn db_row_effective_tombstone(collection: &DbCollection, row: &DbStoredRow) bool {
    return row != null &&
        row.present &&
        (row.tombstone || (collection != null && row.doc_id > 0u64 && row.doc_id <= collection.deleted_through_doc_id));
}

fn db_row_visible(collection: &DbCollection, row: &DbStoredRow) bool {
    return row != null && row.present && !db_row_effective_tombstone(collection, row);
}

fn db_row_effective_tombstone_at_slot(collection: &DbCollection, row: &DbStoredRow, row_slot: u32) bool {
    return row != null &&
        row.present &&
        (
            row.tombstone ||
            db_collection_delete_overlay_tombstone(collection, row_slot) ||
            (collection != null && row.doc_id > 0u64 && row.doc_id <= collection.deleted_through_doc_id)
        );
}

fn db_row_visible_at_slot(collection: &DbCollection, row: &DbStoredRow, row_slot: u32) bool {
    return row != null && row.present && !db_row_effective_tombstone_at_slot(collection, row, row_slot);
}

fn db_collection_page_dirty(collection: &DbCollection, page_offset: u32) bool {
    if collection == null || collection.dirty_page_bits == null {
        return false;
    }
    const page_idx: u32 = page_offset;
    if page_idx / 64u32 >= collection.dirty_page_word_capacity {
        return false;
    }
    const word_idx: usize = (page_idx / 64u32) as usize;
    const bit_idx: i32 = (page_idx % 64u32) as i32;
    return (collection.dirty_page_bits[word_idx] & (1u64 << bit_idx)) != 0u64;
}

fn db_collection_has_dirty_pages(collection: &DbCollection) bool {
    if collection == null || collection.dirty_page_bits == null {
        return false;
    }
    var word_idx: usize = 0usize;
    while word_idx < collection.dirty_page_word_capacity as usize {
        if collection.dirty_page_bits[word_idx] != 0u64 {
            return true;
        }
        word_idx = word_idx + 1usize;
    }
    return false;
}

fn db_row_at(collection: &DbCollection, row_slot: u32) !&DbStoredRow {
    if collection == null {
        return error.DbCollectionNotFound;
    }
    const idx: usize = (row_slot as! usize) catch {
        return error.DbCollectionNotFound;
    };
    if collection.rows == null || idx >= collection.row_capacity as usize || idx >= DB_MAX_ROWS_PER_COLLECTION {
        return error.DbCollectionNotFound;
    }
    return &collection.rows[idx];
}

fn db_index_name_equal(index_meta: &DbCollectionIndexMeta, name: &[const byte]) bool {
    if index_meta == null || !index_meta.present || name.ptr == null || index_meta.name_len as usize != name.len {
        return false;
    }
    var i: usize = 0usize;
    while i < name.len {
        if index_meta.name[i] != name.ptr[i] {
            return false;
        }
        i = i + 1usize;
    }
    return true;
}

fn db_index_path_equal(index_meta: &DbCollectionIndexMeta, path: &[const byte]) bool {
    if index_meta == null || !index_meta.present || path.ptr == null || index_meta.path_len as usize != path.len {
        return false;
    }
    var i: usize = 0usize;
    while i < path.len {
        if index_meta.path[i] != path.ptr[i] {
            return false;
        }
        i = i + 1usize;
    }
    return true;
}

fn db_stem_ptr(db: &DbHandle) &const byte {
    if db == null {
        return null;
    }
    return &db.stem[0] as &const byte;
}

fn db_collection_reset(collection: &DbCollection) void {
    if collection == null {
        return;
    }
    db_collection_release_blob_chunks(collection);
    if db_collection_rows_shared(collection) || collection.row_capacity > DB_COLLECTION_ROW_REUSE_MAX {
        db_collection_release_rows(collection);
    } else if collection.rows != null {
        _ = mem_set(collection.rows as &byte, 0 as byte, db_rows_alloc_size(collection.row_capacity));
        db_collection_clear_dirty_pages(collection);
        db_collection_clear_delete_overlay(collection);
    }
    collection.present = false;
    collection.collection_id = 0u32;
    collection.name_len = 0u16;
    collection.layout_flags = 0u16;
    collection.rows_per_page = 0u16;
    collection.max_doc_len_seen = 0u16;
    collection.next_doc_id = 0u64;
    collection.deleted_through_doc_id = 0u64;
    collection.primary_root_page = 0u32;
    collection.primary_index_ready = false;
    collection.rows_loaded = false;
    collection.may_have_tombstones = false;
    collection.prefix_delete_only = true;
    collection.delete_overlay_suffix_valid = true;
    collection.delete_overlay_suffix_start = 0u32;
    db_collection_clear_tombstone_patch_pages(collection);
    collection.secondary_index_count = 0u16;
    collection.blob_chunk_count = 0u16;
    collection.row_count = 0u32;
}

fn db_copy_stored_row(target: &DbStoredRow, source: &DbStoredRow) !void {
    if target == null || source == null {
        return;
    }
    db_stored_row_reset(target);
    target.present = source.present;
    target.tombstone = source.tombstone;
    target.blob_loaded = source.blob_loaded;
    target.doc_blob_owned = false;
    target.doc_id = source.doc_id;
    target.record_ptr = source.record_ptr;
    target.doc_len = source.doc_len;
    target.doc_blob = source.doc_blob;
}

fn db_copy_collection_index_meta(target: &DbCollectionIndexMeta, source: &DbCollectionIndexMeta) void {
    if target == null || source == null {
        return;
    }
    target.present = source.present;
    target.index_id = source.index_id;
    target.root_page = source.root_page;
    target.path_segment_count = source.path_segment_count;
    target.name_len = source.name_len;
    target.path_len = source.path_len;
    if source.name_len > 0u16 {
        _ = mem_copy(&target.name[0], &source.name[0], source.name_len as usize);
    }
    if source.path_len > 0u16 {
        _ = mem_copy(&target.path[0], &source.path[0], source.path_len as usize);
    }
}

fn db_copy_collection_used(target: &DbCollection, source: &DbCollection) !void {
    if target == null || source == null {
        return;
    }
    db_collection_clear_dirty_pages(target);
    target.present = source.present;
    target.collection_id = source.collection_id;
    target.name_len = source.name_len;
    target.layout_flags = source.layout_flags;
    target.rows_per_page = source.rows_per_page;
    target.max_doc_len_seen = source.max_doc_len_seen;
    target.next_doc_id = source.next_doc_id;
    target.deleted_through_doc_id = source.deleted_through_doc_id;
    target.primary_root_page = source.primary_root_page;
    target.primary_index_ready = source.primary_index_ready;
    target.rows_loaded = source.rows_loaded;
    target.may_have_tombstones = source.may_have_tombstones;
    target.prefix_delete_only = source.prefix_delete_only;
    target.delete_overlay_suffix_valid = source.delete_overlay_suffix_valid;
    target.delete_overlay_suffix_start = source.delete_overlay_suffix_start;
    target.secondary_index_count = source.secondary_index_count;
    target.blob_chunk_count = 0u16;
    target.row_count = source.row_count;
    target.rows_loaded = source.rows_loaded;
    target.rows_refcount = null;
    if source.name_len > 0u16 {
        _ = mem_copy(&target.name[0], &source.name[0], source.name_len as usize);
    }
    var index_idx: usize = 0usize;
    while index_idx < source.secondary_index_count as usize {
        db_copy_collection_index_meta(&target.secondary_indexes[index_idx], &source.secondary_indexes[index_idx]);
        index_idx = index_idx + 1usize;
    }
    if source.row_count == 0u32 || source.rows == null {
        db_collection_clear_delete_overlay(target);
        return;
    }
    if target.rows != null && target.rows != source.rows {
        db_collection_release_row_storage_ref(target);
    }
    try db_collection_ensure_rows_refcount(source);
    target.rows = source.rows;
    target.row_capacity = source.row_capacity;
    target.rows_refcount = source.rows_refcount;
    if target.rows_refcount != null {
        target.rows_refcount[0] = target.rows_refcount[0] + 1u32;
    }
    if source.delete_overlay_bits != null && source.delete_overlay_word_capacity > 0u32 {
        try db_collection_ensure_delete_overlay_capacity(target, source.row_count);
        _ = mem_copy(
            target.delete_overlay_bits as &byte,
            source.delete_overlay_bits as &const byte,
            (source.delete_overlay_word_capacity as usize) * 8usize,
        );
    } else {
        db_collection_clear_delete_overlay(target);
    }
}

fn db_transfer_collection_blob_ownership(previous: &DbCollection, staged: &DbCollection) void {
    if previous == null || staged == null || previous.blob_chunk_count == 0u16 {
        return;
    }
    var prev_idx: usize = 0usize;
    while prev_idx < previous.blob_chunk_count as usize {
        staged.blob_chunks[staged.blob_chunk_count as usize] = previous.blob_chunks[prev_idx];
        staged.blob_chunk_count = staged.blob_chunk_count + 1u16;
        db_blob_arena_chunk_reset(&previous.blob_chunks[prev_idx]);
        prev_idx = prev_idx + 1usize;
    }
    previous.blob_chunk_count = 0u16;
}

fn db_transfer_view_blob_ownership(previous_state: &CommitViewState, staged_state: &CommitViewState) void {
    if previous_state == null || staged_state == null {
        return;
    }
    var collection_count: u16 = previous_state.collection_count;
    if staged_state.collection_count < collection_count {
        collection_count = staged_state.collection_count;
    }
    var collection_idx: u16 = 0u16;
    while collection_idx < collection_count {
        db_transfer_collection_blob_ownership(
            &previous_state.collections[collection_idx as usize],
            &staged_state.collections[collection_idx as usize],
        );
        collection_idx = collection_idx + 1u16;
    }
}

fn db_query_cache_entry_reset(entry: &DbQueryCacheEntry) void {
    if entry == null {
        return;
    }
    entry.valid = false;
    entry.explain = false;
    entry.sql_len = 0u16;
    bound_select_reset(&entry.plan.bound);
    entry.plan.node_count = 0u16;
    entry.plan.root_node = -1;
}

fn db_invalidate_query_cache(db: &DbHandle) void {
    if db == null {
        return;
    }
    db.query_cache_next_slot = 0u16;
    var i: usize = 0usize;
    while i < DB_QUERY_CACHE_SLOTS {
        db_query_cache_entry_reset(&db.query_cache_entries[i]);
        i = i + 1usize;
    }
}

fn db_query_cache_sql_equal(entry: &DbQueryCacheEntry, sql: &[const byte]) bool {
    if entry == null || !entry.valid || sql.ptr == null || entry.sql_len as usize != sql.len {
        return false;
    }
    var i: usize = 0usize;
    while i < sql.len {
        if entry.sql[i] != sql.ptr[i] {
            return false;
        }
        i = i + 1usize;
    }
    return true;
}

fn db_query_cache_lookup(db: &DbHandle, sql: &[const byte]) &DbQueryCacheEntry {
    if db == null || sql.ptr == null || sql.len == 0usize || sql.len > DB_QUERY_CACHE_SQL_MAX {
        return null;
    }
    var i: usize = 0usize;
    while i < DB_QUERY_CACHE_SLOTS {
        const entry: &DbQueryCacheEntry = &db.query_cache_entries[i];
        if db_query_cache_sql_equal(entry, sql) {
            return entry;
        }
        i = i + 1usize;
    }
    return null;
}

fn db_query_cache_store(db: &DbHandle, sql: &[const byte], explain: bool, plan: &QueryPlan) void {
    if db == null || sql.ptr == null || plan == null || sql.len == 0usize || sql.len > DB_QUERY_CACHE_SQL_MAX {
        return;
    }
    var slot_idx: usize = 0usize;
    const slot_idx_u: !usize = db.query_cache_next_slot as! usize;
    if slot_idx_u.error_id == 0u32 {
        slot_idx = slot_idx_u.value;
    } else {
        db.query_cache_next_slot = 0u16;
    }
    if slot_idx >= DB_QUERY_CACHE_SLOTS {
        slot_idx = 0usize;
        db.query_cache_next_slot = 0u16;
    }
    if slot_idx >= DB_QUERY_CACHE_SLOTS {
        return;
    }
    const entry: &DbQueryCacheEntry = &db.query_cache_entries[slot_idx];
    entry.valid = true;
    entry.explain = explain;
    entry.sql_len = (sql.len as! u16) catch {
        db_query_cache_entry_reset(entry);
        return;
    };
    _ = mem_copy(&entry.sql[0], sql.ptr, sql.len);
    query_plan_copy_used(&entry.plan, plan);
    if slot_idx + 1usize >= DB_QUERY_CACHE_SLOTS {
        db.query_cache_next_slot = 0u16;
    } else {
        const next_slot_u: !u16 = (slot_idx + 1usize) as! u16;
        if next_slot_u.error_id == 0u32 {
            db.query_cache_next_slot = next_slot_u.value;
        } else {
            db.query_cache_next_slot = 0u16;
        }
    }
}

fn db_result_pool_reset(pool: &DbResultPool) void {
    if pool == null {
        return;
    }
    var i: usize = 0usize;
    while i < DB_RESULT_POOL_SMALL_SLOTS {
        pool.small_slots[i].in_use = false;
        i = i + 1usize;
    }
    i = 0usize;
    while i < DB_RESULT_POOL_MEDIUM_SLOTS {
        pool.medium_slots[i].in_use = false;
        i = i + 1usize;
    }
    i = 0usize;
    while i < DB_RESULT_POOL_LARGE_SLOTS {
        pool.large_slots[i].in_use = false;
        i = i + 1usize;
    }
}

fn db_ensure_result_pool(db: &DbHandle) !void {
    if db == null {
        return error.DbHandleInvalid;
    }
    if db.result_pool != null {
        return;
    }
    const allocator: &HeapAllocator = get_heap_allocator();
    const bytes: usize = @size_of(DbResultPool) as usize;
    const mem: &byte = try allocator.alloc(bytes);
    _ = mem_set(mem, 0, bytes);
    db.result_pool = mem as &DbResultPool;
}

fn db_ensure_wal_batch(db: &DbHandle) !void {
    if db == null {
        return error.DbHandleInvalid;
    }
    if db.wal_batch != null {
        return;
    }
    const allocator: &HeapAllocator = get_heap_allocator();
    const bytes: usize = @size_of(WalBatch) as usize;
    const mem: &byte = try allocator.alloc(bytes);
    _ = mem_set(mem, 0, bytes);
    db.wal_batch = mem as &WalBatch;
    db.wal_batch.txn_id = 0u64;
    db.wal_batch.commit_lsn = 0u64;
    db.wal_batch.record_count = 0u16;
    db.wal_batch.used_bytes = 0usize;
    db.wal_batch.capacity = WAL_BATCH_MAX_BYTES;
    db.wal_batch.bytes = null;
}

fn db_ptr_in_range(ptr: &byte, start: &byte, size: usize) bool {
    if ptr == null || start == null || size == 0usize {
        return false;
    }
    const p: usize = @usize_from_ptr(ptr as &void);
    const s: usize = @usize_from_ptr(start as &void);
    return p >= s && p < s + size;
}

fn db_result_pool_alloc(pool: &DbResultPool, size: usize) &byte {
    if pool == null || size == 0usize {
        return null;
    }
    if size <= DB_RESULT_POOL_SMALL_BYTES {
        var i: usize = 0usize;
        while i < DB_RESULT_POOL_SMALL_SLOTS {
            if !pool.small_slots[i].in_use {
                pool.small_slots[i].in_use = true;
                return &pool.small_slots[i].bytes[0];
            }
            i = i + 1usize;
        }
    }
    if size <= DB_RESULT_POOL_MEDIUM_BYTES {
        var i: usize = 0usize;
        while i < DB_RESULT_POOL_MEDIUM_SLOTS {
            if !pool.medium_slots[i].in_use {
                pool.medium_slots[i].in_use = true;
                return &pool.medium_slots[i].bytes[0];
            }
            i = i + 1usize;
        }
    }
    if size <= DB_RESULT_POOL_LARGE_BYTES {
        var i: usize = 0usize;
        while i < DB_RESULT_POOL_LARGE_SLOTS {
            if !pool.large_slots[i].in_use {
                pool.large_slots[i].in_use = true;
                return &pool.large_slots[i].bytes[0];
            }
            i = i + 1usize;
        }
    }
    return null;
}

fn db_result_pool_capacity(pool: &DbResultPool, ptr: &byte) usize {
    if pool == null || ptr == null {
        return 0usize;
    }
    var i: usize = 0usize;
    while i < DB_RESULT_POOL_SMALL_SLOTS {
        if db_ptr_in_range(ptr, &pool.small_slots[i].bytes[0], DB_RESULT_POOL_SMALL_BYTES) {
            return DB_RESULT_POOL_SMALL_BYTES;
        }
        i = i + 1usize;
    }
    i = 0usize;
    while i < DB_RESULT_POOL_MEDIUM_SLOTS {
        if db_ptr_in_range(ptr, &pool.medium_slots[i].bytes[0], DB_RESULT_POOL_MEDIUM_BYTES) {
            return DB_RESULT_POOL_MEDIUM_BYTES;
        }
        i = i + 1usize;
    }
    i = 0usize;
    while i < DB_RESULT_POOL_LARGE_SLOTS {
        if db_ptr_in_range(ptr, &pool.large_slots[i].bytes[0], DB_RESULT_POOL_LARGE_BYTES) {
            return DB_RESULT_POOL_LARGE_BYTES;
        }
        i = i + 1usize;
    }
    return 0usize;
}

fn db_result_pool_dealloc(pool: &DbResultPool, ptr: &byte) bool {
    if pool == null || ptr == null {
        return false;
    }
    var i: usize = 0usize;
    while i < DB_RESULT_POOL_SMALL_SLOTS {
        if db_ptr_in_range(ptr, &pool.small_slots[i].bytes[0], DB_RESULT_POOL_SMALL_BYTES) {
            pool.small_slots[i].in_use = false;
            return true;
        }
        i = i + 1usize;
    }
    i = 0usize;
    while i < DB_RESULT_POOL_MEDIUM_SLOTS {
        if db_ptr_in_range(ptr, &pool.medium_slots[i].bytes[0], DB_RESULT_POOL_MEDIUM_BYTES) {
            pool.medium_slots[i].in_use = false;
            return true;
        }
        i = i + 1usize;
    }
    i = 0usize;
    while i < DB_RESULT_POOL_LARGE_SLOTS {
        if db_ptr_in_range(ptr, &pool.large_slots[i].bytes[0], DB_RESULT_POOL_LARGE_BYTES) {
            pool.large_slots[i].in_use = false;
            return true;
        }
        i = i + 1usize;
    }
    return false;
}

fn db_default_snapshot_policy() SnapshotPressurePolicy {
    return SnapshotPressurePolicy{
        soft_retired_bytes: 256u64,
        hard_retired_bytes: 1024u64,
        max_retired_views: 4u32,
        cursor_lease_ms: 30000u64,
    };
}

fn db_close_pager_session(db: &DbHandle) void {
    if db == null {
        return;
    }
    pager_close_session(&db.pager_session);
}

fn doc_blob_builder_drop(builder: DocBlobBuilder) void {
    _ = builder;
}

fn doc_blob_builder_init() DocBlobBuilder {
    return DocBlobBuilder{
        active: true,
        doc_len: 0u16,
        scratch: [],
        doc_blob: [],
    };
}

fn db_json_fast_is_space(b: byte) bool {
    return b == 32 || b == 9 || b == 10 || b == 13;
}

fn db_json_fast_skip_ws(json: &[const byte], pos: usize) usize {
    var i: usize = pos;
    while i < json.len && db_json_fast_is_space(json.ptr[i]) {
        i = i + 1usize;
    }
    return i;
}

fn db_json_fast_match_keyword(json: &[const byte], pos: usize, keyword: &[const byte]) bool {
    if json.ptr == null || keyword.ptr == null || pos + keyword.len > json.len {
        return false;
    }
    var i: usize = 0usize;
    while i < keyword.len {
        if json.ptr[pos + i] != keyword.ptr[i] {
            return false;
        }
        i = i + 1usize;
    }
    return true;
}

fn db_json_fast_parse_string_view(json: &[const byte], pos_inout: &usize, out: &JsonStrView) bool {
    if json.ptr == null || pos_inout == null || out == null {
        return false;
    }
    var pos: usize = db_json_fast_skip_ws(json, pos_inout[0]);
    if pos >= json.len || json.ptr[pos] != 34 as byte {
        return false;
    }
    pos = pos + 1usize;
    const start: usize = pos;
    while pos < json.len {
        const b: byte = json.ptr[pos];
        if b == 34 as byte {
            if pos > start {
                out[0] = JsonStrView{
                    ptr: &json.ptr[start],
                    len: pos - start,
                };
            } else {
                out[0] = JsonStrView{
                    ptr: null,
                    len: 0usize,
                };
            }
            pos_inout[0] = pos + 1usize;
            return true;
        }
        if b == 92 as byte {
            return false;
        }
        pos = pos + 1usize;
    }
    return false;
}

fn db_json_fast_parse_int64(json: &[const byte], pos_inout: &usize, value_out: &i64) bool {
    if json.ptr == null || pos_inout == null || value_out == null {
        return false;
    }
    var pos: usize = db_json_fast_skip_ws(json, pos_inout[0]);
    if pos >= json.len {
        return false;
    }
    var negative: bool = false;
    if json.ptr[pos] == 45 as byte {
        negative = true;
        pos = pos + 1usize;
        if pos >= json.len {
            return false;
        }
    }
    if json.ptr[pos] < 48 as byte || json.ptr[pos] > 57 as byte {
        return false;
    }
    var magnitude: u64 = 0u64;
    while pos < json.len {
        const b: byte = json.ptr[pos];
        if b < 48 as byte || b > 57 as byte {
            break;
        }
        const digit: u64 = (b - (48 as byte)) as u64;
        if magnitude > (18446744073709551615u64 - digit) / 10u64 {
            return false;
        }
        magnitude = magnitude * 10u64 + digit;
        pos = pos + 1usize;
    }
    if pos < json.len {
        const tail: byte = json.ptr[pos];
        if tail == 46 as byte || tail == 101 as byte || tail == 69 as byte {
            return false;
        }
    }
    if negative {
        if magnitude > 9223372036854775808u64 {
            return false;
        }
        if magnitude == 9223372036854775808u64 {
            value_out[0] = -9223372036854775807i64 - 1i64;
        } else {
            value_out[0] = 0i64 - (magnitude as i64);
        }
    } else {
        if magnitude > 9223372036854775807u64 {
            return false;
        }
        value_out[0] = magnitude as i64;
    }
    pos_inout[0] = pos;
    return true;
}

fn db_json_fast_parse_primitive_value(json: &[const byte], pos_inout: &usize, out: &JsonValue) bool {
    if json.ptr == null || pos_inout == null || out == null {
        return false;
    }
    var pos: usize = db_json_fast_skip_ws(json, pos_inout[0]);
    if pos >= json.len {
        return false;
    }
    if json.ptr[pos] == 34 as byte {
        var text: JsonStrView = JsonStrView{ ptr: null, len: 0usize };
        if !db_json_fast_parse_string_view(json, &pos, &text) {
            return false;
        }
        out[0] = JsonValue.str(text);
        pos_inout[0] = pos;
        return true;
    }
    if db_json_fast_match_keyword(json, pos, &"true"[0: 4]) {
        out[0] = JsonValue.bool_val(true);
        pos_inout[0] = pos + 4usize;
        return true;
    }
    if db_json_fast_match_keyword(json, pos, &"false"[0: 5]) {
        out[0] = JsonValue.bool_val(false);
        pos_inout[0] = pos + 5usize;
        return true;
    }
    if db_json_fast_match_keyword(json, pos, &"null"[0: 4]) {
        out[0] = JsonValue.json_null();
        pos_inout[0] = pos + 4usize;
        return true;
    }
    var int_value: i64 = 0i64;
    if db_json_fast_parse_int64(json, &pos, &int_value) {
        out[0] = JsonValue.int_val(int_value);
        pos_inout[0] = pos;
        return true;
    }
    return false;
}

fn doc_blob_builder_build_json_fast(builder: &DocBlobBuilder, json: &[const byte]) !bool {
    if builder == null || !builder.active || json.ptr == null {
        return error.DbInvalidExpr;
    }
    var pos: usize = db_json_fast_skip_ws(json, 0usize);
    if pos >= json.len || json.ptr[pos] != 123 as byte {
        return false;
    }
    pos = pos + 1usize;
    var pairs: [JsonKeyValue: DB_JSON_FAST_OBJECT_MAX_FIELDS] = [];
    var count: usize = 0usize;
    pos = db_json_fast_skip_ws(json, pos);
    if pos < json.len && json.ptr[pos] == 125 as byte {
        const encoded_len: usize = try doc_encode_json_flat_object_pairs(pairs[0: 0], builder.doc_blob[0: DB_DOC_BLOB_MAX]);
        builder.doc_len = (encoded_len as! u16) catch {
            return error.DbRowTooLarge;
        };
        return true;
    }
    while true {
        if count >= DB_JSON_FAST_OBJECT_MAX_FIELDS {
            return false;
        }
        if !db_json_fast_parse_string_view(json, &pos, &pairs[count].key) {
            return false;
        }
        pos = db_json_fast_skip_ws(json, pos);
        if pos >= json.len || json.ptr[pos] != 58 as byte {
            return false;
        }
        pos = pos + 1usize;
        if !db_json_fast_parse_primitive_value(json, &pos, &pairs[count].value) {
            return false;
        }
        count = count + 1usize;
        pos = db_json_fast_skip_ws(json, pos);
        if pos >= json.len {
            return false;
        }
        if json.ptr[pos] == 44 as byte {
            pos = pos + 1usize;
            continue;
        }
        if json.ptr[pos] == 125 as byte {
            pos = pos + 1usize;
            break;
        }
        return false;
    }
    pos = db_json_fast_skip_ws(json, pos);
    if pos != json.len {
        return false;
    }
    const encoded_len: usize = try doc_encode_json_flat_object_pairs(pairs[0: count], builder.doc_blob[0: DB_DOC_BLOB_MAX]);
    builder.doc_len = (encoded_len as! u16) catch {
        return error.DbRowTooLarge;
    };
    return true;
}

fn doc_blob_builder_build_json(builder: &DocBlobBuilder, json: &[const byte]) !void {
    if builder == null || !builder.active || json.ptr == null {
        return error.DbInvalidExpr;
    }
    if try doc_blob_builder_build_json_fast(builder, json) {
        return;
    }
    var arena: Arena = Arena{ buffer: null, size: 0, used: 0 };
    arena_init(&arena, &builder.scratch[0], DB_TXN_DOC_SCRATCH_MAX);
    const value: JsonValue = try parse_lossless_numbers(&arena, json.ptr, json.len);
    const encoded_len: usize = try doc_encode_json_value(&value, builder.doc_blob[0: DB_DOC_BLOB_MAX]);
    builder.doc_len = (encoded_len as! u16) catch {
        return error.DbRowTooLarge;
    };
}

fn txn_drop(txn: Txn) void {
    if txn.active && !txn.committed && txn.db != null {
        const staged: !&CommitViewState = db_commit_view_state(txn.db, txn.view_slot);
        if staged.error_id == 0u32 {
            db_clear_commit_view_state(staged.value);
            db_refresh_snapshot_status(txn.db);
        }
        writer_lock_guard_release(&txn.writer_guard);
    }
}

fn db_collection_data_page_id(collection: &DbCollection) u32 {
    if collection == null {
        return 0u32;
    }
    if collection.primary_root_page != 0u32 {
        return collection.primary_root_page;
    }
    if collection.collection_id == 0u32 {
        return 0u32;
    }
    return nosqlite_collection_primary_root_page(collection.collection_id);
}

fn db_collection_page_count_for_rows(collection: &DbCollection, row_count: u32) u32 {
    const rows_per_page: u16 = db_collection_rows_per_page(collection);
    if row_count == 0u32 || rows_per_page == 0u16 {
        return 0u32;
    }
    return ((row_count - 1u32) / (rows_per_page as u32)) + 1u32;
}

fn db_collection_page_id_for_index(collection: &DbCollection, row_idx: u32) u32 {
    return db_collection_data_page_id(collection) + (row_idx / (db_collection_rows_per_page(collection) as u32));
}

fn db_collection_local_slot_for_index(collection: &DbCollection, row_idx: u32) u16 {
    return (row_idx % (db_collection_rows_per_page(collection) as u32)) as u16;
}

fn db_collection_first_row_for_page_offset(collection: &DbCollection, page_offset: u32) u32 {
    return page_offset * (db_collection_rows_per_page(collection) as u32);
}

fn db_collection_mark_page_dirty(collection: &DbCollection, page_offset: u32) !void {
    if collection == null {
        return error.DbCollectionNotFound;
    }
    db_collection_clear_tombstone_patch_pages(collection);
    try db_collection_ensure_dirty_page_capacity(collection, db_collection_first_row_for_page_offset(collection, page_offset) + 1u32);
    if page_offset / 64u32 >= collection.dirty_page_word_capacity {
        return error.DbRowFull;
    }
    const word_idx: usize = (page_offset / 64u32) as usize;
    const bit_idx: i32 = (page_offset % 64u32) as i32;
    collection.dirty_page_bits[word_idx] = collection.dirty_page_bits[word_idx] | (1u64 << bit_idx);
}

fn db_collection_mark_page_range_dirty(collection: &DbCollection, start_page_offset: u32, end_page_offset_exclusive: u32) !void {
    if collection == null {
        return error.DbCollectionNotFound;
    }
    if start_page_offset >= end_page_offset_exclusive {
        return;
    }
    db_collection_clear_tombstone_patch_pages(collection);
    try db_collection_ensure_dirty_page_capacity(
        collection,
        db_collection_first_row_for_page_offset(collection, end_page_offset_exclusive - 1u32) + 1u32,
    );
    var current: u32 = start_page_offset;
    while current < end_page_offset_exclusive {
        const word_idx: usize = (current / 64u32) as usize;
        const bit_idx: u32 = current % 64u32;
        const remaining_in_word: u32 = 64u32 - bit_idx;
        var fill_count: u32 = end_page_offset_exclusive - current;
        if fill_count > remaining_in_word {
            fill_count = remaining_in_word;
        }
        var mask: u64 = 18446744073709551615u64;
        if fill_count < 64u32 {
            mask = (1u64 << (fill_count as i32)) - 1u64;
        }
        collection.dirty_page_bits[word_idx] = collection.dirty_page_bits[word_idx] | (mask << (bit_idx as i32));
        current = current + fill_count;
    }
}

fn db_collection_mark_all_pages_dirty(collection: &DbCollection) !void {
    if collection == null {
        return error.DbCollectionNotFound;
    }
    const page_count: u32 = db_collection_page_count_for_rows(collection, collection.row_count);
    db_collection_clear_dirty_pages(collection);
    var page_offset: u32 = 0u32;
    while page_offset < page_count {
        try db_collection_mark_page_dirty(collection, page_offset);
        page_offset = page_offset + 1u32;
    }
}

fn db_collection_recompute_record_pointers(collection: &DbCollection) void {
    if collection == null || collection.rows == null {
        return;
    }
    var row_idx: u32 = 0u32;
    while row_idx < collection.row_count {
        const row: &DbStoredRow = &collection.rows[row_idx as usize];
        if row.present {
            row.record_ptr = record_pointer_make(
                db_collection_page_id_for_index(collection, row_idx),
                db_collection_local_slot_for_index(collection, row_idx),
            );
        }
        row_idx = row_idx + 1u32;
    }
}

fn db_collection_refresh_packed_layout(collection: &DbCollection, page_size: u32) !void {
    if !db_collection_uses_packed_layout(collection) {
        return;
    }
    const desired_rows_per_page: u16 = db_collection_compute_packed_rows_per_page(page_size, collection.max_doc_len_seen);
    if collection.rows_per_page == 0u16 {
        collection.rows_per_page = desired_rows_per_page;
        db_collection_recompute_record_pointers(collection);
        return;
    }
    if desired_rows_per_page >= collection.rows_per_page {
        return;
    }
    collection.rows_per_page = desired_rows_per_page;
    db_collection_recompute_record_pointers(collection);
    try db_collection_mark_all_pages_dirty(collection);
    collection.primary_index_ready = false;
}

fn db_record_cell_encode(row: &DbStoredRow, now_ms: u64, out: &[byte]) !usize {
    if row == null || out.ptr == null || !row.present || row.doc_len as usize > DB_DOC_BLOB_MAX {
        return error.DbRowTooLarge;
    }
    const total_len: usize = RECORD_CELL_HEADER_SIZE + row.doc_len as usize;
    if total_len > out.len {
        return error.DbRowTooLarge;
    }
    db_store_u64_le(out, RECORD_CELL_DOC_ID_OFF, row.doc_id);
    db_store_u64_le(out, RECORD_CELL_CREATED_AT_OFF, now_ms);
    db_store_u64_le(out, RECORD_CELL_UPDATED_AT_OFF, now_ms);
    db_store_u32_le(out, RECORD_CELL_DOC_LEN_OFF, row.doc_len as u32);
    if row.doc_len > 0u16 {
        if row.doc_blob == null {
            return error.DbRowTooLarge;
        }
        _ = mem_copy(&out.ptr[RECORD_CELL_HEADER_SIZE], row.doc_blob as &const byte, row.doc_len as usize);
    }
    return total_len;
}

fn db_record_cell_decode(collection: &DbCollection, cell: &[byte], row: &DbStoredRow) !void {
    if collection == null || cell.ptr == null || row == null || cell.len < RECORD_CELL_HEADER_SIZE {
        return error.DbPageCorrupt;
    }
    const doc_len: usize = db_load_u32_le(cell, RECORD_CELL_DOC_LEN_OFF) as usize;
    if RECORD_CELL_HEADER_SIZE + doc_len > cell.len || doc_len > DB_DOC_BLOB_MAX {
        return error.DbPageCorrupt;
    }
    db_stored_row_reset(row);
    row.present = true;
    row.doc_id = db_load_u64_le(cell, RECORD_CELL_DOC_ID_OFF);
    try db_collection_row_set_blob_copy(collection, row, cell[RECORD_CELL_HEADER_SIZE: doc_len]);
}

fn db_record_cell_decode_header(cell: &[byte], row: &DbStoredRow) !void {
    if cell.ptr == null || row == null || cell.len < RECORD_CELL_HEADER_SIZE {
        return error.DbPageCorrupt;
    }
    const doc_len: usize = db_load_u32_le(cell, RECORD_CELL_DOC_LEN_OFF) as usize;
    if doc_len > DB_DOC_BLOB_MAX {
        return error.DbPageCorrupt;
    }
    db_stored_row_reset(row);
    row.present = true;
    row.blob_loaded = false;
    row.doc_id = db_load_u64_le(cell, RECORD_CELL_DOC_ID_OFF);
    row.doc_len = (doc_len as! u16) catch {
        return error.DbPageCorrupt;
    };
}

fn db_collection_encode_page_range(collection: &DbCollection, page_size: u32, now_ms: u64, page_id: u32, first_row: u32, out: &[byte]) !void {
    if collection == null || out.ptr == null || !page_buffer_size_matches(out, page_size) {
        return error.DbCollectionPageMissing;
    }
    try slotted_page_init(out, PageType.DATA);
    const rows_per_page: u16 = db_collection_rows_per_page(collection);
    var local_slot: u16 = 0u16;
    while local_slot < rows_per_page {
        const row_idx: u32 = first_row + (local_slot as u32);
        if row_idx >= collection.row_count {
            break;
        }
        const row: &DbStoredRow = &collection.rows[row_idx as usize];
        if row.present {
            row.record_ptr = record_pointer_make(page_id, local_slot);
            const cell_len: usize = RECORD_CELL_HEADER_SIZE + row.doc_len as usize;
            var flags: u16 = 0u16;
            if db_row_effective_tombstone_at_slot(collection, row, row_idx) {
                flags = SLOT_FLAG_TOMBSTONE;
            }
            const cell_view: SlottedPageCellView = try slotted_page_insert_reserve_with_flags(out, cell_len, flags);
            _ = try db_record_cell_encode(row, now_ms, cell_view.ptr[0: cell_view.len]);
        }
        local_slot = local_slot + 1u16;
    }
}

fn db_collection_load_page_range(collection: &DbCollection, page_id: u32, page_offset: u32, page_buf: &[byte], load_blobs: bool) !void {
    if collection == null || page_buf.ptr == null {
        return error.DbCollectionPageMissing;
    }
    const header: &PageHeader = page_header_from_buf(page_buf);
    if header == null || header.page_type != PageType.DATA {
        return error.DbPageCorrupt;
    }
    const slot_count: u16 = slotted_page_slot_count(page_buf);
    if slot_count > db_collection_rows_per_page(collection) {
        return error.DbPageCorrupt;
    }
    const first_row: u32 = db_collection_first_row_for_page_offset(collection, page_offset);
    const loaded_row_count: u32 = first_row + (slot_count as u32);
    try db_collection_ensure_row_capacity(collection, loaded_row_count);
    if loaded_row_count > collection.row_count {
        collection.row_count = loaded_row_count;
    }
    // Page-local warmups advance the loaded prefix, but only full collection loads mark rows_loaded.
    var max_doc_id: u64 = 0u64;
    var slot_idx: u16 = 0u16;
    while slot_idx < slot_count {
        const cell: SlottedPageCellView = slotted_page_cell_view(page_buf, slot_idx) catch {
            return error.DbPageCorrupt;
        };
        const row_idx: u32 = first_row + (slot_idx as u32);
        if slot_is_used(cell.flags) {
            const row: &DbStoredRow = &collection.rows[row_idx as usize];
            if load_blobs {
                try db_record_cell_decode(collection, cell.ptr[0: cell.len], row);
            } else {
                try db_record_cell_decode_header(cell.ptr[0: cell.len], row);
            }
            _ = db_collection_update_max_doc_len(collection, row.doc_len);
            row.record_ptr = record_pointer_make(page_id, slot_idx);
            row.tombstone = slot_is_tombstone(cell.flags);
            if row.doc_id <= collection.deleted_through_doc_id {
                row.tombstone = true;
            }
            if row.tombstone {
                collection.may_have_tombstones = true;
            }
            if slot_is_tombstone(cell.flags) && row.doc_id > collection.deleted_through_doc_id {
                collection.prefix_delete_only = false;
                collection.delete_overlay_suffix_valid = false;
            }
            if row.doc_id > max_doc_id {
                max_doc_id = row.doc_id;
            }
        } else {
            db_stored_row_reset(&collection.rows[row_idx as usize]);
        }
        slot_idx = slot_idx + 1u16;
    }
    if max_doc_id != 18446744073709551615u64 && max_doc_id + 1u64 > collection.next_doc_id {
        collection.next_doc_id = max_doc_id + 1u64;
    }
}

fn db_collection_load_page(collection: &DbCollection, page_id: u32, page_buf: &[byte], load_blobs: bool) !void {
    try db_collection_load_page_range(collection, page_id, 0u32, page_buf, load_blobs);
}

fn db_ensure_collection_rows_loaded_in_view(db: &DbHandle, view_slot: u16, collection_slot: u16) !void {
    if db == null {
        return error.DbHandleInvalid;
    }
    const state: &CommitViewState = try db_commit_view_state(db, view_slot);
    const collection: &DbCollection = try db_collection_at_in_state(state, collection_slot);
    if collection.rows_loaded {
        return;
    }
    if collection.next_doc_id <= 1u64 {
        collection.row_count = 0u32;
        collection.rows_loaded = true;
        collection.primary_index_ready = false;
        return;
    }
    const expected_rows_u64: u64 = collection.next_doc_id - 1u64;
    if expected_rows_u64 > DB_MAX_ROWS_PER_COLLECTION as u64 {
        return error.DbRowFull;
    }
    const expected_rows: u32 = (expected_rows_u64 as! u32) catch {
        return error.DbRowFull;
    };
    try db_collection_ensure_row_capacity(collection, expected_rows);
    collection.row_count = 0u32;
    collection.may_have_tombstones = false;
    const page_count: u32 = db_collection_page_count_for_rows(collection, expected_rows);
    var page_offset: u32 = 0u32;
    while page_offset < page_count {
        const first_row: u32 = db_collection_first_row_for_page_offset(collection, page_offset);
        const page_id: u32 = db_collection_data_page_id(collection) + page_offset;
        if page_id < 2u32 || page_id >= db.pager_session.info.meta.page_count {
            return error.DbCollectionPageMissing;
        }
        var page_raw: [byte: 8192] = [];
        const page_buf: &[byte] = page_raw[0: db.pager_session.info.meta.page_size as usize];
        try pager_read_page_with_file(&db.pager_session.db, &db.pager_session.info, page_id, page_buf);
        try db_collection_load_page_range(collection, page_id, page_offset, page_buf, false);
        _ = first_row;
        page_offset = page_offset + 1u32;
    }
    collection.rows_loaded = true;
    collection.primary_index_ready = false;
}

fn db_collection_load_page_header_only(db: &DbHandle, collection: &DbCollection, page_id: u32, header: &PageHeader) !void {
    if db == null || collection == null || header == null || header.page_type != PageType.DATA {
        return error.DbPageCorrupt;
    }
    if header.lower < page_header_size() as u16 || header.upper < header.lower {
        return error.DbPageCorrupt;
    }
    const slot_count: u16 = (((header.lower as usize) - page_header_size()) / slot_size()) as u16;
    try db_collection_ensure_row_capacity(collection, slot_count);
    collection.row_count = slot_count as u32;
    var max_doc_id: u64 = 0u64;
    var slot_idx: u16 = 0u16;
    while slot_idx < slot_count {
        var slot_raw: [byte: 64] = [];
        try pager_read_page_bytes_with_file(
            &db.pager_session.db,
            &db.pager_session.info,
            page_id,
            page_header_size() + (slot_idx as usize) * slot_size(),
            slot_raw[0: slot_size()],
        );
        const slot: &Slot = slot_raw[0: slot_size()].ptr as &Slot;
        if slot == null || slot.off as usize + slot.len as usize > db.pager_session.info.meta.page_size as usize {
            return error.DbPageCorrupt;
        }
        const row: &DbStoredRow = &collection.rows[slot_idx as usize];
        if slot_is_used(slot.flags) {
            var cell_header: [byte: RECORD_CELL_HEADER_SIZE] = [];
            try pager_read_page_bytes_with_file(
                &db.pager_session.db,
                &db.pager_session.info,
                page_id,
                slot.off as usize,
                cell_header[0: RECORD_CELL_HEADER_SIZE],
            );
            try db_record_cell_decode_header(cell_header[0: RECORD_CELL_HEADER_SIZE], row);
            _ = db_collection_update_max_doc_len(collection, row.doc_len);
            row.record_ptr = record_pointer_make(page_id, slot_idx);
            row.tombstone = slot_is_tombstone(slot.flags);
            if row.doc_id <= collection.deleted_through_doc_id {
                row.tombstone = true;
            }
            if row.tombstone {
                collection.may_have_tombstones = true;
            }
            if slot_is_tombstone(slot.flags) && row.doc_id > collection.deleted_through_doc_id {
                collection.prefix_delete_only = false;
                collection.delete_overlay_suffix_valid = false;
            }
            if row.doc_id > max_doc_id {
                max_doc_id = row.doc_id;
            }
        } else {
            db_stored_row_reset(row);
            row.record_ptr = record_pointer_make(page_id, slot_idx);
        }
        slot_idx = slot_idx + 1u16;
    }
    if max_doc_id != 18446744073709551615u64 && max_doc_id + 1u64 > collection.next_doc_id {
        collection.next_doc_id = max_doc_id + 1u64;
    }
}

fn db_ensure_row_blob_loaded(db: &DbHandle, collection: &DbCollection, row: &DbStoredRow) !void {
    if db == null || collection == null || row == null || !row.present {
        return error.DbRowTooLarge;
    }
    if row.blob_loaded {
        return;
    }
    var raw_page: [byte: 8192] = [];
    const page_buf: &[byte] = raw_page[0: db.pager_session.info.meta.page_size as usize];
    const page_id: u32 = row.record_ptr.page_id;
    const slot_id: u16 = row.record_ptr.slot_id;
    try pager_read_page_with_file(&db.pager_session.db, &db.pager_session.info, page_id, page_buf);
    const cell: SlottedPageCellView = slotted_page_cell_view(page_buf, row.record_ptr.slot_id) catch {
        return error.DbPageCorrupt;
    };
    try db_record_cell_decode(collection, cell.ptr[0: cell.len], row);
    row.record_ptr = record_pointer_make(page_id, slot_id);
    row.tombstone = slot_is_tombstone(cell.flags) || row.doc_id <= collection.deleted_through_doc_id;
}

fn db_ensure_collection_blobs_loaded(db: &DbHandle, collection: &DbCollection) !void {
    if db == null || collection == null {
        return error.DbHandleInvalid;
    }
    var row_idx: u32 = 0u32;
    while row_idx < collection.row_count {
        const row: &DbStoredRow = &collection.rows[row_idx as usize];
        if row.present && !row.blob_loaded {
            try db_ensure_row_blob_loaded(db, collection, row);
        }
        row_idx = row_idx + 1u32;
    }
}

fn db_ensure_collection_page_blobs_loaded(db: &DbHandle, collection: &DbCollection, page_offset: u32) !void {
    if db == null || collection == null || collection.rows == null {
        return error.DbHandleInvalid;
    }
    var row_idx: u32 = db_collection_first_row_for_page_offset(collection, page_offset);
    var end_idx: u32 = row_idx + (db_collection_rows_per_page(collection) as u32);
    if end_idx > collection.row_count {
        end_idx = collection.row_count;
    }
    var need_page_reload: bool = false;
    while row_idx < end_idx {
        const row: &DbStoredRow = &collection.rows[row_idx as usize];
        if row.present && !row.blob_loaded {
            need_page_reload = true;
            break;
        }
        row_idx = row_idx + 1u32;
    }
    if !need_page_reload {
        return;
    }
    const page_id: u32 = db_collection_data_page_id(collection) + page_offset;
    if page_id < 2u32 || page_id >= db.pager_session.info.meta.page_count {
        return error.DbCollectionPageMissing;
    }
    var page_raw: [byte: 8192] = [];
    const page_buf: &[byte] = page_raw[0: db.pager_session.info.meta.page_size as usize];
    try pager_read_page_with_file(&db.pager_session.db, &db.pager_session.info, page_id, page_buf);
    try db_collection_load_page_range(collection, page_id, page_offset, page_buf, true);
}

fn db_collection_try_patch_tombstone_page_from_disk(db: &DbHandle, collection: &DbCollection, page_offset: u32, page_buf: &[byte], patched_out: &bool) !void {
    if patched_out != null {
        patched_out[0] = false;
    }
    if db == null || collection == null || page_buf.ptr == null || patched_out == null {
        return error.DbHandleInvalid;
    }
    const rows_per_page: u16 = db_collection_rows_per_page(collection);
    const first_row: u32 = db_collection_first_row_for_page_offset(collection, page_offset);
    var expected_slot_count: u16 = rows_per_page;
    if first_row >= collection.row_count {
        expected_slot_count = 0u16;
    } else {
        const remaining_rows: u32 = collection.row_count - first_row;
        if remaining_rows < rows_per_page as u32 {
            expected_slot_count = (remaining_rows as! u16) catch {
                return error.DbRowFull;
            };
        }
    }
    const base_pages_current: bool = db.pager_session.active &&
        db.pager_session.info.meta.checkpoint_lsn == db.pager_session.info.meta.commit_lsn;
    if !base_pages_current {
        var scan_row_idx: u32 = first_row;
        const end_row: u32 = first_row + (expected_slot_count as u32);
        while scan_row_idx < end_row {
            const row: &DbStoredRow = &collection.rows[scan_row_idx as usize];
            if row.present && row.blob_loaded {
                return;
            }
            scan_row_idx = scan_row_idx + 1u32;
        }
    }
    const page_id: u32 = db_collection_data_page_id(collection) + page_offset;
    if page_id < 2u32 || page_id >= db.pager_session.info.meta.page_count {
        return;
    }
    try pager_read_page_bytes_with_file(&db.pager_session.db, &db.pager_session.info, page_id, 0usize, page_buf);
    const header: &PageHeader = page_header_from_buf(page_buf);
    if header == null || header.page_type != PageType.DATA || header.lower < page_header_size() as u16 || header.upper < header.lower {
        return error.DbPageCorrupt;
    }
    const slot_count: u16 = slotted_page_slot_count(page_buf);
    if slot_count != expected_slot_count {
        return;
    }
    var slot_idx: u16 = 0u16;
    while slot_idx < slot_count {
        const row_idx: u32 = first_row + (slot_idx as u32);
        const row: &DbStoredRow = &collection.rows[row_idx as usize];
        if !row.present ||
            row.record_ptr.page_id != page_id ||
            row.record_ptr.slot_id != slot_idx {
            return;
        }
        const cell: SlottedPageCellView = slotted_page_cell_view(page_buf, slot_idx) catch {
            return error.DbPageCorrupt;
        };
        if !slot_is_used(cell.flags) ||
            cell.len < RECORD_CELL_HEADER_SIZE {
            return error.DbPageCorrupt;
        }
        const cell_doc_len_u32: u32 = db_load_u32_le(cell.ptr[0: cell.len], RECORD_CELL_DOC_LEN_OFF);
        const cell_doc_len: usize = (cell_doc_len_u32 as! usize) catch {
            return error.DbPageCorrupt;
        };
        if cell.len != RECORD_CELL_HEADER_SIZE + cell_doc_len ||
            db_load_u64_le(cell.ptr[0: cell.len], RECORD_CELL_DOC_ID_OFF) != row.doc_id ||
            cell_doc_len != row.doc_len as usize {
            return;
        }
        const expected_tombstone: bool = db_row_effective_tombstone_at_slot(collection, row, row_idx);
        if slot_is_tombstone(cell.flags) != expected_tombstone {
            try slotted_page_set_slot_tombstone(page_buf, slot_idx, expected_tombstone);
        }
        slot_idx = slot_idx + 1u16;
    }
    patched_out[0] = true;
}

fn db_materialize_matched_rows_for_cursor(db: &DbHandle, view_slot: u16, collection_slot: u16, match_rows: &[u32], match_count: u16) !void {
    if db == null || match_rows.ptr == null {
        return error.DbHandleInvalid;
    }
    const state: &CommitViewState = try db_commit_view_state(db, view_slot);
    const collection: &DbCollection = try db_collection_at_in_state(state, collection_slot);
    var i: u16 = 0u16;
    while i < match_count {
        const row_slot: u32 = match_rows.ptr[i as usize];
        const row_idx: usize = (row_slot as! usize) catch {
            return error.DbCollectionNotFound;
        };
        if collection.rows == null || row_idx >= collection.row_capacity as usize || row_idx >= DB_MAX_ROWS_PER_COLLECTION {
            return error.DbCollectionNotFound;
        }
        if row_slot >= collection.row_count {
            return error.DbCollectionNotFound;
        }
        const row: &DbStoredRow = &collection.rows[row_idx];
        if db_row_visible_at_slot(collection, row, row_slot) && !row.blob_loaded {
            const page_offset: u32 = row_slot / (db_collection_rows_per_page(collection) as u32);
            try db_ensure_collection_page_blobs_loaded(db, collection, page_offset);
        }
        i = i + 1u16;
    }
}

fn db_release_view_loaded_blobs(state: &CommitViewState) void {
    if state == null || !state.present {
        return;
    }
    var collection_idx: u16 = 0u16;
    while collection_idx < state.collection_count {
        db_collection_release_loaded_blobs(&state.collections[collection_idx as usize]);
        collection_idx = collection_idx + 1u16;
    }
}

fn db_rebuild_primary_index(db: &DbHandle, collection_slot: u16) !void {
    if db == null || collection_slot as usize >= DB_MAX_COLLECTIONS {
        return error.DbCollectionNotFound;
    }
    const slot_idx: usize = (collection_slot as! usize) catch {
        return error.DbCollectionNotFound;
    };
    if slot_idx >= DB_MAX_COLLECTIONS {
        return error.DbCollectionNotFound;
    }
    try db_ensure_collection_rows_loaded_in_view(db, db.current_view_slot, collection_slot);
    try primary_btree_reset(&db.primary_indexes[slot_idx], db_effective_page_size(db));
    const state: &CommitViewState = try db_current_view_state(db);
    const collection: &DbCollection = &state.collections[slot_idx];
    var row_idx: u32 = 0u32;
    while row_idx < collection.row_count {
        const row: &DbStoredRow = &collection.rows[row_idx as usize];
        if db_row_visible_at_slot(collection, row, row_idx) {
            try primary_btree_insert(&db.primary_indexes[slot_idx], row.doc_id, &row.record_ptr);
        }
        row_idx = row_idx + 1u32;
    }
    collection.primary_index_ready = true;
}

fn db_ensure_primary_index(db: &DbHandle, collection_slot: u16) !void {
    const state: &CommitViewState = try db_current_view_state(db);
    const collection: &DbCollection = try db_collection_at_in_state(state, collection_slot);
    if !collection.primary_index_ready {
        try db_rebuild_primary_index(db, collection_slot);
    }
}

fn db_try_apply_primary_index_delta(db: &DbHandle, collection_slot: u16, previous: &DbCollection, staged: &DbCollection) !bool {
    if db == null || previous == null || staged == null {
        return error.DbCollectionNotFound;
    }
    const slot_idx: usize = (collection_slot as! usize) catch {
        return error.DbCollectionNotFound;
    };
    if slot_idx >= DB_MAX_COLLECTIONS {
        return error.DbCollectionNotFound;
    }
    if previous.secondary_index_count != 0u16 || staged.secondary_index_count != 0u16 {
        return false;
    }

    var row_idx: u32 = 0u32;
    var max_row_count: u32 = staged.row_count;
    if previous.row_count > max_row_count {
        max_row_count = previous.row_count;
    }
    while row_idx < max_row_count {
        var prev_visible: bool = false;
        var staged_visible: bool = false;
        var prev_row: &DbStoredRow = null;
        var staged_row: &DbStoredRow = null;
        if row_idx < previous.row_count {
            prev_row = &previous.rows[row_idx as usize];
            prev_visible = db_row_visible_at_slot(previous, prev_row, row_idx);
        }
        if row_idx < staged.row_count {
            staged_row = &staged.rows[row_idx as usize];
            staged_visible = db_row_visible_at_slot(staged, staged_row, row_idx);
        }
        if prev_visible {
            if !staged_visible {
                return false;
            }
            if prev_row.doc_id != staged_row.doc_id {
                return false;
            }
        } else if staged_visible {
            try primary_btree_insert(&db.primary_indexes[slot_idx], staged_row.doc_id, &staged_row.record_ptr);
        }
        row_idx = row_idx + 1u32;
    }
    return true;
}

fn db_refresh_indexes_after_commit(db: &DbHandle, previous_state: &CommitViewState, collection_count: u16) !void {
    if db == null || previous_state == null {
        return error.DbCollectionNotFound;
    }
    const staged_state: &CommitViewState = try db_current_view_state(db);
    var i: u16 = 0u16;
    while i < collection_count {
        const previous: &DbCollection = &previous_state.collections[i as usize];
        const staged: &DbCollection = &staged_state.collections[i as usize];
        if staged.present {
            if staged.primary_index_ready {
                const applied: bool = try db_try_apply_primary_index_delta(db, i, previous, staged);
                if !applied {
                    try db_rebuild_primary_index(db, i);
                }
            }
            if staged.secondary_index_count != 0u16 {
                try db_rebuild_secondary_indexes(db, i);
            }
        }
        i = i + 1u16;
    }
}

fn db_collection_secondary_index_meta(collection: &DbCollection, index_slot: u16) !&DbCollectionIndexMeta {
    if collection == null {
        return error.DbCollectionNotFound;
    }
    const idx: usize = (index_slot as! usize) catch {
        return error.DbCollectionNotFound;
    };
    if idx >= DB_MAX_SECONDARY_INDEXES_PER_COLLECTION || index_slot >= collection.secondary_index_count {
        return error.DbCollectionNotFound;
    }
    if idx >= DB_MAX_SECONDARY_INDEXES_PER_COLLECTION {
        return error.DbCollectionNotFound;
    }
    return &collection.secondary_indexes[idx];
}

fn db_secondary_index_compare_rows(collection: &DbCollection, index_state: &DbSecondaryIndexState, left_slot: u32, right_slot: u32) !i32 {
    const left_row: &DbStoredRow = try db_row_at(collection, left_slot);
    const right_row: &DbStoredRow = try db_row_at(collection, right_slot);
    const left_node: &[byte] = (path_program_eval(&index_state.path_program, try db_row_blob(left_row)) catch {
        return 0 - 1;
    });
    const right_node: &[byte] = (path_program_eval(&index_state.path_program, try db_row_blob(right_row)) catch {
        return 1;
    });
    const cmp: i32 = try doc_compare_scalar_nodes(left_node, right_node);
    if cmp != 0 {
        return cmp;
    }
    if left_row.doc_id < right_row.doc_id {
        return 0 - 1;
    }
    if left_row.doc_id > right_row.doc_id {
        return 1;
    }
    return 0;
}

fn db_rebuild_secondary_index(db: &DbHandle, collection_slot: u16, index_slot: u16) !void {
    try db_ensure_collection_rows_loaded_in_view(db, db.current_view_slot, collection_slot);
    const state: &CommitViewState = try db_current_view_state(db);
    const collection_idx: usize = (collection_slot as! usize) catch {
        return error.DbCollectionNotFound;
    };
    if collection_idx >= DB_MAX_COLLECTIONS {
        return error.DbCollectionNotFound;
    }
    const collection: &DbCollection = &state.collections[collection_idx];
    try db_ensure_collection_blobs_loaded(db, collection);
    const meta: &DbCollectionIndexMeta = try db_collection_secondary_index_meta(collection, index_slot);
    const index_state: &DbSecondaryIndexState = try db_secondary_index_state(db, collection_slot, index_slot);
    db_secondary_index_state_reset(index_state);
    index_state.present = meta.present;
    index_state.index_id = meta.index_id;
    index_state.name_len = meta.name_len;
    index_state.path_len = meta.path_len;
    if meta.name_len > 0u16 {
        _ = mem_copy(&index_state.name[0], &meta.name[0], meta.name_len as usize);
    }
    if meta.path_len > 0u16 {
        _ = mem_copy(&index_state.path[0], &meta.path[0], meta.path_len as usize);
    }
    index_state.path_program = try path_program_compile(index_state.path[0: index_state.path_len as usize]);

    var row_idx: u32 = 0u32;
    while row_idx < collection.row_count {
        const row: &DbStoredRow = &collection.rows[row_idx as usize];
        if db_row_visible_at_slot(collection, row, row_idx) {
            const node_union: !&[byte] = path_program_eval(&index_state.path_program, try db_row_blob(row));
            if node_union.error_id == 0u32 {
                const node: &[byte] = node_union.value;
                const tag: DocNodeTag = try doc_node_tag(node);
                if tag == DocNodeTag.NULL ||
                    tag == DocNodeTag.FALSE ||
                    tag == DocNodeTag.TRUE ||
                    tag == DocNodeTag.INT64 ||
                    tag == DocNodeTag.NUMBER_TEXT ||
                    tag == DocNodeTag.STRING {
                    try db_secondary_index_ensure_row_capacity(index_state, index_state.row_count + 1u32);
                    index_state.row_slots[index_state.row_count as usize] = row_idx;
                    index_state.row_count = index_state.row_count + 1u32;
                }
            }
        }
        row_idx = row_idx + 1u32;
    }

    var i: u32 = 1u32;
    while i < index_state.row_count {
        const current: u32 = index_state.row_slots[i as usize];
        var j: usize = i as usize;
        while j > 0usize {
            const prev: u32 = index_state.row_slots[j - 1usize];
            const cmp: i32 = try db_secondary_index_compare_rows(collection, index_state, prev, current);
            if cmp <= 0 {
                break;
            }
            index_state.row_slots[j] = prev;
            j = j - 1usize;
        }
        index_state.row_slots[j] = current;
        i = i + 1u32;
    }
}

fn db_rebuild_secondary_indexes(db: &DbHandle, collection_slot: u16) !void {
    const state: &CommitViewState = try db_current_view_state(db);
    const collection: &DbCollection = try db_collection_at_in_state(state, collection_slot);
    var index_slot: u16 = 0u16;
    while index_slot < DB_MAX_SECONDARY_INDEXES_PER_COLLECTION as u16 {
        const index_state: &DbSecondaryIndexState = try db_secondary_index_state(db, collection_slot, index_slot);
        db_secondary_index_state_reset(index_state);
        index_slot = index_slot + 1u16;
    }
    index_slot = 0u16;
    while index_slot < collection.secondary_index_count {
        try db_rebuild_secondary_index(db, collection_slot, index_slot);
        index_slot = index_slot + 1u16;
    }
}

fn db_ensure_secondary_index(db: &DbHandle, collection_slot: u16, index_slot: u16) !void {
    const index_state: &DbSecondaryIndexState = try db_secondary_index_state(db, collection_slot, index_slot);
    if !index_state.present {
        try db_rebuild_secondary_index(db, collection_slot, index_slot);
    }
}

fn db_reload_from_disk(db: &DbHandle) !void {
    if db == null {
        return error.DbHandleInvalid;
    }
    db_invalidate_query_cache(db);
    db_close_pager_session(db);
    db.pager_session = try pager_open_session_at_stem(db_stem_ptr(db));
    const info: PagerOpenInfo = db.pager_session.info;
    var catalog_raw: [byte: 8192] = [];
    const catalog_page: &[byte] = catalog_raw[0: info.meta.page_size as usize];
    try pager_read_page_with_file(&db.pager_session.db, &info, info.meta.catalog_root, catalog_page);
    const view: CatalogView = try catalog_view_from_page(catalog_page);
    var i: usize = 0usize;
    while i < DB_MAX_COMMIT_VIEWS {
        db_clear_commit_view_state(&db.commit_views[i]);
        i = i + 1usize;
    }
    var index_slot: usize = 0usize;
    while index_slot < DB_MAX_COLLECTIONS * DB_MAX_SECONDARY_INDEXES_PER_COLLECTION {
        db_secondary_index_state_reset(&db.secondary_indexes[index_slot]);
        index_slot = index_slot + 1usize;
    }
    const current: &CommitViewState = &db.commit_views[0usize];
    current.present = true;
    current.retired = false;
    current.reader_pins = 0u32;
    current.view = CommitView{
        generation: info.meta.commit_lsn + 1u64,
        commit_lsn: info.meta.commit_lsn,
        catalog_root: info.meta.catalog_root,
        page_count: info.meta.page_count,
        freelist_head: info.meta.freelist_head,
        page_table_gen: info.meta.commit_lsn + 1u64,
    };
    var collection_idx: u32 = 0u32;
    while collection_idx < view.root.collection_count {
        const entry: CatalogCollectionView = try catalog_collection_at(&view, collection_idx);
        const slot: usize = (collection_idx as! usize) catch {
            return error.DbCollectionFull;
        };
        if slot >= DB_MAX_COLLECTIONS {
            return error.DbCollectionFull;
        }
        db_collection_reset(&current.collections[slot]);
        current.collections[slot].present = true;
        current.collections[slot].collection_id = entry.meta.collection_id;
        current.collections[slot].layout_flags = entry.meta.flags;
        current.collections[slot].rows_per_page = entry.meta.rsv;
        db_collection_meta_unpack_next_doc_id(entry.meta.next_doc_id, &current.collections[slot].next_doc_id, &current.collections[slot].deleted_through_doc_id);
        current.collections[slot].primary_root_page = entry.meta.primary_root_page;
        current.collections[slot].secondary_index_count = entry.meta.secondary_index_count;
        current.collections[slot].prefix_delete_only = true;
        try db_copy_name(entry.name, current.collections[slot].name[0: 64], &current.collections[slot].name_len);
        var collection_index_idx: u32 = 0u32;
        while collection_index_idx < entry.meta.secondary_index_count {
            const index_view: CatalogIndexView = try catalog_collection_index_at(&view, &entry, collection_index_idx);
            const index_slot_usize: usize = (collection_index_idx as! usize) catch {
                return error.DbCollectionFull;
            };
            if index_slot_usize >= DB_MAX_SECONDARY_INDEXES_PER_COLLECTION {
                return error.DbCollectionFull;
            }
            current.collections[slot].secondary_indexes[index_slot_usize].present = true;
            current.collections[slot].secondary_indexes[index_slot_usize].index_id = index_view.meta.index_id;
            current.collections[slot].secondary_indexes[index_slot_usize].root_page = index_view.meta.root_page;
            current.collections[slot].secondary_indexes[index_slot_usize].path_segment_count = index_view.meta.path_segment_count;
            try db_copy_name(index_view.name, current.collections[slot].secondary_indexes[index_slot_usize].name[0: 64], &current.collections[slot].secondary_indexes[index_slot_usize].name_len);
            try db_copy_path(index_view.path, current.collections[slot].secondary_indexes[index_slot_usize].path[0: 128], &current.collections[slot].secondary_indexes[index_slot_usize].path_len);
            collection_index_idx = collection_index_idx + 1u32;
        }
        current.collections[slot].rows_loaded = false;
        current.collections[slot].row_count = 0u16;
        current.collections[slot].primary_index_ready = false;
        collection_idx = collection_idx + 1u32;
    }
    current.collection_count = (view.root.collection_count as! u16) catch {
        return error.DbCollectionFull;
    };
    db.current_view_slot = 0u16;
    db.next_view_generation = current.view.generation + 1u64;
    db.next_page_table_gen = current.view.page_table_gen + 1u64;
    db_refresh_snapshot_status(db);
}

fn db_check_meta_state_valid(meta: &MetaPage) bool {
    return meta != null &&
        meta.page_count >= 3u32 &&
        meta.catalog_root >= 2u32 &&
        meta.catalog_root < meta.page_count &&
        meta.checkpoint_lsn <= meta.commit_lsn;
}

fn db_check_validate_collection_rows(collection: &DbCollection, expected_next_doc_id: u64, row_count_out: &u32) !void {
    if collection == null || row_count_out == null {
        return error.DbPageCorrupt;
    }
    var tree: PrimaryBTree = primary_btree_init(256u32) catch {
        return error.DbPageCorrupt;
    };
    var max_doc_id: u64 = 0u64;
    var row_idx: u32 = 0u32;
    while row_idx < collection.row_count {
        const row: &DbStoredRow = &collection.rows[row_idx as usize];
        if !row.present ||
            row.record_ptr.page_id != db_collection_page_id_for_index(collection, row_idx) ||
            row.record_ptr.slot_id != db_collection_local_slot_for_index(collection, row_idx) {
            return error.DbPageCorrupt;
        }
        const blob: &[byte] = db_row_blob(row) catch {
            return error.DbPageCorrupt;
        };
        _ = doc_node_tag(blob) catch {
            return error.DbPageCorrupt;
        };
        if row.doc_id > max_doc_id {
            max_doc_id = row.doc_id;
        }
        if db_row_visible_at_slot(collection, row, row_idx) {
            _ = primary_btree_insert(&tree, row.doc_id, &row.record_ptr) catch {
                return error.DbPageCorrupt;
            };
            const found: RecordPointer = primary_btree_lookup(&tree, row.doc_id) catch {
                return error.DbPageCorrupt;
            };
            if found.page_id != row.record_ptr.page_id || found.slot_id != row.record_ptr.slot_id {
                return error.DbPageCorrupt;
            }
            row_count_out[0] = row_count_out[0] + 1u32;
        }
        row_idx = row_idx + 1u32;
    }
    _ = expected_next_doc_id;
    _ = max_doc_id;
}

fn db_check_collection_at_stem(stem: &const byte, page_size: u32, entry: &CatalogCollectionView, row_count_out: &u32) !void {
    if stem == null || entry == null || row_count_out == null {
        return error.DbPageCorrupt;
    }
    if entry.meta.primary_root_page < 2u32 {
        return error.DbCollectionPageMissing;
    }

    var collection: DbCollection = DbCollection{
        present: true,
        collection_id: entry.meta.collection_id,
        name_len: 0u16,
        name: [],
        layout_flags: entry.meta.flags,
        rows_per_page: entry.meta.rsv,
        max_doc_len_seen: 0u16,
        next_doc_id: 0u64,
        deleted_through_doc_id: 0u64,
        primary_root_page: entry.meta.primary_root_page,
        primary_index_ready: false,
        rows_loaded: false,
        may_have_tombstones: false,
        prefix_delete_only: true,
        secondary_index_count: 0u16,
        secondary_indexes: [],
        blob_chunk_count: 0u16,
        blob_chunks: [],
        row_count: 0u32,
        row_capacity: 0u32,
        rows_refcount: null,
        delete_overlay_suffix_valid: true,
        delete_overlay_suffix_start: 0u32,
        delete_overlay_word_capacity: 0u32,
        delete_overlay_bits: null,
        dirty_page_word_capacity: 0u32,
        tombstone_patch_pages_valid: false,
        tombstone_patch_page_start: 0u32,
        tombstone_patch_page_end_exclusive: 0u32,
        dirty_page_bits: null,
        rows: null,
    };
    db_collection_meta_unpack_next_doc_id(entry.meta.next_doc_id, &collection.next_doc_id, &collection.deleted_through_doc_id);
    try db_copy_name(entry.name, collection.name[0: 64], &collection.name_len);
    if collection.next_doc_id > 1u64 {
        const expected_rows_u64: u64 = collection.next_doc_id - 1u64;
        if expected_rows_u64 > DB_MAX_ROWS_PER_COLLECTION as u64 {
            return error.DbRowFull;
        }
        const expected_rows: u32 = (expected_rows_u64 as! u32) catch {
            return error.DbRowFull;
        };
        try db_collection_ensure_row_capacity(&collection, expected_rows);
        const page_count: u32 = db_collection_page_count_for_rows(&collection, expected_rows);
        var page_offset: u32 = 0u32;
        while page_offset < page_count {
            const page_id: u32 = entry.meta.primary_root_page + page_offset;
            var raw_page: [byte: 8192] = [];
            const page_buf: &[byte] = raw_page[0: page_size as usize];
            try pager_read_page_at_stem(stem, page_id, page_buf);
            try db_collection_load_page_range(&collection, page_id, page_offset, page_buf, true);
            page_offset = page_offset + 1u32;
        }
    }
    try db_check_validate_collection_rows(&collection, collection.next_doc_id, row_count_out);
}

fn db_zero_commit_view() CommitView {
    return CommitView{
        generation: 0u64,
        commit_lsn: 0u64,
        catalog_root: 0u32,
        page_count: 0u32,
        freelist_head: 0u32,
        page_table_gen: 0u64,
    };
}

fn db_clear_commit_view_state(state: &CommitViewState) void {
    if state == null {
        return;
    }
    var collection_idx: u16 = 0u16;
    while collection_idx < DB_MAX_COLLECTIONS as u16 {
        db_collection_reset(&state.collections[collection_idx as usize]);
        collection_idx = collection_idx + 1u16;
    }
    state.present = false;
    state.retired = false;
    state.reader_pins = 0u32;
    state.retained_bytes = 0u64;
    state.view = db_zero_commit_view();
    state.collection_count = 0u16;
}

fn db_commit_view_state(db: &DbHandle, view_slot: u16) !&CommitViewState {
    if db == null {
        return error.DbHandleInvalid;
    }
    const view_idx: usize = (view_slot as! usize) catch {
        return error.DbHandleInvalid;
    };
    if view_idx >= DB_MAX_COMMIT_VIEWS {
        return error.DbHandleInvalid;
    }
    const state: &CommitViewState = &db.commit_views[view_idx];
    if !state.present {
        return error.DbHandleInvalid;
    }
    return state;
}

fn db_current_view_state(db: &DbHandle) !&CommitViewState {
    if db == null {
        return error.DbHandleInvalid;
    }
    return db_commit_view_state(db, db.current_view_slot);
}

fn db_effective_snapshot_status(db: &DbHandle) SnapshotPressureStatus {
    if db != null && db.snapshot_status_override_enabled {
        return db.snapshot_status_override;
    }
    if db == null {
        return SnapshotPressureStatus{
            retired_bytes: 0u64,
            retired_views: 0u32,
        };
    }
    return db.snapshot_status;
}

fn db_compute_view_page_count(state: &CommitViewState) u32 {
    if state == null || !state.present {
        return 0u32;
    }
    var total: u32 = 0u32;
    var i: u16 = 0u16;
    while i < state.collection_count {
        if state.collections[i as usize].present {
            total = total + state.collections[i as usize].row_count as u32;
        }
        i = i + 1u16;
    }
    return total;
}

fn db_compute_view_retained_bytes(state: &CommitViewState) u64 {
    if state == null || !state.present {
        return 0u64;
    }
    var total: u64 = DB_VIEW_BASE_RETAINED_BYTES;
    var i: u16 = 0u16;
    while i < state.collection_count {
        const collection: &DbCollection = &state.collections[i as usize];
        if collection.present {
            total = total + DB_COLLECTION_RETAINED_BYTES;
            total = total + (collection.row_count as u64) * DB_ROW_RETAINED_BYTES;
            var chunk_idx: u16 = 0u16;
            while chunk_idx < collection.blob_chunk_count {
                total = total + collection.blob_chunks[chunk_idx as usize].used as u64;
                chunk_idx = chunk_idx + 1u16;
            }
        }
        i = i + 1u16;
    }
    return total;
}

fn db_finalize_view_state(state: &CommitViewState) void {
    if state == null || !state.present {
        return;
    }
    state.retained_bytes = db_compute_view_retained_bytes(state);
}

fn db_refresh_snapshot_status(db: &DbHandle) void {
    if db == null {
        return;
    }
    var retired_bytes: u64 = 0u64;
    var retired_views: u32 = 0u32;
    var i: usize = 0usize;
    while i < DB_MAX_COMMIT_VIEWS {
        const state: &CommitViewState = &db.commit_views[i];
        if state.present && state.retired {
            retired_views = retired_views + 1u32;
            retired_bytes = retired_bytes + state.retained_bytes;
        }
        i = i + 1usize;
    }
    db.snapshot_status = SnapshotPressureStatus{
        retired_bytes: retired_bytes,
        retired_views: retired_views,
    };
}

fn db_cleanup_retired_views(db: &DbHandle) void {
    if db == null {
        return;
    }
    var i: usize = 0usize;
    while i < DB_MAX_COMMIT_VIEWS {
        const state: &CommitViewState = &db.commit_views[i];
        if state.present && state.retired && state.reader_pins == 0u32 {
            db_clear_commit_view_state(state);
        }
        i = i + 1usize;
    }
    db_refresh_snapshot_status(db);
}

fn db_allocate_view_slot(db: &DbHandle) !u16 {
    if db == null {
        return error.DbHandleInvalid;
    }
    db_cleanup_retired_views(db);
    var i: usize = 0usize;
    while i < DB_MAX_COMMIT_VIEWS {
        if !db.commit_views[i].present {
            return (i as! u16) catch {
                return error.SnapshotPressure;
            };
        }
        i = i + 1usize;
    }
    return error.SnapshotPressure;
}

fn db_stage_view_from_current(db: &DbHandle) !u16 {
    if db == null {
        return error.DbHandleInvalid;
    }
    db_cleanup_retired_views(db);
    const effective_status: SnapshotPressureStatus = db_effective_snapshot_status(db);
    try snapshot_pressure_require_write_ok(&db.snapshot_policy, &effective_status);
    const source: &CommitViewState = try db_current_view_state(db);
    const new_slot: u16 = try db_allocate_view_slot(db);
    const new_idx: usize = (new_slot as! usize) catch {
        return error.SnapshotPressure;
    };
    if new_idx >= DB_MAX_COMMIT_VIEWS {
        return error.SnapshotPressure;
    }
    const target: &CommitViewState = &db.commit_views[new_idx];
    db_clear_commit_view_state(target);
    target.present = true;
    target.retired = false;
    target.reader_pins = 0u32;
    target.retained_bytes = 0u64;
    target.view = CommitView{
        generation: db.next_view_generation,
        commit_lsn: db.next_view_generation,
        catalog_root: source.view.catalog_root,
        page_count: source.view.page_count,
        freelist_head: source.view.freelist_head,
        page_table_gen: db.next_page_table_gen,
    };
    target.collection_count = source.collection_count;
    var i: u16 = 0u16;
    while i < source.collection_count {
        try db_copy_collection_used(&target.collections[i as usize], &source.collections[i as usize]);
        i = i + 1u16;
    }
    return new_slot;
}

fn db_publish_view_slot(db: &DbHandle, new_slot: u16) !void {
    if db == null {
        return error.DbHandleInvalid;
    }
    db_invalidate_query_cache(db);
    const new_state: &CommitViewState = try db_commit_view_state(db, new_slot);
    db_finalize_view_state(new_state);
    const old_slot: u16 = db.current_view_slot;
    db.current_view_slot = new_slot;
    if (old_slot as usize) < DB_MAX_COMMIT_VIEWS {
        const old_state: &CommitViewState = &db.commit_views[old_slot as usize];
        if old_state.present {
            old_state.retired = true;
        }
    }
    db.next_view_generation = db.next_view_generation + 1u64;
    db.next_page_table_gen = db.next_page_table_gen + 1u64;
}

fn db_find_collection_slot_by_id_in_view(db: &DbHandle, view_slot: u16, collection_id: u32) !u16 {
    const state: &CommitViewState = try db_commit_view_state(db, view_slot);
    var i: u16 = 0u16;
    while i < state.collection_count {
        if state.collections[i as usize].present && state.collections[i as usize].collection_id == collection_id {
            return i;
        }
        i = i + 1u16;
    }
    return error.DbCollectionNotFound;
}

fn db_find_collection_slot_by_name_in_view(db: &DbHandle, view_slot: u16, name: &[const byte]) !u16 {
    if db == null || name.ptr == null {
        return error.DbCollectionNotFound;
    }
    const state: &CommitViewState = try db_commit_view_state(db, view_slot);
    var i: u16 = 0u16;
    while i < state.collection_count {
        const col: &DbCollection = &state.collections[i as usize];
        if col.present && col.name_len as usize == name.len {
            var same: bool = true;
            var j: usize = 0usize;
            while j < name.len {
                if col.name[j] != name.ptr[j] {
                    same = false;
                    break;
                }
                j = j + 1usize;
            }
            if same {
                return i;
            }
        }
        i = i + 1u16;
    }
    return error.DbCollectionNotFound;
}

fn db_find_collection_slot_by_id(db: &DbHandle, collection_id: u32) !u16 {
    if db == null {
        return error.DbHandleInvalid;
    }
    return db_find_collection_slot_by_id_in_view(db, db.current_view_slot, collection_id);
}

fn db_find_collection_slot_by_name(db: &DbHandle, name: &[const byte]) !u16 {
    if db == null {
        return error.DbCollectionNotFound;
    }
    return db_find_collection_slot_by_name_in_view(db, db.current_view_slot, name);
}

fn db_row_blob(row: &DbStoredRow) !&[byte] {
    if row == null || !row.present || row.tombstone || !row.blob_loaded || row.doc_len as usize > DB_DOC_BLOB_MAX {
        return error.DbRowTooLarge;
    }
    if row.doc_len == 0u16 {
        return ""[0: 0];
    }
    if row.doc_blob == null {
        return error.DbRowTooLarge;
    }
    return row.doc_blob[0: row.doc_len as usize];
}

fn db_collection_release_loaded_blobs(collection: &DbCollection) void {
    if collection == null || collection.rows == null {
        return;
    }
    var row_idx: u32 = 0u32;
    while row_idx < collection.row_count {
        const row: &DbStoredRow = &collection.rows[row_idx as usize];
        if row.present && row.blob_loaded && row.doc_blob != null {
            row.doc_blob = null;
            row.blob_loaded = false;
            row.doc_blob_owned = false;
        }
        row_idx = row_idx + 1u32;
    }
    db_collection_release_blob_chunks(collection);
}

fn db_collection_row_ref(db: &DbHandle, view_slot: u16, collection_slot: u16, row_slot: u32) !RowRef {
    if db == null || collection_slot as usize >= DB_MAX_COLLECTIONS {
        return error.DbCollectionNotFound;
    }
    const state: &CommitViewState = try db_commit_view_state(db, view_slot);
    const collection_idx: usize = (collection_slot as! usize) catch {
        return error.DbCollectionNotFound;
    };
    if collection_idx >= DB_MAX_COLLECTIONS {
        return error.DbCollectionNotFound;
    }
    const collection: &DbCollection = &state.collections[collection_idx];
    if !collection.present || collection.rows == null || row_slot >= collection.row_count || row_slot as usize >= collection.row_capacity as usize || row_slot as usize >= DB_MAX_ROWS_PER_COLLECTION {
        return error.DbCollectionNotFound;
    }
    const row_idx: usize = (row_slot as! usize) catch {
        return error.DbCollectionNotFound;
    };
    if row_idx >= collection.row_capacity as usize || row_idx >= DB_MAX_ROWS_PER_COLLECTION {
        return error.DbCollectionNotFound;
    }
    const row: &DbStoredRow = &collection.rows[row_idx];
    if db_row_effective_tombstone_at_slot(collection, row, row_slot) {
        return error.DbCollectionNotFound;
    }
    if !row.blob_loaded && state.retired {
        return error.DbPageCorrupt;
    }
    try db_ensure_row_blob_loaded(db, collection, row);
    return RowRef{
        doc_id: row.doc_id,
        record_ptr: row.record_ptr,
        doc_blob: try db_row_blob(row),
    };
}

fn db_pin_current_view_slot(db: &DbHandle) !u16 {
    const state: &CommitViewState = try db_current_view_state(db);
    state.reader_pins = state.reader_pins + 1u32;
    return db.current_view_slot;
}

fn db_unpin_view_slot(db: &DbHandle, view_slot: u16) void {
    if db == null {
        return;
    }
    const view_idx: usize = (view_slot as! usize) catch {
        return;
    };
    if view_idx >= DB_MAX_COMMIT_VIEWS {
        return;
    }
    const state: &CommitViewState = &db.commit_views[view_idx];
    if state.present && state.reader_pins > 0u32 {
        state.reader_pins = state.reader_pins - 1u32;
    }
    db_cleanup_retired_views(db);
}

fn commit_view_pin_release(pin: &CommitViewPin) void {
    if pin == null || !pin.held {
        return;
    }
    if pin.release_counter != null {
        pin.release_counter[0] = pin.release_counter[0] + 1;
    }
    db_unpin_view_slot(pin.db, pin.view_slot);
    pin.held = false;
}

fn commit_view_pin_drop(pin: CommitViewPin) void {
    if !pin.held {
        return;
    }
    if pin.release_counter != null {
        pin.release_counter[0] = pin.release_counter[0] + 1;
    }
    db_unpin_view_slot(pin.db, pin.view_slot);
}

export fn commit_view_pin_is_held(pin: &CommitViewPin) bool {
    return pin != null && pin.held;
}

fn query_cursor_drop(cursor: QueryCursor) void {
    if cursor.release_counter != null && (cursor.has_current || cursor.pin.held) {
        cursor.release_counter[0] = cursor.release_counter[0] + 1;
    }
}

export fn query_cursor_is_open(cursor: &QueryCursor) bool {
    return cursor != null && commit_view_pin_is_held(&cursor.pin);
}

export fn query_cursor_commit_view(cursor: &QueryCursor) CommitView {
    if cursor == null {
        return db_zero_commit_view();
    }
    return cursor.pin.view;
}

fn exec_copy_text(text: &[const byte], out: &[byte], len_out: &u16) !void {
    if text.ptr == null || out.ptr == null || len_out == null || text.len > 2048usize {
        return error.DbResultTooLarge;
    }
    len_out[0] = (text.len as! u16) catch {
        return error.DbResultTooLarge;
    };
    if text.len > 0 {
        _ = mem_copy(out.ptr, text.ptr, text.len);
    }
}

fn exec_value_from_literal(literal: &BoundLiteral) !ExecValue {
    if literal == null {
        return error.DbInvalidExpr;
    }
    var out: ExecValue = ExecValue{
        kind: ExecValueKind.NULL,
        bool_value: false,
        i64_value: 0i64,
        u64_value: 0u64,
        text_len: 0u16,
        text: [],
        doc_node: &""[0: 0],
    };
    if literal.kind == BoundLiteralKind.NULL {
        out.kind = ExecValueKind.NULL;
        return out;
    }
    if literal.kind == BoundLiteralKind.BOOL {
        out.kind = ExecValueKind.BOOL;
        out.bool_value = literal.bool_value;
        return out;
    }
    if literal.kind == BoundLiteralKind.INT64 {
        out.kind = ExecValueKind.INT64;
        out.i64_value = literal.i64_value;
        return out;
    }
    if literal.kind == BoundLiteralKind.UINT64 {
        out.kind = ExecValueKind.UINT64;
        out.u64_value = literal.u64_value;
        return out;
    }
    if literal.kind == BoundLiteralKind.NUMBER_TEXT {
        out.kind = ExecValueKind.NUMBER_TEXT;
        out.text_len = literal.text_len;
        if literal.text_len > 0u16 {
            _ = mem_copy(&out.text[0], &literal.text[0], literal.text_len as usize);
        }
        return out;
    }
    out.kind = ExecValueKind.STRING;
    out.text_len = literal.text_len;
    if literal.text_len > 0u16 {
        _ = mem_copy(&out.text[0], &literal.text[0], literal.text_len as usize);
    }
    return out;
}

fn exec_encode_u64_text(value: u64, out: &[byte]) !usize {
    var digits: [byte: 32] = [];
    var tmp: u64 = value;
    var len: usize = 0usize;
    if tmp == 0u64 {
        digits[0] = 48 as byte;
        len = 1usize;
    } else {
        while tmp > 0u64 {
            if len >= @len(digits) {
                return error.DbResultTooLarge;
            }
            digits[len] = ((48u64 + (tmp % 10u64)) as! byte).value;
            len = len + 1usize;
            tmp = tmp / 10u64;
        }
    }
    if out.ptr == null || len > out.len {
        return error.DbResultTooLarge;
    }
    var i: usize = 0usize;
    while len > 0usize {
        len = len - 1usize;
        out.ptr[i] = digits[len];
        i = i + 1usize;
    }
    return i;
}

fn exec_value_encode_doc(value: &ExecValue, out: &[byte]) !usize {
    if value == null || out.ptr == null {
        return error.DbInvalidExpr;
    }
    if value.kind == ExecValueKind.DOC_NODE {
        if value.doc_node.len > out.len {
            return error.DbResultTooLarge;
        }
        if value.doc_node.len > 0 {
            _ = mem_copy(out.ptr, value.doc_node.ptr, value.doc_node.len);
        }
        return value.doc_node.len;
    }
    if value.kind == ExecValueKind.INT64 {
        return try doc_encode_int64_node(value.i64_value, out);
    }
    if value.kind == ExecValueKind.NUMBER_TEXT {
        return try doc_encode_number_text_node(value.text[0: value.text_len as usize], out);
    }
    if value.kind == ExecValueKind.STRING {
        return try doc_encode_string_node(value.text[0: value.text_len as usize], out);
    }
    if value.kind == ExecValueKind.UINT64 {
        if value.u64_value <= 9223372036854775807u64 {
            return try doc_encode_int64_node(value.u64_value as i64, out);
        }
        var text_buf: [byte: 32] = [];
        const text_len: usize = try exec_encode_u64_text(value.u64_value, text_buf[0: 32]);
        return try doc_encode_number_text_node(text_buf[0: text_len], out);
    }
    if value.kind == ExecValueKind.BOOL {
        const bool_value: JsonValue = JsonValue.bool_val(value.bool_value);
        return try doc_encode_json_value(&bool_value, out);
    }
    const null_value: JsonValue = JsonValue.json_null();
    return try doc_encode_json_value(&null_value, out);
}

fn exec_compare_doc_id_literal(doc_id: u64, literal: &BoundLiteral) !i32 {
    if literal == null {
        return error.DbInvalidExpr;
    }
    if literal.kind == BoundLiteralKind.UINT64 {
        if doc_id < literal.u64_value {
            return 0 - 1;
        }
        if doc_id > literal.u64_value {
            return 1;
        }
        return 0;
    }
    if literal.kind == BoundLiteralKind.INT64 {
        if literal.i64_value < 0i64 {
            return 1;
        }
        const rhs: u64 = (literal.i64_value as! u64) catch {
            return error.DbInvalidExpr;
        };
        if doc_id < rhs {
            return 0 - 1;
        }
        if doc_id > rhs {
            return 1;
        }
        return 0;
    }
    if literal.kind == BoundLiteralKind.NUMBER_TEXT {
        var left_text: [byte: 32] = [];
        const left_len: usize = try exec_encode_u64_text(doc_id, left_text[0: 32]);
        return try doc_compare_number_lexemes(left_text[0: left_len], literal.text[0: literal.text_len as usize]);
    }
    return error.DbInvalidExpr;
}

struct DbDocIdRangeMatch {
    matched: bool,
    unsat: bool,
    has_lower: bool,
    lower_doc_id: u64,
    has_upper: bool,
    upper_doc_id: u64,
}

fn db_doc_id_range_no_match() DbDocIdRangeMatch {
    return DbDocIdRangeMatch{
        matched: false,
        unsat: false,
        has_lower: false,
        lower_doc_id: 0u64,
        has_upper: false,
        upper_doc_id: 0u64,
    };
}

fn db_doc_id_range_update_lower(range: &DbDocIdRangeMatch, lower_doc_id: u64) void {
    if range == null {
        return;
    }
    if !range.has_lower || lower_doc_id > range.lower_doc_id {
        range.has_lower = true;
        range.lower_doc_id = lower_doc_id;
    }
    if range.has_upper && range.lower_doc_id > range.upper_doc_id {
        range.unsat = true;
    }
}

fn db_doc_id_range_update_upper(range: &DbDocIdRangeMatch, upper_doc_id: u64) void {
    if range == null {
        return;
    }
    if !range.has_upper || upper_doc_id < range.upper_doc_id {
        range.has_upper = true;
        range.upper_doc_id = upper_doc_id;
    }
    if range.has_lower && range.lower_doc_id > range.upper_doc_id {
        range.unsat = true;
    }
}

fn db_doc_id_literal_bound(literal: &BoundLiteral, negative_out: &bool, value_out: &u64) bool {
    if literal == null || negative_out == null || value_out == null {
        return false;
    }
    negative_out[0] = false;
    value_out[0] = 0u64;
    if literal.kind == BoundLiteralKind.UINT64 {
        value_out[0] = literal.u64_value;
        return true;
    }
    if literal.kind == BoundLiteralKind.INT64 {
        if literal.i64_value < 0i64 {
            negative_out[0] = true;
            return true;
        }
        value_out[0] = (literal.i64_value as! u64).value;
        return true;
    }
    return false;
}

fn db_doc_id_range_apply_comparison(range: &DbDocIdRangeMatch, op: SqlBinaryOp, literal: &BoundLiteral) bool {
    if range == null || literal == null {
        return false;
    }
    var negative: bool = false;
    var value: u64 = 0u64;
    if !db_doc_id_literal_bound(literal, &negative, &value) {
        return false;
    }
    if negative {
        if op == SqlBinaryOp.EQ || op == SqlBinaryOp.LT || op == SqlBinaryOp.LE {
            range.unsat = true;
            return true;
        }
        if op == SqlBinaryOp.GT || op == SqlBinaryOp.GE {
            return true;
        }
        return false;
    }
    if op == SqlBinaryOp.EQ {
        if value == 0u64 {
            range.unsat = true;
            return true;
        }
        db_doc_id_range_update_lower(range, value);
        db_doc_id_range_update_upper(range, value);
        return true;
    }
    if op == SqlBinaryOp.GE {
        if value <= 1u64 {
            db_doc_id_range_update_lower(range, 1u64);
        } else {
            db_doc_id_range_update_lower(range, value);
        }
        return true;
    }
    if op == SqlBinaryOp.GT {
        if value == 18446744073709551615u64 {
            range.unsat = true;
            return true;
        }
        if value == 0u64 {
            db_doc_id_range_update_lower(range, 1u64);
        } else {
            db_doc_id_range_update_lower(range, value + 1u64);
        }
        return true;
    }
    if op == SqlBinaryOp.LE {
        if value == 0u64 {
            range.unsat = true;
            return true;
        }
        db_doc_id_range_update_upper(range, value);
        return true;
    }
    if op == SqlBinaryOp.LT {
        if value <= 1u64 {
            range.unsat = true;
            return true;
        }
        db_doc_id_range_update_upper(range, value - 1u64);
        return true;
    }
    return false;
}

fn db_doc_id_range_accumulate_expr(bound: &BoundSelect, expr_index: i16, range: &DbDocIdRangeMatch) !bool {
    if bound == null || range == null || expr_index < 0i16 {
        return false;
    }
    const expr: &BoundExprNode = try bound_expr_node(bound, expr_index);
    if expr.kind != BoundExprKind.BINARY {
        return false;
    }
    if expr.binary_op == SqlBinaryOp.AND {
        const left_ok: bool = try db_doc_id_range_accumulate_expr(bound, expr.left, range);
        if !left_ok {
            return false;
        }
        return try db_doc_id_range_accumulate_expr(bound, expr.right, range);
    }
    const left: &BoundExprNode = try bound_expr_node(bound, expr.left);
    const right: &BoundExprNode = try bound_expr_node(bound, expr.right);
    if left.kind == BoundExprKind.SYSTEM_ID && right.kind == BoundExprKind.LITERAL {
        return db_doc_id_range_apply_comparison(range, expr.binary_op, &right.literal);
    }
    if right.kind == BoundExprKind.SYSTEM_ID && left.kind == BoundExprKind.LITERAL {
        if expr.binary_op == SqlBinaryOp.LT {
            return db_doc_id_range_apply_comparison(range, SqlBinaryOp.GT, &left.literal);
        }
        if expr.binary_op == SqlBinaryOp.LE {
            return db_doc_id_range_apply_comparison(range, SqlBinaryOp.GE, &left.literal);
        }
        if expr.binary_op == SqlBinaryOp.GT {
            return db_doc_id_range_apply_comparison(range, SqlBinaryOp.LT, &left.literal);
        }
        if expr.binary_op == SqlBinaryOp.GE {
            return db_doc_id_range_apply_comparison(range, SqlBinaryOp.LE, &left.literal);
        }
        return db_doc_id_range_apply_comparison(range, expr.binary_op, &left.literal);
    }
    return false;
}

fn db_doc_id_range_extract(bound: &BoundSelect, expr_index: i16) !DbDocIdRangeMatch {
    if bound == null || expr_index < 0i16 {
        return db_doc_id_range_no_match();
    }
    var range: DbDocIdRangeMatch = db_doc_id_range_no_match();
    if !(try db_doc_id_range_accumulate_expr(bound, expr_index, &range)) {
        return db_doc_id_range_no_match();
    }
    range.matched = true;
    if !range.has_lower {
        db_doc_id_range_update_lower(&range, 1u64);
    }
    return range;
}

fn db_collection_has_dense_doc_id_slots(collection: &DbCollection) bool {
    if collection == null {
        return false;
    }
    return collection.next_doc_id == collection.row_count as u64 + 1u64;
}

fn db_doc_id_range_dense_slot_window(collection: &DbCollection, range: &DbDocIdRangeMatch, matched_out: &bool, start_slot_out: &u32, end_slot_exclusive_out: &u32) !void {
    if matched_out != null {
        matched_out[0] = false;
    }
    if start_slot_out != null {
        start_slot_out[0] = 0u32;
    }
    if end_slot_exclusive_out != null {
        end_slot_exclusive_out[0] = 0u32;
    }
    if collection == null || range == null || matched_out == null || start_slot_out == null || end_slot_exclusive_out == null {
        return;
    }
    if !range.matched || !db_collection_has_dense_doc_id_slots(collection) {
        return;
    }
    matched_out[0] = true;
    if range.unsat || collection.next_doc_id <= 1u64 {
        return;
    }
    var start_doc_id: u64 = 1u64;
    if range.has_lower && range.lower_doc_id > start_doc_id {
        start_doc_id = range.lower_doc_id;
    }
    var end_doc_id_exclusive: u64 = collection.next_doc_id;
    if range.has_upper && range.upper_doc_id != 18446744073709551615u64 {
        const candidate_end: u64 = range.upper_doc_id + 1u64;
        if candidate_end < end_doc_id_exclusive {
            end_doc_id_exclusive = candidate_end;
        }
    }
    if start_doc_id >= end_doc_id_exclusive {
        return;
    }
    start_slot_out[0] = ((start_doc_id - 1u64) as! u32).value;
    end_slot_exclusive_out[0] = ((end_doc_id_exclusive - 1u64) as! u32).value;
}

fn exec_compare_values(left: &ExecValue, right: &ExecValue) !i32 {
    var left_buf: [byte: 4096] = [];
    var right_buf: [byte: 4096] = [];
    const left_len: usize = try exec_value_encode_doc(left, left_buf[0: 4096]);
    const right_len: usize = try exec_value_encode_doc(right, right_buf[0: 4096]);
    return try doc_compare_scalar_nodes(left_buf[0: left_len], right_buf[0: right_len]);
}

fn db_bound_literal_encode_doc(bound: &BoundSelect, expr_index: i16, out: &[byte], len_out: &usize) !bool {
    if bound == null || out.ptr == null || len_out == null || expr_index < 0i16 {
        return false;
    }
    const expr: &BoundExprNode = try bound_expr_node(bound, expr_index);
    if expr.kind != BoundExprKind.LITERAL {
        return false;
    }
    const value: ExecValue = try exec_value_from_literal(&expr.literal);
    len_out[0] = try exec_value_encode_doc(&value, out);
    return true;
}

fn db_eval_value(db: &DbHandle, bound: &BoundSelect, row: &RowRef, expr_index: i16) !ExecValue {
    const expr: &BoundExprNode = try bound_expr_node(bound, expr_index);
    if expr.kind == BoundExprKind.SYSTEM_ID {
        return ExecValue{
            kind: ExecValueKind.UINT64,
            bool_value: false,
            i64_value: 0i64,
            u64_value: row.doc_id,
            text_len: 0u16,
            text: [],
            doc_node: &""[0: 0],
        };
    }
    if expr.kind == BoundExprKind.PATH {
        const node: &[byte] = (path_program_eval(&expr.path.program, row.doc_blob) catch {
            return error.DbPathError;
        });
        return ExecValue{
            kind: ExecValueKind.DOC_NODE,
            bool_value: false,
            i64_value: 0i64,
            u64_value: 0u64,
            text_len: 0u16,
            text: [],
            doc_node: node,
        };
    }
    if expr.kind == BoundExprKind.LITERAL {
        return try exec_value_from_literal(&expr.literal);
    }
    if expr.kind == BoundExprKind.UNARY {
        const child: ExecValue = try db_eval_value(db, bound, row, expr.left);
        if expr.unary_op == SqlUnaryOp.NOT {
            const result: bool = (try db_eval_predicate(db, bound, row, expr.left)) == false;
            return ExecValue{
                kind: ExecValueKind.BOOL,
                bool_value: result,
                i64_value: 0i64,
                u64_value: 0u64,
                text_len: 0u16,
                text: [],
                doc_node: &""[0: 0],
            };
        }
        if child.kind == ExecValueKind.INT64 {
            return ExecValue{
                kind: ExecValueKind.INT64,
                bool_value: false,
                i64_value: 0i64 - child.i64_value,
                u64_value: 0u64,
                text_len: 0u16,
                text: [],
                doc_node: &""[0: 0],
            };
        }
        if child.kind == ExecValueKind.UINT64 {
            return ExecValue{
                kind: ExecValueKind.INT64,
                bool_value: false,
                i64_value: 0i64 - child.u64_value as i64,
                u64_value: 0u64,
                text_len: 0u16,
                text: [],
                doc_node: &""[0: 0],
            };
        }
        return error.DbInvalidExpr;
    }
    if expr.kind == BoundExprKind.IS_NULL {
        const result_union: !ExecValue = db_eval_value(db, bound, row, expr.left);
        if result_union.error_id != 0u32 {
            if result_union.error_id == @error_id(error.DbPathError) {
                return ExecValue{
                    kind: ExecValueKind.BOOL,
                    bool_value: true,
                    i64_value: 0i64,
                    u64_value: 0u64,
                    text_len: 0u16,
                    text: [],
                    doc_node: &""[0: 0],
                };
            }
            return error.DbInvalidExpr;
        }
        const result: ExecValue = result_union.value;
        return ExecValue{
            kind: ExecValueKind.BOOL,
            bool_value: result.kind == ExecValueKind.NULL,
            i64_value: 0i64,
            u64_value: 0u64,
            text_len: 0u16,
            text: [],
            doc_node: &""[0: 0],
        };
    }
    if expr.kind == BoundExprKind.BINARY {
        if expr.binary_op == SqlBinaryOp.AND || expr.binary_op == SqlBinaryOp.OR {
            const left_bool: bool = try db_eval_predicate(db, bound, row, expr.left);
            if expr.binary_op == SqlBinaryOp.AND {
                if !left_bool {
                    return ExecValue{
                        kind: ExecValueKind.BOOL,
                        bool_value: false,
                        i64_value: 0i64,
                        u64_value: 0u64,
                        text_len: 0u16,
                        text: [],
                        doc_node: &""[0: 0],
                    };
                }
                const right_bool: bool = try db_eval_predicate(db, bound, row, expr.right);
                return ExecValue{
                    kind: ExecValueKind.BOOL,
                    bool_value: right_bool,
                    i64_value: 0i64,
                    u64_value: 0u64,
                    text_len: 0u16,
                    text: [],
                    doc_node: &""[0: 0],
                };
            }
            if left_bool {
                return ExecValue{
                    kind: ExecValueKind.BOOL,
                    bool_value: true,
                    i64_value: 0i64,
                    u64_value: 0u64,
                    text_len: 0u16,
                    text: [],
                    doc_node: &""[0: 0],
                };
            }
            const right_bool: bool = try db_eval_predicate(db, bound, row, expr.right);
            return ExecValue{
                kind: ExecValueKind.BOOL,
                bool_value: right_bool,
                i64_value: 0i64,
                u64_value: 0u64,
                text_len: 0u16,
                text: [],
                doc_node: &""[0: 0],
            };
        }
        const left_node: &BoundExprNode = try bound_expr_node(bound, expr.left);
        const right_node: &BoundExprNode = try bound_expr_node(bound, expr.right);
        var cmp: i32 = 0;
        if left_node.kind == BoundExprKind.SYSTEM_ID && right_node.kind == BoundExprKind.LITERAL {
            cmp = try exec_compare_doc_id_literal(row.doc_id, &right_node.literal);
        } else if right_node.kind == BoundExprKind.SYSTEM_ID && left_node.kind == BoundExprKind.LITERAL {
            cmp = 0 - (try exec_compare_doc_id_literal(row.doc_id, &left_node.literal));
        } else {
            const left_value: ExecValue = try db_eval_value(db, bound, row, expr.left);
            const right_value: ExecValue = try db_eval_value(db, bound, row, expr.right);
            cmp = try exec_compare_values(&left_value, &right_value);
        }
        var ok: bool = false;
        if expr.binary_op == SqlBinaryOp.EQ {
            ok = cmp == 0;
        } else if expr.binary_op == SqlBinaryOp.NE {
            ok = cmp != 0;
        } else if expr.binary_op == SqlBinaryOp.LT {
            ok = cmp < 0;
        } else if expr.binary_op == SqlBinaryOp.LE {
            ok = cmp <= 0;
        } else if expr.binary_op == SqlBinaryOp.GT {
            ok = cmp > 0;
        } else if expr.binary_op == SqlBinaryOp.GE {
            ok = cmp >= 0;
        }
        return ExecValue{
            kind: ExecValueKind.BOOL,
            bool_value: ok,
            i64_value: 0i64,
            u64_value: 0u64,
            text_len: 0u16,
            text: [],
            doc_node: &""[0: 0],
        };
    }
    return error.DbInvalidExpr;
}

fn db_eval_predicate(db: &DbHandle, bound: &BoundSelect, row: &RowRef, expr_index: i16) !bool {
    const value: ExecValue = try db_eval_value(db, bound, row, expr_index);
    if value.kind != ExecValueKind.BOOL {
        return error.DbInvalidExpr;
    }
    return value.bool_value;
}

fn db_exec_value_null() ExecValue {
    return ExecValue{
        kind: ExecValueKind.NULL,
        bool_value: false,
        i64_value: 0i64,
        u64_value: 0u64,
        text_len: 0u16,
        text: [],
        doc_node: &""[0: 0],
    };
}

fn db_eval_sort_value(db: &DbHandle, bound: &BoundSelect, row: &RowRef, expr_index: i16) !ExecValue {
    const value_union: !ExecValue = db_eval_value(db, bound, row, expr_index);
    if value_union.error_id != 0u32 {
        if value_union.error_id == @error_id(error.DbPathError) {
            return db_exec_value_null();
        }
        return error.DbInvalidExpr;
    }
    return value_union.value;
}

fn db_compare_rows_for_sort(db: &DbHandle, bound: &BoundSelect, view_slot: u16, collection_slot: u16, left_slot: u16, right_slot: u16, order_expr: i16, order_desc: bool) !i32 {
    const left_row: RowRef = try db_collection_row_ref(db, view_slot, collection_slot, left_slot);
    const right_row: RowRef = try db_collection_row_ref(db, view_slot, collection_slot, right_slot);
    const left_value: ExecValue = try db_eval_sort_value(db, bound, &left_row, order_expr);
    const right_value: ExecValue = try db_eval_sort_value(db, bound, &right_row, order_expr);
    const cmp: i32 = try exec_compare_values(&left_value, &right_value);
    if cmp < 0 {
        if order_desc {
            return 1;
        }
        return 0 - 1;
    }
    if cmp > 0 {
        if order_desc {
            return 0 - 1;
        }
        return 1;
    }
    if left_row.doc_id < right_row.doc_id {
        return 0 - 1;
    }
    if left_row.doc_id > right_row.doc_id {
        return 1;
    }
    return 0;
}

fn db_result_cell_append(row: &OwnedRow, cursor: &usize, kind: ResultCellKind, payload: &[byte]) !void {
    const total: usize = RESULT_CELL_HEADER_SIZE + payload.len;
    if row == null || cursor == null || cursor[0] + total > OWNED_ROW_MAX_BLOB {
        return error.DbResultTooLarge;
    }
    db_store_u16_le(row.result_blob[0: OWNED_ROW_MAX_BLOB], cursor[0], kind as u16);
    db_store_u16_le(row.result_blob[0: OWNED_ROW_MAX_BLOB], cursor[0] + 2usize, (payload.len as! u16) catch {
        return error.DbResultTooLarge;
    });
    cursor[0] = cursor[0] + RESULT_CELL_HEADER_SIZE;
    if payload.len > 0 {
        _ = mem_copy(&row.result_blob[cursor[0]], payload.ptr, payload.len);
    }
    cursor[0] = cursor[0] + payload.len;
}

fn db_build_single_text_result_with_allocator(text: &[const byte], allocator: IAllocator) !QueryResult {
    const row_bytes: usize = (@size_of(OwnedRow) as! usize).value;
    const row_mem: !&byte = allocator.alloc(row_bytes);
    if row_mem.error_id != 0u32 {
        return error.DbResultTooLarge;
    }
    const mem: &byte = row_mem.value;
    const row: &OwnedRow = mem as &OwnedRow;
    row.result_len = 0u16;
    var cursor: usize = RESULT_BLOB_HEADER_SIZE;
    db_store_u16_le(row.result_blob[0: OWNED_ROW_MAX_BLOB], 0usize, 1u16);
    try db_result_cell_append(row, &cursor, ResultCellKind.STRING, text as &[byte]);
    row.result_len = (cursor as! u16) catch {
        allocator.dealloc(mem);
        return error.DbResultTooLarge;
    };
    return QueryResult{
        allocator: allocator,
        column_count: 1u16,
        row_count: 1u32,
        rows: row,
    };
}

fn db_project_doc_node(row: &OwnedRow, cursor: &usize, node: &[byte]) !void {
    const tag: DocNodeTag = try doc_node_tag(node);
    if tag == DocNodeTag.NULL {
        try db_result_cell_append(row, cursor, ResultCellKind.NULL, &""[0: 0]);
        return;
    }
    if tag == DocNodeTag.TRUE || tag == DocNodeTag.FALSE {
        var b: [byte: 1] = [];
        if try doc_bool_value(node) {
            b[0] = 1 as byte;
        } else {
            b[0] = 0 as byte;
        }
        try db_result_cell_append(row, cursor, ResultCellKind.BOOL, b[0: 1]);
        return;
    }
    if tag == DocNodeTag.INT64 {
        var buf: [byte: 8] = [];
        db_store_u64_le(buf[0: 8], 0usize, (try doc_int64_value(node)) as u64);
        try db_result_cell_append(row, cursor, ResultCellKind.INT64, buf[0: 8]);
        return;
    }
    if tag == DocNodeTag.NUMBER_TEXT {
        try db_result_cell_append(row, cursor, ResultCellKind.NUMBER_TEXT, try doc_number_text_lexeme_view(node));
        return;
    }
    if tag == DocNodeTag.STRING {
        try db_result_cell_append(row, cursor, ResultCellKind.STRING, try doc_string_view(node));
        return;
    }
    return error.DbScalarExpected;
}

fn db_project_exec_value(row: &OwnedRow, cursor: &usize, value: &ExecValue) !void {
    if value == null {
        return error.DbInvalidProjection;
    }
    if value.kind == ExecValueKind.NULL {
        try db_result_cell_append(row, cursor, ResultCellKind.NULL, &""[0: 0]);
        return;
    }
    if value.kind == ExecValueKind.BOOL {
        var b: [byte: 1] = [];
        if value.bool_value {
            b[0] = 1 as byte;
        } else {
            b[0] = 0 as byte;
        }
        try db_result_cell_append(row, cursor, ResultCellKind.BOOL, b[0: 1]);
        return;
    }
    if value.kind == ExecValueKind.INT64 {
        var buf: [byte: 8] = [];
        db_store_u64_le(buf[0: 8], 0usize, value.i64_value as u64);
        try db_result_cell_append(row, cursor, ResultCellKind.INT64, buf[0: 8]);
        return;
    }
    if value.kind == ExecValueKind.UINT64 {
        var buf: [byte: 8] = [];
        db_store_u64_le(buf[0: 8], 0usize, value.u64_value);
        try db_result_cell_append(row, cursor, ResultCellKind.UINT64, buf[0: 8]);
        return;
    }
    if value.kind == ExecValueKind.NUMBER_TEXT {
        try db_result_cell_append(row, cursor, ResultCellKind.NUMBER_TEXT, value.text[0: value.text_len as usize]);
        return;
    }
    if value.kind == ExecValueKind.STRING {
        try db_result_cell_append(row, cursor, ResultCellKind.STRING, value.text[0: value.text_len as usize]);
        return;
    }
    try db_project_doc_node(row, cursor, value.doc_node);
}

fn db_project_expr(bound: &BoundSelect, rowref: &RowRef, out_row: &OwnedRow, cursor: &usize, expr_index: i16) !void {
    const expr: &BoundExprNode = try bound_expr_node(bound, expr_index);
    if expr.kind == BoundExprKind.SYSTEM_ID {
        var buf: [byte: 8] = [];
        db_store_u64_le(buf[0: 8], 0usize, rowref.doc_id);
        try db_result_cell_append(out_row, cursor, ResultCellKind.UINT64, buf[0: 8]);
        return;
    }
    if expr.kind == BoundExprKind.PATH {
        const node: &[byte] = (path_program_eval(&expr.path.program, rowref.doc_blob) catch {
            return error.DbPathError;
        });
        try db_project_doc_node(out_row, cursor, node);
        return;
    }
    const value: ExecValue = try db_eval_value(null, bound, rowref, expr_index);
    try db_project_exec_value(out_row, cursor, &value);
}

fn db_project_row(bound: &BoundSelect, rowref: &RowRef, out_row: &OwnedRow) !void {
    if bound == null || rowref == null || out_row == null {
        return error.DbInvalidProjection;
    }
    out_row.result_len = 0u16;
    var cursor: usize = RESULT_BLOB_HEADER_SIZE;
    db_store_u16_le(out_row.result_blob[0: OWNED_ROW_MAX_BLOB], 0usize, bound.projection_count);
    var i: usize = 0usize;
    while i < bound.projection_count as usize {
        try db_project_expr(bound, rowref, out_row, &cursor, bound.projection_exprs[i]);
        i = i + 1usize;
    }
    out_row.result_len = (cursor as! u16) catch {
        return error.DbResultTooLarge;
    };
}

fn db_identifier_bytes(identifier: &SqlIdentifier) !&[byte] {
    if identifier == null || identifier.len as usize > SQL_MAX_IDENTIFIER_LEN {
        return error.DbInvalidExpr;
    }
    return identifier.bytes[0: identifier.len as usize];
}

fn db_literal_text_bytes(literal: &SqlLiteral) !&[byte] {
    if literal == null || literal.text_len as usize > SQL_MAX_LITERAL_LEN {
        return error.DbInvalidExpr;
    }
    return literal.text[0: literal.text_len as usize];
}

fn db_make_select_stmt_from_stmt(src: &SqlStmt, collection_name: &SqlIdentifier, has_where: bool, where_expr: i16, projection_expr: i16, projection_count: u16) SqlStmt {
    var stmt: SqlStmt = src[0];
    stmt.kind = SqlStmtKind.SELECT;
    stmt.select_stmt.collection_name = collection_name[0];
    stmt.select_stmt.item_count = projection_count;
    if projection_count > 0u16 {
        stmt.select_stmt.items[0usize].expr_index = projection_expr;
    }
    stmt.select_stmt.has_where = has_where;
    stmt.select_stmt.where_expr = where_expr;
    stmt.select_stmt.has_order_by = false;
    stmt.select_stmt.order_expr = -1;
    stmt.select_stmt.order_desc = false;
    stmt.select_stmt.has_limit = false;
    stmt.select_stmt.limit_value = 0u32;
    return stmt;
}

fn db_arena_copy_bytes(arena: &Arena, src: &[const byte]) !JsonStrView {
    if arena == null {
        return error.DbInvalidExpr;
    }
    if src.len == 0usize {
        return JsonStrView{
            ptr: null,
            len: 0usize,
        };
    }
    const mem: &byte = arena_alloc(arena, src.len);
    if mem == null {
        return error.DbRowTooLarge;
    }
    _ = mem_copy(mem, src.ptr, src.len);
    return JsonStrView{
        ptr: mem,
        len: src.len,
    };
}

fn db_doc_node_to_json_value(arena: &Arena, node: &[byte]) !JsonValue {
    const tag: DocNodeTag = try doc_node_tag(node);
    if tag == DocNodeTag.NULL {
        return JsonValue.json_null();
    }
    if tag == DocNodeTag.TRUE || tag == DocNodeTag.FALSE {
        return JsonValue.bool_val(try doc_bool_value(node));
    }
    if tag == DocNodeTag.INT64 {
        return JsonValue.int_val(try doc_int64_value(node));
    }
    if tag == DocNodeTag.STRING {
        const text: &[byte] = try doc_string_view(node);
        return JsonValue.str(JsonStrView{
            ptr: text.ptr,
            len: text.len,
        });
    }
    if tag == DocNodeTag.NUMBER_TEXT {
        const text: &[byte] = try doc_number_text_lexeme_view(node);
        return JsonValue.num_text(JsonStrView{
            ptr: text.ptr,
            len: text.len,
        });
    }
    if tag == DocNodeTag.ARRAY {
        const count: u32 = try doc_array_count(node);
        if count == 0u32 {
            return JsonValue.arr(JsonArray{
                items: null,
                len: 0usize,
            });
        }
        const items_mem: &byte = arena_alloc(arena, (count as usize) * DB_JSON_VALUE_ALLOC_SIZE);
        if items_mem == null {
            return error.DbRowTooLarge;
        }
        const items: &JsonValue = items_mem as &JsonValue;
        var i: u32 = 0u32;
        while i < count {
            items[i as usize] = try db_doc_node_to_json_value(arena, try doc_array_index(node, i));
            i = i + 1u32;
        }
        return JsonValue.arr(JsonArray{
            items: items,
            len: count as usize,
        });
    }
    const count: u32 = try doc_object_count(node);
    if count == 0u32 {
        return JsonValue.obj(JsonObject{
            pairs: null,
            len: 0usize,
        });
    }
    const pairs_mem: &byte = arena_alloc(arena, (count as usize) * DB_JSON_KEY_VALUE_ALLOC_SIZE);
    if pairs_mem == null {
        return error.DbRowTooLarge;
    }
    const pairs: &JsonKeyValue = pairs_mem as &JsonKeyValue;
    var i: u32 = 0u32;
    while i < count {
        const key: &[byte] = try doc_object_key_at(node, i);
        pairs[i as usize] = JsonKeyValue{
            key: JsonStrView{
                ptr: key.ptr,
                len: key.len,
            },
            value: try db_doc_node_to_json_value(arena, try doc_object_value_at(node, i)),
        };
        i = i + 1u32;
    }
    return JsonValue.obj(JsonObject{
        pairs: pairs,
        len: count as usize,
    });
}

fn db_exec_value_to_json_value(arena: &Arena, value: &ExecValue) !JsonValue {
    if value == null {
        return error.DbInvalidExpr;
    }
    if value.kind == ExecValueKind.NULL {
        return JsonValue.json_null();
    }
    if value.kind == ExecValueKind.BOOL {
        return JsonValue.bool_val(value.bool_value);
    }
    if value.kind == ExecValueKind.INT64 {
        return JsonValue.int_val(value.i64_value);
    }
    if value.kind == ExecValueKind.UINT64 {
        if value.u64_value <= 9223372036854775807u64 {
            return JsonValue.int_val(value.u64_value as i64);
        }
        var text_buf: [byte: 32] = [];
        const text_len: usize = try exec_encode_u64_text(value.u64_value, text_buf[0: 32]);
        return JsonValue.num_text(try db_arena_copy_bytes(arena, text_buf[0: text_len]));
    }
    if value.kind == ExecValueKind.STRING {
        return JsonValue.str(try db_arena_copy_bytes(arena, value.text[0: value.text_len as usize]));
    }
    if value.kind == ExecValueKind.NUMBER_TEXT {
        return JsonValue.num_text(try db_arena_copy_bytes(arena, value.text[0: value.text_len as usize]));
    }
    return try db_doc_node_to_json_value(arena, value.doc_node);
}

fn db_json_key_equal(key: JsonStrView, field: &[const byte]) bool {
    if key.len != field.len {
        return false;
    }
    var i: usize = 0usize;
    while i < field.len {
        if key.ptr[i] != field.ptr[i] {
            return false;
        }
        i = i + 1usize;
    }
    return true;
}

fn db_json_copy_field_name(arena: &Arena, field: &[const byte]) !JsonStrView {
    return try db_arena_copy_bytes(arena, field);
}

fn db_bytes_equal(a: &[byte], b: &[const byte]) bool {
    if a.len != b.len {
        return false;
    }
    var i: usize = 0usize;
    while i < a.len {
        if a.ptr[i] != b.ptr[i] {
            return false;
        }
        i = i + 1usize;
    }
    return true;
}

fn db_try_update_row_top_level_field_encoded(collection: &DbCollection, row: &DbStoredRow, field: &[const byte], replacement_blob: &[const byte]) !bool {
    if collection == null || row == null || field.ptr == null || replacement_blob.ptr == null {
        return false;
    }
    const doc_blob: &[byte] = try db_row_blob(row);
    if (try doc_node_tag(doc_blob)) != DocNodeTag.OBJECT {
        return false;
    }
    const count: u32 = try doc_object_count(doc_blob);
    var i: u32 = 0u32;
    while i < count {
        const key: &[byte] = try doc_object_key_at(doc_blob, i);
        if db_bytes_equal(key, field) {
            const old_value: &[byte] = try doc_object_value_at(doc_blob, i);
            if old_value.len != replacement_blob.len {
                return false;
            }
            if db_bytes_equal(old_value, replacement_blob) {
                return false;
            }
            const blob_len: usize = doc_blob.len;
            const new_blob: &byte = try db_collection_blob_alloc(collection, blob_len);
            _ = mem_copy(new_blob, doc_blob.ptr, blob_len);
            const root_addr: usize = @usize_from_ptr(doc_blob.ptr as &void);
            const value_addr: usize = @usize_from_ptr(old_value.ptr as &void);
            if value_addr < root_addr {
                return error.DbRowTooLarge;
            }
            const value_off: usize = value_addr - root_addr;
            _ = mem_copy(&new_blob[value_off], replacement_blob.ptr, replacement_blob.len);
            row.doc_blob = new_blob;
            row.doc_len = (blob_len as! u16).value;
            row.blob_loaded = true;
            row.doc_blob_owned = false;
            return true;
        }
        i = i + 1u32;
    }
    return false;
}

fn db_json_set_path(arena: &Arena, value: &JsonValue, program: &PathProgram, step_index: usize, replacement: &JsonValue) !JsonValue {
    if step_index >= program.step_count as usize {
        return replacement[0];
    }
    if step_index >= @len(program.steps) {
        return error.DbPathError;
    }
    const step: PathStep = program.steps[step_index];
    if step.kind == PathStepKind.FIELD {
        match value[0] {
            .obj(obj) => {
                var found_idx: i32 = 0 - 1;
                var i: usize = 0usize;
                while i < obj.len {
                    if db_json_key_equal(obj.pairs[i].key, step.field[0: step.field_len as usize]) {
                        found_idx = (i as! i32) catch {
                            return error.DbPathError;
                        };
                        break;
                    }
                    i = i + 1usize;
                }
                if found_idx < 0i32 && step_index + 1usize < program.step_count as usize {
                    return error.DbPathError;
                }

                var new_len: usize = obj.len;
                if found_idx < 0i32 {
                    new_len = new_len + 1usize;
                }
                const pairs_mem: &byte = arena_alloc(arena, new_len * DB_JSON_KEY_VALUE_ALLOC_SIZE);
                if pairs_mem == null {
                    return error.DbRowTooLarge;
                }
                const pairs: &JsonKeyValue = pairs_mem as &JsonKeyValue;
                i = 0usize;
                while i < obj.len {
                    pairs[i] = obj.pairs[i];
                    i = i + 1usize;
                }
                if found_idx >= 0i32 {
                    var child: JsonValue = replacement[0];
                    if step_index + 1usize < program.step_count as usize {
                        child = try db_json_set_path(arena, &obj.pairs[found_idx as usize].value, program, step_index + 1usize, replacement);
                    }
                    pairs[found_idx as usize].value = child;
                } else {
                    pairs[obj.len] = JsonKeyValue{
                        key: try db_json_copy_field_name(arena, step.field[0: step.field_len as usize]),
                        value: replacement[0],
                    };
                }
                return JsonValue.obj(JsonObject{
                    pairs: pairs,
                    len: new_len,
                });
            },
            else => {
                return error.DbPathError;
            },
        }
    }

    match value[0] {
        .arr(arr) => {
            if step.index as usize >= arr.len {
                return error.DbPathError;
            }
            if arr.len == 0usize {
                return error.DbPathError;
            }
            const items_mem: &byte = arena_alloc(arena, arr.len * DB_JSON_VALUE_ALLOC_SIZE);
            if items_mem == null {
                return error.DbRowTooLarge;
            }
            const items: &JsonValue = items_mem as &JsonValue;
            var i: usize = 0usize;
            while i < arr.len {
                items[i] = arr.items[i];
                i = i + 1usize;
            }
            if step_index + 1usize >= program.step_count as usize {
                items[step.index as usize] = replacement[0];
            } else {
                items[step.index as usize] = try db_json_set_path(arena, &arr.items[step.index as usize], program, step_index + 1usize, replacement);
            }
            return JsonValue.arr(JsonArray{
                items: items,
                len: arr.len,
            });
        },
        else => {
            return error.DbPathError;
        },
    }
}

fn db_try_update_row_doc_at_path_fast(collection: &DbCollection, row: &DbStoredRow, program: &PathProgram, replacement: &ExecValue) !bool {
    if collection == null || row == null || program == null || replacement == null {
        return false;
    }
    if program.step_count != 1u16 {
        return false;
    }
    const step: PathStep = program.steps[0usize];
    if step.kind != PathStepKind.FIELD {
        return false;
    }
    var replacement_buf: [byte: DB_DOC_BLOB_MAX] = [];
    const replacement_len: usize = try exec_value_encode_doc(replacement, replacement_buf[0: DB_DOC_BLOB_MAX]);
    return try db_try_update_row_top_level_field_encoded(collection, row, step.field[0: step.field_len as usize], replacement_buf[0: replacement_len]);
}

fn db_update_row_doc_at_path(collection: &DbCollection, row: &DbStoredRow, program: &PathProgram, replacement: &ExecValue) !bool {
    const fast_updated: bool = try db_try_update_row_doc_at_path_fast(collection, row, program, replacement);
    if fast_updated {
        return true;
    }
    var scratch: [byte: DB_TXN_DOC_SCRATCH_MAX] = [];
    var arena: Arena = Arena{ buffer: null, size: 0, used: 0 };
    arena_init(&arena, &scratch[0], DB_TXN_DOC_SCRATCH_MAX);
    const old_blob: &[byte] = try db_row_blob(row);
    const root_json: JsonValue = try db_doc_node_to_json_value(&arena, try db_row_blob(row));
    const replacement_json: JsonValue = try db_exec_value_to_json_value(&arena, replacement);
    const updated_json: JsonValue = try db_json_set_path(&arena, &root_json, program, 0usize, &replacement_json);
    var encoded_buf: [byte: DB_DOC_BLOB_MAX] = [];
    const encoded_len: usize = try doc_encode_json_value(&updated_json, encoded_buf[0: DB_DOC_BLOB_MAX]);
    if db_bytes_equal(old_blob, encoded_buf[0: encoded_len]) {
        return false;
    }
    try db_collection_row_set_blob_copy(collection, row, encoded_buf[0: encoded_len]);
    return true;
}

fn db_plan_primary_lookup_row_slot(db: &DbHandle, view_slot: u16, collection_slot: u16, lookup_doc_id: u64, found_out: &bool, row_slot_out: &u32) !void {
    if db == null || found_out == null || row_slot_out == null {
        return error.DbHandleInvalid;
    }
    const state: &CommitViewState = try db_commit_view_state(db, view_slot);
    const collection_idx: usize = (collection_slot as! usize) catch {
        return error.DbCollectionNotFound;
    };
    if collection_idx >= DB_MAX_COLLECTIONS {
        return error.DbCollectionNotFound;
    }
    const collection: &DbCollection = &state.collections[collection_idx];
    try db_ensure_collection_rows_loaded_in_view(db, view_slot, collection_slot);
    if lookup_doc_id > 0u64 {
        const direct_idx_u64: u64 = lookup_doc_id - 1u64;
        if direct_idx_u64 <= 4294967295u64 {
            const direct_idx: u32 = direct_idx_u64 as u32;
            if direct_idx < collection.row_count && direct_idx < collection.row_capacity {
                const direct_row: &DbStoredRow = &collection.rows[direct_idx as usize];
                if db_row_visible_at_slot(collection, direct_row, direct_idx) && direct_row.doc_id == lookup_doc_id {
                    found_out[0] = true;
                    row_slot_out[0] = direct_idx;
                    return;
                }
            }
        }
    }
    try db_ensure_primary_index(db, collection_slot);
    const ptr: RecordPointer = primary_btree_lookup(&db.primary_indexes[collection_idx], lookup_doc_id) catch {
        found_out[0] = false;
        row_slot_out[0] = 0u32;
        return;
    };
    const base_page_id: u32 = db_collection_data_page_id(collection);
    var direct_idx: u32 = NOSQLITE_COLLECTION_MAX_ROWS_PER_COLLECTION;
    if ptr.page_id >= base_page_id {
        const page_offset: u32 = ptr.page_id - base_page_id;
        direct_idx = db_collection_first_row_for_page_offset(collection, page_offset) + (ptr.slot_id as u32);
    }
    if direct_idx < collection.row_count && direct_idx < collection.row_capacity {
        const row: &DbStoredRow = &collection.rows[direct_idx as usize];
        if db_row_visible_at_slot(collection, row, direct_idx) &&
            row.doc_id == lookup_doc_id &&
            row.record_ptr.page_id == ptr.page_id &&
            row.record_ptr.slot_id == ptr.slot_id {
            found_out[0] = true;
            row_slot_out[0] = direct_idx;
            return;
        }
    }
    var i: u32 = 0u32;
    while i < collection.row_count {
        const row: &DbStoredRow = &collection.rows[i as usize];
        if db_row_visible_at_slot(collection, row, i) &&
            row.doc_id == lookup_doc_id &&
            row.record_ptr.page_id == ptr.page_id &&
            row.record_ptr.slot_id == ptr.slot_id {
            found_out[0] = true;
            row_slot_out[0] = i;
            return;
        }
        i = i + 1u32;
    }
    found_out[0] = false;
    row_slot_out[0] = 0u32;
}

fn db_row_matches_filter_expr(db: &DbHandle, plan: &QueryPlan, view_slot: u16, collection_slot: u16, row_slot: u32, filter_expr: i16) !bool {
    if filter_expr < 0i16 {
        return true;
    }
    const rowref: RowRef = try db_collection_row_ref(db, view_slot, collection_slot, row_slot);
    return try db_eval_predicate(db, &plan.bound, &rowref, filter_expr);
}

fn db_txn_apply_update_row_in_collection_impl(txn: &Txn, plan: &QueryPlan, collection: &DbCollection, row_slot: u32, program: &PathProgram, value_expr: i16, mark_dirty: bool) !bool {
    if txn == null || txn.db == null || collection == null {
        return error.DbHandleInvalid;
    }
    try db_collection_prepare_row_writes(collection);
    const row: &DbStoredRow = try db_row_at(collection, row_slot);
    if !db_row_visible_at_slot(collection, row, row_slot) {
        return false;
    }
    if !row.blob_loaded {
        try db_ensure_row_blob_loaded(txn.db, collection, row);
    }
    const rowref: RowRef = RowRef{
        doc_id: row.doc_id,
        record_ptr: row.record_ptr,
        doc_blob: try db_row_blob(row),
    };
    const new_value: ExecValue = try db_eval_value(txn.db, &plan.bound, &rowref, value_expr);
    if !(try db_update_row_doc_at_path(collection, row, program, &new_value)) {
        return false;
    }
    if db_collection_update_max_doc_len(collection, row.doc_len) {
        try db_collection_refresh_packed_layout(collection, db_effective_page_size(txn.db));
    }
    if mark_dirty {
        try db_collection_mark_row_dirty(collection, row_slot);
    }
    return true;
}

fn db_txn_apply_update_row_in_collection(txn: &Txn, plan: &QueryPlan, collection: &DbCollection, row_slot: u32, program: &PathProgram, value_expr: i16) !bool {
    return try db_txn_apply_update_row_in_collection_impl(txn, plan, collection, row_slot, program, value_expr, true);
}

fn db_txn_apply_update_row(txn: &Txn, plan: &QueryPlan, collection_slot: u16, row_slot: u32, program: &PathProgram, value_expr: i16) !bool {
    if txn == null || txn.db == null {
        return error.DbHandleInvalid;
    }
    const state: &CommitViewState = try db_commit_view_state(txn.db, txn.view_slot);
    const collection: &DbCollection = try db_collection_at_in_state(state, collection_slot);
    return try db_txn_apply_update_row_in_collection(txn, plan, collection, row_slot, program, value_expr);
}

fn db_txn_apply_delete_row_in_collection(collection: &DbCollection, row_slot: u32) !bool {
    if collection == null {
        return error.DbHandleInvalid;
    }
    try db_collection_prepare_row_writes(collection);
    const row: &DbStoredRow = try db_row_at(collection, row_slot);
    if !db_row_visible_at_slot(collection, row, row_slot) {
        return false;
    }
    collection.prefix_delete_only = false;
    row.tombstone = true;
    collection.may_have_tombstones = true;
    collection.primary_index_ready = false;
    collection.delete_overlay_suffix_valid = false;
    try db_collection_mark_row_dirty(collection, row_slot);
    return true;
}

fn db_txn_apply_delete_row(txn: &Txn, collection_slot: u16, row_slot: u32) !bool {
    if txn == null || txn.db == null {
        return error.DbHandleInvalid;
    }
    const state: &CommitViewState = try db_commit_view_state(txn.db, txn.view_slot);
    const collection: &DbCollection = try db_collection_at_in_state(state, collection_slot);
    return try db_txn_apply_delete_row_in_collection(collection, row_slot);
}

fn db_txn_try_apply_doc_id_range_update(txn: &Txn, plan: &QueryPlan, collection_slot: u16, program: &PathProgram, value_expr: i16, matched_out: &bool, changed_out: &u32) !void {
    if matched_out != null {
        matched_out[0] = false;
    }
    if changed_out != null {
        changed_out[0] = 0u32;
    }
    if txn == null || txn.db == null || plan == null || matched_out == null || changed_out == null {
        return error.DbHandleInvalid;
    }
    const range: DbDocIdRangeMatch = try db_doc_id_range_extract(&plan.bound, plan.bound.where_expr);
    if !range.matched {
        return;
    }
    const state: &CommitViewState = try db_commit_view_state(txn.db, txn.view_slot);
    const collection: &DbCollection = try db_collection_at_in_state(state, collection_slot);
    var slot_matched: bool = false;
    var start_slot: u32 = 0u32;
    var end_slot_exclusive: u32 = 0u32;
    try db_doc_id_range_dense_slot_window(collection, &range, &slot_matched, &start_slot, &end_slot_exclusive);
    if !slot_matched {
        return;
    }
    matched_out[0] = true;
    try db_collection_prepare_row_writes(collection);
    var replacement_buf: [byte: DB_DOC_BLOB_MAX] = [];
    var replacement_len: usize = 0usize;
    var literal_fast_path: bool = false;
    if program.step_count == 1u16 && program.steps[0usize].kind == PathStepKind.FIELD {
        literal_fast_path = try db_bound_literal_encode_doc(&plan.bound, value_expr, replacement_buf[0: DB_DOC_BLOB_MAX], &replacement_len);
    }
    const field: &[byte] = program.steps[0usize].field[0: program.steps[0usize].field_len as usize];
    var last_dirty_page: u32 = 4294967295u32;
    var row_slot: u32 = start_slot;
    while row_slot < end_slot_exclusive {
        var updated: bool = false;
        if literal_fast_path {
            const row: &DbStoredRow = &collection.rows[row_slot as usize];
            if db_row_visible_at_slot(collection, row, row_slot) {
                if !row.blob_loaded {
                    try db_ensure_row_blob_loaded(txn.db, collection, row);
                }
                updated = try db_try_update_row_top_level_field_encoded(collection, row, field, replacement_buf[0: replacement_len]);
            }
        }
        if !updated {
            updated = try db_txn_apply_update_row_in_collection_impl(txn, plan, collection, row_slot, program, value_expr, false);
        }
        if updated {
            const page_offset: u32 = row_slot / (db_collection_rows_per_page(collection) as u32);
            if page_offset != last_dirty_page {
                try db_collection_mark_page_dirty(collection, page_offset);
                last_dirty_page = page_offset;
            }
            changed_out[0] = changed_out[0] + 1u32;
        }
        row_slot = row_slot + 1u32;
    }
}

fn db_txn_try_apply_doc_id_range_delete(txn: &Txn, plan: &QueryPlan, collection_slot: u16, matched_out: &bool, changed_out: &u32) !void {
    if matched_out != null {
        matched_out[0] = false;
    }
    if changed_out != null {
        changed_out[0] = 0u32;
    }
    if txn == null || txn.db == null || plan == null || matched_out == null || changed_out == null {
        return error.DbHandleInvalid;
    }
    const range: DbDocIdRangeMatch = try db_doc_id_range_extract(&plan.bound, plan.bound.where_expr);
    if !range.matched {
        return;
    }
    const state: &CommitViewState = try db_commit_view_state(txn.db, txn.view_slot);
    const collection: &DbCollection = try db_collection_at_in_state(state, collection_slot);
    var slot_matched: bool = false;
    var start_slot: u32 = 0u32;
    var end_slot_exclusive: u32 = 0u32;
    try db_doc_id_range_dense_slot_window(collection, &range, &slot_matched, &start_slot, &end_slot_exclusive);
    if !slot_matched {
        return;
    }
    matched_out[0] = true;
    if collection.prefix_delete_only && start_slot < end_slot_exclusive {
        const start_doc_id: u64 = start_slot as u64 + 1u64;
        const end_doc_id_exclusive: u64 = end_slot_exclusive as u64 + 1u64;
        if start_doc_id == collection.deleted_through_doc_id + 1u64 {
            collection.deleted_through_doc_id = end_doc_id_exclusive - 1u64;
            collection.may_have_tombstones = true;
            collection.primary_index_ready = false;
            changed_out[0] = end_slot_exclusive - start_slot;
            return;
        }
    }
    const allow_tombstone_patch: bool = !db_collection_has_dirty_pages(collection);
    collection.prefix_delete_only = false;
    collection.may_have_tombstones = true;
    collection.primary_index_ready = false;
    const rows_per_page_u32: u32 = db_collection_rows_per_page(collection) as u32;
    const start_doc_id: u64 = start_slot as u64 + 1u64;
    if collection.delete_overlay_suffix_valid &&
        start_doc_id > collection.deleted_through_doc_id &&
        end_slot_exclusive == collection.delete_overlay_suffix_start {
        try db_collection_fill_delete_overlay_range(collection, start_slot, end_slot_exclusive);
        collection.delete_overlay_suffix_start = start_slot;
        if rows_per_page_u32 != 0u32 {
            const start_page: u32 = start_slot / rows_per_page_u32;
            const end_page_exclusive: u32 = ((end_slot_exclusive - 1u32) / rows_per_page_u32) + 1u32;
            try db_collection_mark_page_range_dirty(collection, start_page, end_page_exclusive);
            if allow_tombstone_patch {
                db_collection_extend_tombstone_patch_pages(collection, start_page, end_page_exclusive);
            }
        }
        changed_out[0] = end_slot_exclusive - start_slot;
        return;
    }
    collection.delete_overlay_suffix_valid = false;
    var last_dirty_page: u32 = 4294967295u32;
    var row_slot: u32 = start_slot;
    while row_slot < end_slot_exclusive {
        const row: &DbStoredRow = &collection.rows[row_slot as usize];
        if db_row_visible_at_slot(collection, row, row_slot) {
            try db_collection_set_delete_overlay_tombstone(collection, row_slot, true);
            const page_offset: u32 = row_slot / rows_per_page_u32;
            if page_offset != last_dirty_page {
                try db_collection_mark_page_dirty(collection, page_offset);
                last_dirty_page = page_offset;
            }
            changed_out[0] = changed_out[0] + 1u32;
        }
        row_slot = row_slot + 1u32;
    }
    if allow_tombstone_patch && changed_out[0] > 0u32 && rows_per_page_u32 != 0u32 {
        const start_page: u32 = start_slot / rows_per_page_u32;
        const end_page_exclusive: u32 = ((end_slot_exclusive - 1u32) / rows_per_page_u32) + 1u32;
        db_collection_extend_tombstone_patch_pages(collection, start_page, end_page_exclusive);
    }
}

fn db_txn_stage_update_stmt_apply_root(txn: &Txn, plan: &QueryPlan, collection_slot: u16, program: &PathProgram, value_expr: i16) !u32 {
    const root: &PlanNode = try plan_node(plan, plan.root_node);
    if root.kind == PlanNodeKind.SEQ_SCAN {
        try db_ensure_collection_rows_loaded_in_view(txn.db, txn.view_slot, collection_slot);
        const state: &CommitViewState = try db_commit_view_state(txn.db, txn.view_slot);
        const collection: &DbCollection = try db_collection_at_in_state(state, collection_slot);
        var changed: u32 = 0u32;
        var row_slot: u32 = 0u32;
        while row_slot < collection.row_count {
            const row: &DbStoredRow = &collection.rows[row_slot as usize];
            if db_row_visible_at_slot(collection, row, row_slot) {
                if try db_txn_apply_update_row_in_collection(txn, plan, collection, row_slot, program, value_expr) {
                    changed = changed + 1u32;
                }
            }
            row_slot = row_slot + 1u32;
        }
        return changed;
    }
    if root.kind == PlanNodeKind.PRIMARY_LOOKUP {
        var found: bool = false;
        var row_slot: u32 = 0u32;
        try db_plan_primary_lookup_row_slot(txn.db, txn.view_slot, collection_slot, root.lookup_doc_id, &found, &row_slot);
        if found && try db_txn_apply_update_row(txn, plan, collection_slot, row_slot, program, value_expr) {
            return 1u32;
        }
        return 0u32;
    }
    if root.kind == PlanNodeKind.INDEX_SCAN {
        try db_ensure_secondary_index(txn.db, collection_slot, root.index_slot);
        const index_state: &DbSecondaryIndexState = try db_secondary_index_state(txn.db, collection_slot, root.index_slot);
        if !index_state.present {
            return 0u32;
        }
        var changed: u32 = 0u32;
        var i: u32 = 0u32;
        while i < index_state.row_count {
            const row_slot: u32 = index_state.row_slots[i as usize];
            if try db_row_matches_filter_expr(txn.db, plan, txn.view_slot, collection_slot, row_slot, root.filter_expr) {
                if try db_txn_apply_update_row(txn, plan, collection_slot, row_slot, program, value_expr) {
                    changed = changed + 1u32;
                }
            }
            i = i + 1u32;
        }
        return changed;
    }
    if root.kind == PlanNodeKind.FILTER {
        const child: &PlanNode = try plan_node(plan, root.child);
        if child.kind == PlanNodeKind.SEQ_SCAN {
            try db_ensure_collection_rows_loaded_in_view(txn.db, txn.view_slot, collection_slot);
            const state: &CommitViewState = try db_commit_view_state(txn.db, txn.view_slot);
            const collection: &DbCollection = try db_collection_at_in_state(state, collection_slot);
            var changed: u32 = 0u32;
            var row_slot: u32 = 0u32;
            while row_slot < collection.row_count {
                const row: &DbStoredRow = &collection.rows[row_slot as usize];
                if db_row_visible_at_slot(collection, row, row_slot) {
                    if try db_row_matches_filter_expr(txn.db, plan, txn.view_slot, collection_slot, row_slot, root.filter_expr) {
                        if try db_txn_apply_update_row_in_collection(txn, plan, collection, row_slot, program, value_expr) {
                            changed = changed + 1u32;
                        }
                    }
                }
                row_slot = row_slot + 1u32;
            }
            return changed;
        }
        if child.kind == PlanNodeKind.PRIMARY_LOOKUP {
            var found: bool = false;
            var row_slot: u32 = 0u32;
            try db_plan_primary_lookup_row_slot(txn.db, txn.view_slot, collection_slot, child.lookup_doc_id, &found, &row_slot);
            if !found {
                return 0u32;
            }
            if !(try db_row_matches_filter_expr(txn.db, plan, txn.view_slot, collection_slot, row_slot, root.filter_expr)) {
                return 0u32;
            }
            if try db_txn_apply_update_row(txn, plan, collection_slot, row_slot, program, value_expr) {
                return 1u32;
            }
            return 0u32;
        }
        if child.kind == PlanNodeKind.INDEX_SCAN {
            try db_ensure_secondary_index(txn.db, collection_slot, child.index_slot);
            const index_state: &DbSecondaryIndexState = try db_secondary_index_state(txn.db, collection_slot, child.index_slot);
            if !index_state.present {
                return 0u32;
            }
            var changed: u32 = 0u32;
            var i: u32 = 0u32;
            while i < index_state.row_count {
                const row_slot: u32 = index_state.row_slots[i as usize];
                if try db_row_matches_filter_expr(txn.db, plan, txn.view_slot, collection_slot, row_slot, root.filter_expr) {
                    if try db_txn_apply_update_row(txn, plan, collection_slot, row_slot, program, value_expr) {
                        changed = changed + 1u32;
                    }
                }
                i = i + 1u32;
            }
            return changed;
        }
    }
    return error.DbUnsupportedStmt;
}

fn db_txn_stage_delete_stmt_apply_root(txn: &Txn, plan: &QueryPlan, collection_slot: u16) !u32 {
    const root: &PlanNode = try plan_node(plan, plan.root_node);
    if root.kind == PlanNodeKind.SEQ_SCAN {
        try db_ensure_collection_rows_loaded_in_view(txn.db, txn.view_slot, collection_slot);
        const state: &CommitViewState = try db_commit_view_state(txn.db, txn.view_slot);
