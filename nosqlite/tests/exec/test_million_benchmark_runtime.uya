use std.runtime.entry.set_process_stack_limit_bytes;

use libc.getenv;
use libc.atoll;
use libc.printf;
use libc.snprintf;

use osal.CLOCK_MONOTONIC;
use syscall.TimeSpec;
use syscall.sys_clock_gettime;

use lib.api.db.DbHandle;
use lib.api.db.QueryCursor;
use lib.api.db.Txn;
use lib.api.db.cursor_next;
use lib.api.db.cursor_row;
use lib.api.db.db_query_cursor;
use lib.api.db.db_test_create_at_stem;
use lib.api.db.db_test_create_collection;
use lib.api.db.db_test_txn_insert_json;
use lib.api.db.txn_begin;
use lib.api.db.txn_exec;
use lib.api.db.txn_commit;
use lib.api.db.txn_rollback;
use lib.storage.pager.catalog_cleanup_stem;

const TEST_STEM_BENCH: *const byte = "/tmp/nosqlite_million_bench" as *const byte;
const JSON_BUF_CAP: usize = 128;
const SQL_BUF_CAP: usize = 160;
const BULK_UPDATE_AGE: u64 = 30u64;

error BenchBufferTooSmall;
error BenchUnexpectedResult;

fn cleanup() void {
    _ = catalog_cleanup_stem(TEST_STEM_BENCH) catch {};
}

fn env_bytes(name: &const byte) &byte {
    return getenv(name);
}

fn env_u64(name: &const byte, fallback: u64) u64 {
    const raw: &byte = env_bytes(name);
    if raw == null || raw[0] == 0 as byte {
        return fallback;
    }
    const parsed: i64 = atoll(raw as &const byte);
    if parsed <= 0i64 {
        return fallback;
    }
    return parsed as u64;
}

fn now_nsec() u64 {
    var ts: TimeSpec = TimeSpec{ tv_sec: 0i64, tv_nsec: 0i64 };
    _ = sys_clock_gettime(CLOCK_MONOTONIC, &ts) catch {
        return 0u64;
    };
    return (ts.tv_sec as u64) * 1000000000u64 + (ts.tv_nsec as u64);
}

fn elapsed_bench_usec(start_ns: u64) u64 {
    const elapsed_us: u64 = elapsed_bench_nsec(start_ns) / 1000u64;
    if elapsed_us == 0u64 {
        return 1u64;
    }
    return elapsed_us;
}

fn elapsed_bench_nsec(start_ns: u64) u64 {
    const elapsed_ns: u64 = now_nsec() - start_ns;
    if elapsed_ns == 0u64 {
        return 1u64;
    }
    return elapsed_ns;
}

fn build_json(doc_id: u64, out: &[byte]) !usize {
    if out.ptr == null || out.len < JSON_BUF_CAP {
        return error.BenchBufferTooSmall;
    }
    const bucket: u64 = doc_id % 100u64;
    const age: u64 = 18u64 + (doc_id % 41u64);
    var active: &const byte = "false";
    if doc_id % 2u64 == 0u64 {
        active = "true";
    }
    const len_i32: i32 = snprintf(
        out.ptr,
        out.len,
        "{\"n\":%lu,\"bucket\":%lu,\"age\":%lu,\"active\":%s}\0" as &const byte,
        doc_id,
        bucket,
        age,
        active,
    );
    if len_i32 <= 0 {
        return error.BenchBufferTooSmall;
    }
    const len: usize = (len_i32 as! usize) catch {
        return error.BenchBufferTooSmall;
    };
    if len + 1usize > out.len {
        return error.BenchBufferTooSmall;
    }
    return len;
}

fn build_bulk_update_sql(start_id: u64, end_id_exclusive: u64, out: &[byte]) !usize {
    if out.ptr == null || out.len < SQL_BUF_CAP {
        return error.BenchBufferTooSmall;
    }
    const len_i32: i32 = snprintf(
        out.ptr,
        out.len,
        "UPDATE users SET $.age = %lu WHERE _id >= %lu AND _id < %lu;\0" as &const byte,
        BULK_UPDATE_AGE,
        start_id,
        end_id_exclusive,
    );
    if len_i32 <= 0 {
        return error.BenchBufferTooSmall;
    }
    const len: usize = (len_i32 as! usize) catch {
        return error.BenchBufferTooSmall;
    };
    if len + 1usize > out.len {
        return error.BenchBufferTooSmall;
    }
    return len;
}

fn build_bulk_delete_sql(start_id: u64, end_id_exclusive: u64, out: &[byte]) !usize {
    if out.ptr == null || out.len < SQL_BUF_CAP {
        return error.BenchBufferTooSmall;
    }
    const len_i32: i32 = snprintf(
        out.ptr,
        out.len,
        "DELETE FROM users WHERE _id >= %lu AND _id < %lu;\0" as &const byte,
        start_id,
        end_id_exclusive,
    );
    if len_i32 <= 0 {
        return error.BenchBufferTooSmall;
    }
    const len: usize = (len_i32 as! usize) catch {
        return error.BenchBufferTooSmall;
    };
    if len + 1usize > out.len {
        return error.BenchBufferTooSmall;
    }
    return len;
}

fn build_update_verify_sql(expect_updated: bool, out: &[byte]) !usize {
    if out.ptr == null || out.len < SQL_BUF_CAP {
        return error.BenchBufferTooSmall;
    }
    var len_i32: i32 = 0;
    if expect_updated {
        len_i32 = snprintf(
            out.ptr,
            out.len,
            "SELECT _id FROM users WHERE $.age = %lu LIMIT 1;\0" as &const byte,
            BULK_UPDATE_AGE,
        );
    } else {
        len_i32 = snprintf(
            out.ptr,
            out.len,
            "SELECT _id FROM users WHERE NOT $.age = %lu LIMIT 1;\0" as &const byte,
            BULK_UPDATE_AGE,
        );
    }
    if len_i32 <= 0 {
        return error.BenchBufferTooSmall;
    }
    const len: usize = (len_i32 as! usize) catch {
        return error.BenchBufferTooSmall;
    };
    if len + 1usize > out.len {
        return error.BenchBufferTooSmall;
    }
    return len;
}

fn build_id_lookup_sql(doc_id: u64, out: &[byte]) !usize {
    if out.ptr == null || out.len < SQL_BUF_CAP {
        return error.BenchBufferTooSmall;
    }
    const len_i32: i32 = snprintf(
        out.ptr,
        out.len,
        "SELECT _id FROM users WHERE _id = %lu LIMIT 1;\0" as &const byte,
        doc_id,
    );
    if len_i32 <= 0 {
        return error.BenchBufferTooSmall;
    }
    const len: usize = (len_i32 as! usize) catch {
        return error.BenchBufferTooSmall;
    };
    if len + 1usize > out.len {
        return error.BenchBufferTooSmall;
    }
    return len;
}

fn create_users_db(db: &DbHandle) !void {
    try db_test_create_at_stem(db, TEST_STEM_BENCH);
    try db_test_create_collection(db, "users");
}

fn run_load(db: &DbHandle, docs: u64, batch_rows: u64, emit_progress: bool) !u64 {
    var inserted_total: u64 = 0u64;
    const start_ns: u64 = now_nsec();
    while inserted_total < docs {
        var txn: Txn = try txn_begin(db);
        var txn_ok: bool = false;
        defer {
            if !txn_ok {
                _ = txn_rollback(&txn) catch {};
            }
        }

        const remaining: u64 = docs - inserted_total;
        var current_batch: u64 = batch_rows;
        if remaining < current_batch {
            current_batch = remaining;
        }

        var doc_id: u64 = inserted_total + 1u64;
        const batch_end: u64 = inserted_total + current_batch;
        var json_buf: [byte: JSON_BUF_CAP] = [];
        while doc_id <= batch_end {
            const json_len: usize = try build_json(doc_id, json_buf[0: JSON_BUF_CAP]);
            const inserted_u: !u64 = db_test_txn_insert_json(&txn, "users", json_buf[0: json_len]);
            if inserted_u.error_id != 0u32 {
                printf(
                    "BENCH_ERROR_DETAIL stage=insert doc_id=%lu batch_end=%lu error_id=%u\n" as *byte,
                    doc_id,
                    batch_end,
                    inserted_u.error_id,
                );
                return error.BenchUnexpectedResult;
            }
            const inserted: u64 = inserted_u.value;
            if inserted != doc_id {
                return error.BenchUnexpectedResult;
            }
            doc_id = doc_id + 1u64;
        }

        const commit_u: !void = txn_commit(&txn);
        if commit_u.error_id != 0u32 {
            printf(
                "BENCH_ERROR_DETAIL stage=commit inserted_total=%lu batch_end=%lu error_id=%u\n" as *byte,
                inserted_total,
                batch_end,
                commit_u.error_id,
            );
            return error.BenchUnexpectedResult;
        }
        txn_ok = true;
        inserted_total = batch_end;
        if emit_progress {
            printf("PROGRESS inserted=%lu\n" as *byte, inserted_total);
        }
    }
    return elapsed_bench_usec(start_ns);
}

fn run_bulk_update(db: &DbHandle, docs: u64, batch_rows: u64, emit_progress: bool) !u64 {
    var updated_total: u64 = 0u64;
    const start_ns: u64 = now_nsec();
    while updated_total < docs {
        var txn: Txn = try txn_begin(db);
        var txn_ok: bool = false;
        defer {
            if !txn_ok {
                _ = txn_rollback(&txn) catch {};
            }
        }
        const remaining: u64 = docs - updated_total;
        var current_batch: u64 = batch_rows;
        if remaining < current_batch {
            current_batch = remaining;
        }
        const batch_start: u64 = updated_total + 1u64;
        const batch_end_exclusive: u64 = batch_start + current_batch;
        var sql_buf: [byte: SQL_BUF_CAP] = [];
        const sql_len: usize = try build_bulk_update_sql(batch_start, batch_end_exclusive, sql_buf[0: SQL_BUF_CAP]);
        const exec_u: !void = txn_exec(&txn, sql_buf[0: sql_len]);
        if exec_u.error_id != 0u32 {
            printf(
                "BENCH_ERROR_DETAIL stage=bulk_update batch_start=%lu batch_end=%lu error_id=%u\n" as *byte,
                batch_start,
                batch_end_exclusive,
                exec_u.error_id,
            );
            return error.BenchUnexpectedResult;
        }
        const commit_u: !void = txn_commit(&txn);
        if commit_u.error_id != 0u32 {
            printf(
                "BENCH_ERROR_DETAIL stage=bulk_update_commit batch_start=%lu batch_end=%lu error_id=%u\n" as *byte,
                batch_start,
                batch_end_exclusive,
                commit_u.error_id,
            );
            return error.BenchUnexpectedResult;
        }
        txn_ok = true;
        updated_total = updated_total + current_batch;
        if emit_progress {
            printf("PROGRESS updated=%lu\n" as *byte, updated_total);
        }
    }
    return elapsed_bench_usec(start_ns);
}

fn run_logical_delete(db: &DbHandle, docs: u64, batch_rows: u64, emit_progress: bool) !u64 {
    var deleted_total: u64 = 0u64;
    const start_ns: u64 = now_nsec();
    while deleted_total < docs {
        var txn: Txn = try txn_begin(db);
        var txn_ok: bool = false;
        defer {
            if !txn_ok {
                _ = txn_rollback(&txn) catch {};
            }
        }
        const remaining: u64 = docs - deleted_total;
        var current_batch: u64 = batch_rows;
        if remaining < current_batch {
            current_batch = remaining;
        }
        const batch_start: u64 = deleted_total + 1u64;
        const batch_end_exclusive: u64 = batch_start + current_batch;
        var sql_buf: [byte: SQL_BUF_CAP] = [];
        const sql_len: usize = try build_bulk_delete_sql(batch_start, batch_end_exclusive, sql_buf[0: SQL_BUF_CAP]);
        const exec_u: !void = txn_exec(&txn, sql_buf[0: sql_len]);
        if exec_u.error_id != 0u32 {
            printf(
                "BENCH_ERROR_DETAIL stage=logical_delete batch_start=%lu batch_end=%lu error_id=%u\n" as *byte,
                batch_start,
                batch_end_exclusive,
                exec_u.error_id,
            );
            return error.BenchUnexpectedResult;
        }
        const commit_u: !void = txn_commit(&txn);
        if commit_u.error_id != 0u32 {
            printf(
                "BENCH_ERROR_DETAIL stage=logical_delete_commit batch_start=%lu batch_end=%lu error_id=%u\n" as *byte,
                batch_start,
                batch_end_exclusive,
                commit_u.error_id,
            );
            return error.BenchUnexpectedResult;
        }
        txn_ok = true;
        deleted_total = deleted_total + current_batch;
        if emit_progress {
            printf("PROGRESS deleted=%lu\n" as *byte, deleted_total);
        }
    }
    return elapsed_bench_usec(start_ns);
}

fn run_physical_delete(db: &DbHandle, docs: u64, batch_rows: u64, emit_progress: bool) !u64 {
    var deleted_total: u64 = 0u64;
    const start_ns: u64 = now_nsec();
    while deleted_total < docs {
        var txn: Txn = try txn_begin(db);
        var txn_ok: bool = false;
        defer {
            if !txn_ok {
                _ = txn_rollback(&txn) catch {};
            }
        }
        const remaining: u64 = docs - deleted_total;
        var current_batch: u64 = batch_rows;
        if remaining < current_batch {
            current_batch = remaining;
        }
        const batch_end_exclusive: u64 = docs - deleted_total + 1u64;
        const batch_start: u64 = batch_end_exclusive - current_batch;
        var sql_buf: [byte: SQL_BUF_CAP] = [];
        const sql_len: usize = try build_bulk_delete_sql(batch_start, batch_end_exclusive, sql_buf[0: SQL_BUF_CAP]);
        const exec_u: !void = txn_exec(&txn, sql_buf[0: sql_len]);
        if exec_u.error_id != 0u32 {
            printf(
                "BENCH_ERROR_DETAIL stage=physical_delete batch_start=%lu batch_end=%lu error_id=%u\n" as *byte,
                batch_start,
                batch_end_exclusive,
                exec_u.error_id,
            );
            return error.BenchUnexpectedResult;
        }
        const commit_u: !void = txn_commit(&txn);
        if commit_u.error_id != 0u32 {
            printf(
                "BENCH_ERROR_DETAIL stage=physical_delete_commit batch_start=%lu batch_end=%lu error_id=%u\n" as *byte,
                batch_start,
                batch_end_exclusive,
                commit_u.error_id,
            );
            return error.BenchUnexpectedResult;
        }
        txn_ok = true;
        deleted_total = deleted_total + current_batch;
        if emit_progress {
            printf("PROGRESS physical_deleted=%lu\n" as *byte, deleted_total);
        }
    }
    return elapsed_bench_usec(start_ns);
}

fn query_returns_any(db: &DbHandle, sql: &[const byte]) !bool {
    var cursor: QueryCursor = try db_query_cursor(db, sql);
    return try cursor_next(&cursor);
}

fn verify_bulk_update(db: &DbHandle) !void {
    var sql_buf: [byte: SQL_BUF_CAP] = [];
    const updated_sql_len: usize = try build_update_verify_sql(true, sql_buf[0: SQL_BUF_CAP]);
    if !(try query_returns_any(db, sql_buf[0: updated_sql_len])) {
        return error.BenchUnexpectedResult;
    }
    const stale_sql_len: usize = try build_update_verify_sql(false, sql_buf[0: SQL_BUF_CAP]);
    if try query_returns_any(db, sql_buf[0: stale_sql_len]) {
        return error.BenchUnexpectedResult;
    }
}

fn verify_bulk_delete(db: &DbHandle) !void {
    if try query_returns_any(db, "SELECT _id FROM users LIMIT 1;"[0: 29]) {
        return error.BenchUnexpectedResult;
    }
}


fn main() i32 {
    set_process_stack_limit_bytes(256u64 * 1024u64 * 1024u64);
    const docs: u64 = env_u64("NOSQLITE_MILLION_BENCH_DOCS" as &const byte, 1000000u64);
    const batch_rows: u64 = env_u64("NOSQLITE_MILLION_BENCH_BATCH_ROWS" as &const byte, 48000u64);
    const query_iters: u64 = env_u64("NOSQLITE_MILLION_BENCH_QUERY_ITERS" as &const byte, 100u64);
    const emit_progress: bool = env_u64("NOSQLITE_MILLION_BENCH_PROGRESS" as &const byte, 0u64) != 0u64;

    cleanup();
    defer {
        cleanup();
    }

    printf(
        "BENCH_INFO docs=%lu batch_rows=%lu query_iters=%lu\n" as *byte,
        docs,
        batch_rows,
        query_iters,
    );

    var db: DbHandle = DbHandle{};
    _ = create_users_db(&db) catch {
        printf("BENCH_ERROR stage=create_db error_id=%u\n" as *byte, (@error_id(error.BenchUnexpectedResult)));
        return 1;
    };

    const load_u: !u64 = run_load(&db, docs, batch_rows, emit_progress);
    if load_u.error_id != 0u32 {
        printf("BENCH_ERROR stage=load error_id=%u\n" as *byte, load_u.error_id);
        return 3;
    }
    const load_us: u64 = load_u.value;
    printf("RESULT case=bulk_load us=%lu rows=%lu\n" as *byte, load_us, docs);

    const lookup_u: !void = run_limit_query_samples(&db, query_iters);
    if lookup_u.error_id != 0u32 {
        printf("BENCH_ERROR stage=limit_query error_id=%u\n" as *byte, lookup_u.error_id);
        return 5;
    }

    cleanup();
    _ = create_users_db(&db) catch {
        printf("BENCH_ERROR stage=create_update_db error_id=%u\n" as *byte, (@error_id(error.BenchUnexpectedResult)));
        return 6;
    };
    const update_prepare_u: !u64 = run_load(&db, docs, batch_rows, false);
    if update_prepare_u.error_id != 0u32 {
        printf("BENCH_ERROR stage=prepare_update error_id=%u\n" as *byte, update_prepare_u.error_id);
        return 7;
    }
    const update_u: !u64 = run_bulk_update(&db, docs, batch_rows, emit_progress);
    if update_u.error_id != 0u32 {
        printf("BENCH_ERROR stage=bulk_update error_id=%u\n" as *byte, update_u.error_id);
        return 8;
    }
    _ = verify_bulk_update(&db) catch {
        printf("BENCH_ERROR stage=bulk_update_verify error_id=%u\n" as *byte, (@error_id(error.BenchUnexpectedResult)));
        return 9;
    };
    printf("RESULT case=bulk_update us=%lu rows=%lu\n" as *byte, update_u.value, docs);

    cleanup();
    _ = create_users_db(&db) catch {
        printf("BENCH_ERROR stage=create_delete_db error_id=%u\n" as *byte, (@error_id(error.BenchUnexpectedResult)));
        return 10;
    };
    const delete_prepare_u: !u64 = run_load(&db, docs, batch_rows, false);
    if delete_prepare_u.error_id != 0u32 {
        printf("BENCH_ERROR stage=prepare_delete error_id=%u\n" as *byte, delete_prepare_u.error_id);
        return 11;
    }
    const logical_delete_u: !u64 = run_logical_delete(&db, docs, batch_rows, emit_progress);
    if logical_delete_u.error_id != 0u32 {
        printf("BENCH_ERROR stage=logical_delete error_id=%u\n" as *byte, logical_delete_u.error_id);
        return 12;
    }
    _ = verify_bulk_delete(&db) catch {
        printf("BENCH_ERROR stage=logical_delete_verify error_id=%u\n" as *byte, (@error_id(error.BenchUnexpectedResult)));
        return 13;
    };
    printf("RESULT case=logical_delete us=%lu rows=%lu\n" as *byte, logical_delete_u.value, docs);

    cleanup();
    _ = create_users_db(&db) catch {
        printf("BENCH_ERROR stage=create_physical_delete_db error_id=%u\n" as *byte, (@error_id(error.BenchUnexpectedResult)));
        return 14;
    };
    const physical_delete_prepare_u: !u64 = run_load(&db, docs, batch_rows, false);
    if physical_delete_prepare_u.error_id != 0u32 {
        printf("BENCH_ERROR stage=prepare_physical_delete error_id=%u\n" as *byte, physical_delete_prepare_u.error_id);
        return 15;
    }
    const physical_delete_u: !u64 = run_physical_delete(&db, docs, batch_rows, emit_progress);
    if physical_delete_u.error_id != 0u32 {
        printf("BENCH_ERROR stage=physical_delete error_id=%u\n" as *byte, physical_delete_u.error_id);
        return 16;
    }
    _ = verify_bulk_delete(&db) catch {
        printf("BENCH_ERROR stage=physical_delete_verify error_id=%u\n" as *byte, (@error_id(error.BenchUnexpectedResult)));
        return 17;
    };
    printf("RESULT case=physical_delete us=%lu rows=%lu\n" as *byte, physical_delete_u.value, docs);
    return 0;
}

fn run_limit_query_samples(db: &DbHandle, iterations: u64) !void {
    const sql: &[const byte] = "SELECT _id FROM users LIMIT 64;"[0: 30];
    var warm_cursor: QueryCursor = try db_query_cursor(db, sql);
    if (try drain_cursor(&warm_cursor)) == 0u32 {
        return error.BenchUnexpectedResult;
    }

    var i: u64 = 0u64;
    while i < iterations {
        const start_ns: u64 = now_nsec();
        var cursor: QueryCursor = try db_query_cursor(db, sql);
        const docs_returned: u32 = try drain_cursor(&cursor);
        const elapsed_ns: u64 = elapsed_bench_nsec(start_ns);
        if docs_returned == 0u32 {
            return error.BenchUnexpectedResult;
        }
        printf("SAMPLE case=limit_query ns=%lu docs=%u\n" as *byte, elapsed_ns, docs_returned);
        i = i + 1u64;
    }
}

fn drain_cursor(cursor: &QueryCursor) !u32 {
    var docs_returned: u32 = 0u32;
    while try cursor_next(cursor) {
        _ = try cursor_row(cursor);
        docs_returned = docs_returned + 1u32;
    }
    return docs_returned;
}
