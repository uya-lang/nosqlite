use std.runtime.entry.set_process_stack_limit_bytes;

use lib.api.db.DbHandle;
use lib.api.db.db_exec;
use lib.api.db.db_query;
use lib.api.db.db_test_create_at_stem;
use lib.api.db.db_test_create_collection;
use lib.api.db.db_test_insert_json;
use lib.api.db.db_test_open_at_stem;
use lib.api.result.QueryResult;

const TEST_STEM_RANGE_DELETE_OVERLAY: *const byte = "/tmp/nosqlite_exec_range_delete_overlay" as *const byte;

fn prepare_bulk_users_db(db: &DbHandle, row_count: u64) !void {
    try db_test_create_at_stem(db, TEST_STEM_RANGE_DELETE_OVERLAY);
    try db_test_create_collection(db, "users");
    var i: u64 = 0u64;
    while i < row_count {
        _ = try db_test_insert_json(db, "users", "{\"name\":\"bulk\",\"age\":20,\"active\":true}");
        i = i + 1u64;
    }
}

fn main() i32 {
    set_process_stack_limit_bytes(64u64 * 1024u64 * 1024u64);

    var db: DbHandle = DbHandle{};
    _ = prepare_bulk_users_db(&db, 256u64) catch {
        return 1;
    };
    _ = db_exec(&db, "DELETE FROM users WHERE _id >= 129 AND _id < 257;") catch {
        return 2;
    };

    const kept_prefix: QueryResult = db_query(&db, "SELECT _id FROM users WHERE _id = 128 LIMIT 1;") catch {
        return 3;
    };
    if kept_prefix.row_count != 1u32 {
        return 4;
    }
    const deleted_tail_start: QueryResult = db_query(&db, "SELECT _id FROM users WHERE _id = 129 LIMIT 1;") catch {
        return 5;
    };
    if deleted_tail_start.row_count != 0u32 {
        return 6;
    }
    const deleted_tail_end: QueryResult = db_query(&db, "SELECT _id FROM users WHERE _id = 256 LIMIT 1;") catch {
        return 7;
    };
    if deleted_tail_end.row_count != 0u32 {
        return 8;
    }

    _ = db_exec(&db, "INSERT INTO users JSON '{\"name\":\"after-delete\",\"age\":21,\"active\":true}';") catch {
        return 9;
    };
    const inserted_after_delete: QueryResult = db_query(&db, "SELECT _id FROM users WHERE _id = 257 LIMIT 1;") catch {
        return 10;
    };
    if inserted_after_delete.row_count != 1u32 {
        return 11;
    }
    const deleted_tail_end_after_insert: QueryResult = db_query(&db, "SELECT _id FROM users WHERE _id = 256 LIMIT 1;") catch {
        return 12;
    };
    if deleted_tail_end_after_insert.row_count != 0u32 {
        return 13;
    }

    var reopened: DbHandle = DbHandle{};
    _ = db_test_open_at_stem(&reopened, TEST_STEM_RANGE_DELETE_OVERLAY) catch {
        return 14;
    };
    const reopened_kept_prefix: QueryResult = db_query(&reopened, "SELECT _id FROM users WHERE _id = 128 LIMIT 1;") catch {
        return 15;
    };
    if reopened_kept_prefix.row_count != 1u32 {
        return 16;
    }
    const reopened_deleted_tail_start: QueryResult = db_query(&reopened, "SELECT _id FROM users WHERE _id = 129 LIMIT 1;") catch {
        return 17;
    };
    if reopened_deleted_tail_start.row_count != 0u32 {
        return 18;
    }
    const reopened_inserted_after_delete: QueryResult = db_query(&reopened, "SELECT _id FROM users WHERE _id = 257 LIMIT 1;") catch {
        return 19;
    };
    if reopened_inserted_after_delete.row_count != 1u32 {
        return 20;
    }
    return 0;
}
